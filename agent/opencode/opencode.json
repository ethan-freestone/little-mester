{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://ollama:11434/v1",
        "timeout": 900000,
        "chunkTimeout": 600000
      },
      "models": {
        "qwen3:8b": {
          "limit": {
            "context": 65536,
            "output": 16384
          }
        },
        "qwen3:14b": {
          "limit": {
            "context": 65536,
            "output": 16384
          }
        }
      }
    },
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://llamacpp:11434/v1",
        "timeout": 900000,
        "chunkTimeout": 600000
      },
      "models": {
        "qwen3.6-35b-a3b-q4_k_m": {
          "limit": {
            "context": 98304,
            "output": 32440
          }
        },
        "qwen3-coder-30b-a3b-q4_k_m": {
          "limit": {
            "context": 65536,
            "output": 16384
          }
        },
        "gpt-oss-20b-mxfp4": {
          "limit": {
            "context": 65536,
            "output": 16384
          }
        }
      }
    }
  },
  "mcpServers": {
    "little-mester": {
      "command": "ts-node",
      "args": ["src/mcp-server.ts"],
      "cwd": "/workspace/little-mester-mcp",
      "env": {
        "TICKET_DIR": "/workspace/docs/tickets"
      }
    }
  },
  "plugins": [
    "/etc/opencode/plugins/host-metrics",
    "/etc/opencode/plugins/host-metrics-tui"
  ],
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "otel": {},
  "model": "llamacpp/qwen3.6-35b-a3b-q4_k_m",
  "small_model": "llamacpp/qwen3.6-35b-a3b-q4_k_m"
}
