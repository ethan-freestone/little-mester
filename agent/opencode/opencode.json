{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://ollama:11434/v1",
        "timeout": 900000,
        "chunkTimeout": 600000
      },
      "models": {
        "qwen3.6:35b-a3b": {
          "name": "Qwen3.6 35B-A3B (slow, default)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "qwen3:8b": {
          "name": "Qwen3 8B (fast)",
          "limit": {
            "context": 65536,
            "output": 16384
          }
        }
      }
    }
  },
  "model": "ollama/qwen3.6:35b-a3b",
  "small_model": "ollama/qwen3:8b",
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "otel": {}
}
