{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://ollama:11434/v1",
        "timeout": 900000,
        "chunkTimeout": 600000
      },
      "models": {
        "qwen3:8b": {
          "limit": {
            "context": 65536,
            "output": 16384
          }
        },
        "qwen3:14b": {
          "limit": {
            "context": 65536,
            "output": 16384
          }
        }
      }
    },
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://llamacpp:11434/v1",
        "timeout": 900000,
        "chunkTimeout": 600000
      },
      "models": {
        "qwen3.6-35b-a3b-q4_k_m": {
          "limit": {
            "context": 98304,
            "output": 32440
          }
        },
        "qwen3-coder-30b-a3b-q4_k_m": {
          "limit": {
            "context": 65536,
            "output": 16384
          }
        },
        "gpt-oss-20b-mxfp4": {
          "limit": {
            "context": 65536,
            "output": 16384
          }
        }
      }
    }
  },
  "plugins": [
    "/etc/opencode/plugins/host-metrics",
    "/etc/opencode/plugins/host-metrics-tui",
    "/etc/opencode/plugins/little-mester-exit-confirm"
  ],
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "instructions": [
    "TICKET EDIT RULE (MANDATORY): NEVER directly edit, create, or write files under docs/tickets/*.json. All ticket operations MUST go through the MCP server tools (mester_tickets_* tools) or the ticket-engine CLI (./little-mester-mcp/scripts/ticket-engine). This includes create, update, archive, validate, and any status/criterion/test/comment changes. Direct file edits bypass the audit log and lock mechanism. If you need to modify a ticket, use the MCP tool or CLI — not the edit/write tool."
  ],
  "permissions": [
    {
      "action": "edit",
      "resource": "docs/tickets/**/*.json",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "docs/tickets/*.json",
      "effect": "deny"
    },
    {
      "action": "write",
      "resource": "docs/tickets/**/*.json",
      "effect": "deny"
    },
    {
      "action": "write",
      "resource": "docs/tickets/*.json",
      "effect": "deny"
    }
  ],
  "otel": {},
  "model": "llamacpp/qwen3.6-35b-a3b-q4_k_m",
  "small_model": "llamacpp/qwen3.6-35b-a3b-q4_k_m",
  "mcpServers": {
    "little-mester": {
      "command": "ts-node",
      "args": [
        "src/mcp-server.ts"
      ],
      "cwd": "/workspace/little-mester-mcp",
      "env": {
        "TICKET_DIR": "/workspace/docs/tickets"
      }
    }
  }
}
