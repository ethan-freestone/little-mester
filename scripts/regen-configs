#!/usr/bin/env python3
"""regen-configs [--dry-run] [path-to-models.txt]

Reads models.txt and regenerates opencode.json + updates compose.yaml
CONTEXT_LENGTH from model data. Called automatically by ./lab build/setup.

models.txt format:
  [backend]
  <model_name>    <context_size>    [output_ratio_or_absolute]
  
  Backends: ollama | llamacpp
  output defaults to 0.25 if omitted or <= 1. Values > 1 are treated as absolute integers.
"""
import sys
import json
import os
import re

def parse_models(path):
    """Parse models.txt with backend sections, return dict of backend->list of models."""
    models_by_backend = {"ollama": [], "llamacpp": []}
    current_backend = None
    
    if not os.path.isfile(path):
        print(f"ERROR: {path} not found.", file=sys.stderr)
        sys.exit(1)
    
    with open(path) as f:
        for line_num, line in enumerate(f, 1):
            line = line.split("#")[0].strip()  # strip comments
            if not line:
                continue
            
            # Check for backend section header
            if line.startswith("[") and line.endswith("]"):
                backend = line[1:-1].lower()
                if backend not in models_by_backend:
                    print(f"WARNING: line {line_num}: unknown backend '{backend}', skipping", file=sys.stderr)
                    current_backend = None
                else:
                    current_backend = backend
                continue
            
            if current_backend is None:
                print(f"WARNING: line {line_num}: no backend section active, skipping: {line}", file=sys.stderr)
                continue
            
            parts = line.split()
            if len(parts) < 2:
                print(f"WARNING: line {line_num}: insufficient fields, skipping: {line}", file=sys.stderr)
                continue
                
            name = parts[0]
            try:
                ctx = int(parts[1])
            except ValueError:
                print(f"WARNING: line {line_num}: bad context for {name}: '{parts[1]}'", file=sys.stderr)
                continue
            
            # Determine output: ratio (<=1 or floats like 0.25) vs absolute (>1 integer)
            out = 0
            if len(parts) >= 3:
                val = parts[2]
                try:
                    float_val = float(val)
                    if float_val > 0 and float_val <= 1:
                        # Treat as ratio
                        out = int(ctx * float_val)
                    else:
                        # Treat as absolute
                        out = int(float_val)
                except ValueError:
                    pass
            
            models_by_backend[current_backend].append({
                "name": name,
                "context": ctx,
                "output": out
            })
    
    return models_by_backend


def gen_opencode_json(models_by_backend):
    """Generate the opencode.json content string with both providers."""
    cfg = {
        "$schema": "https://opencode.ai/config.json",
        "autoupdate": False,
        "share": "disabled",
        "provider": {},
        "plugins": [
            "/etc/opencode/plugins/host-metrics",
            "/etc/opencode/plugins/host-metrics-tui"
        ],
        "permission": {
            "edit": "ask",
            "bash": "ask"
        },
        "otel": {}
    }
    
    # Configure Ollama provider if models exist
    ollama_models = models_by_backend.get("ollama", [])
    if ollama_models:
        cfg["provider"]["ollama"] = {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Ollama (local)",
            "options": {
                "baseURL": "http://ollama:11434/v1",
                "timeout": 900000,
                "chunkTimeout": 600000
            },
            "models": {}
        }
        for m in ollama_models:
            cfg["provider"]["ollama"]["models"][m["name"]] = {
                "limit": {
                    "context": m["context"],
                    "output": m["output"]
                }
            }
    
    # Configure llama.cpp provider if models exist
    llamacpp_models = models_by_backend.get("llamacpp", [])
    if llamacpp_models:
        cfg["provider"]["llamacpp"] = {
            "npm": "@ai-sdk/openai-compatible",
            "name": "llama.cpp (local)",
            "options": {
                "baseURL": "http://llamacpp:11434/v1",
                "timeout": 900000,
                "chunkTimeout": 600000
            },
            "models": {}
        }
        for m in llamacpp_models:
            cfg["provider"]["llamacpp"]["models"][m["name"]] = {
                "limit": {
                    "context": m["context"],
                    "output": m["output"]
                }
            }
    
    # Set default model: prefer llamacpp first model, then ollama first model
    default_model = None
    if llamacpp_models:
        default_model = f"llamacpp/{llamacpp_models[0]['name']}"
    elif ollama_models:
        default_model = f"ollama/{ollama_models[0]['name']}"
    
    if default_model:
        cfg["model"] = default_model
        cfg["small_model"] = default_model  # Same as main to prevent eviction thrashing
    
    return json.dumps(cfg, indent=2)


def get_max_context(models_by_backend):
    """Return max context across all models in all backends."""
    all_models = []
    for backend_models in models_by_backend.values():
        all_models.extend(backend_models)
    if not all_models:
        return 65536
    return max(m["context"] for m in all_models)


def update_compose(lab_dir, ctx_value, models_by_backend):
    """Update CONTEXT_LENGTH env vars and MODEL_FILE in compose.yaml for both backends."""
    compose_path = os.path.join(lab_dir, "compose.yaml")
    
    if not os.path.isfile(compose_path):
        print(f"WARNING: {compose_path} not found, skipping compose update.", file=sys.stderr)
        return
    
    # Determine default llama.cpp model file (first llamacpp model)
    llamacpp_models = models_by_backend.get("llamacpp", [])
    model_file = None
    if llamacpp_models:
        model_file = f"/models/{llamacpp_models[0]['name']}.gguf"
    
    with open(compose_path) as f:
        lines = f.readlines()
    
    new_lines = []
    updated = False
    for line in lines:
        stripped = line.lstrip()
        # Update any OLLAMA_CONTEXT_LENGTH or LLAMA_CPP_CONTEXT_LENGTH
        if stripped.startswith("OLLAMA_CONTEXT_LENGTH") or stripped.startswith("LLAMA_CPP_CONTEXT_LENGTH"):
            new_line = re.sub(r':\s*\d+', f': "{ctx_value}"', line)
            new_lines.append(new_line)
            updated = True
        # Update MODEL_FILE for llama.cpp
        elif stripped.startswith("MODEL_FILE:") and model_file:
            # Preserve original indentation
            indent = line[:len(line) - len(stripped)]
            new_line = f'{indent}MODEL_FILE: "{model_file}"\n'
            new_lines.append(new_line)
            updated = True
        else:
            new_lines.append(line)
    
    if updated and "".join(new_lines) != "".join(lines):
        with open(compose_path, "w") as f:
            f.writelines(new_lines)
        return True
    
    return False


def compare_files(content, path):
    """Compare content string against a file byte-by-byte."""
    try:
        with open(path, "rb") as fp:
            return content.encode() == fp.read()
    except FileNotFoundError:
        return False


def main():
    dry_run = False
    models_file = None
    
    args = sys.argv[1:]
    
    # Parse non-file arguments
    remaining = []
    for arg in args:
        if arg == "--dry-run":
            dry_run = True
        else:
            remaining.append(arg)
    
    # Get paths
    script_dir = os.path.dirname(os.path.abspath(__file__))
    lab_dir = os.path.dirname(script_dir)  # one level up from scripts/
    
    if remaining:
        models_file = remaining[0]
    else:
        models_file = os.path.join(lab_dir, "models.txt")
    
    # Parse
    models_by_backend = parse_models(models_file)
    
    total_models = sum(len(m) for m in models_by_backend.values())
    if total_models == 0:
        print("ERROR: no models parsed from", file=sys.stderr)
        sys.exit(1)
    
    print("=== Regen configs ===")
    for backend, models in models_by_backend.items():
        if models:
            print(f"  [{backend}]")
            for m in models:
                print(f"    {m['name']}: ctx={m['context']}, out={m['output']}")
    
    if dry_run:
        max_ctx = get_max_context(models_by_backend)
        print(f"  max context -> CONTEXT_LENGTH: {max_ctx}")
        print("  (dry run - no files modified)")
        
        expected = gen_opencode_json(models_by_backend) + "\n"
        actual_path = os.path.join(lab_dir, "agent/opencode", "opencode.json")
        
        with open(actual_path, "rb") as f:
            current = f.read()
        if expected.encode("utf-8") == current:
            print("  [unchanged] agent/opencode/opencode.json")
        else:
            print("  [would update] agent/opencode/opencode.json")
        return
    
    # Generate opencode.json content
    predicted = gen_opencode_json(models_by_backend)
    actual_path = os.path.join(lab_dir, "agent/opencode", "opencode.json")
    
    with open(actual_path, "rb") as f:
        current = f.read()
    if predicted.encode("utf-8") + b"\n" == current:
        print("  [unchanged] agent/opencode/opencode.json")
    else:
        with open(actual_path, "w") as f:
            f.write(predicted + "\n")
        print("  [updated] agent/opencode/opencode.json")
    
    # Update compose.yaml
    max_ctx = get_max_context(models_by_backend)
    updated = update_compose(lab_dir, max_ctx, models_by_backend)
    if updated:
        print(f"  [updated] compose.yaml CONTEXT_LENGTH -> {max_ctx}")
    else:
        print(f"  [unchanged] compose.yaml CONTEXT_LENGTH={max_ctx}")
    
    print("=== Done ===")


if __name__ == "__main__":
    main()