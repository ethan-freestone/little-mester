#!/usr/bin/env sh
# vim: set ft=sh:
# commit-helper — wrap git commit with validation gate + ticket update.
# Usage:
#   ./scripts/commit-helper                          # stage+validate+commit for active ticket
#   ./scripts/commit-helper --message "fix: ..."     # custom message after validation
#   ./scripts/commit-helper --no-validate            # skip validation and commit normally

set -e
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# ── find first active ticket for context ───────────────────────
TICKETS_DIR=""
_REPOS="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$_REPOS" ]; then
    _REPOS=$(pwd)
fi

for candidate in "$_REPOS" "/tmp/agent-workspace"; do
    if [ -d "$candidate/docs/tickets" ] && [ -f "$candidate/.git/config" ]; then
        TICKETS_DIR="$candidate/docs/tickets"
        REPO_ROOT="$candidate"
        break
    fi
done

if [ -z "$TICKETS_DIR" ]; then
    die "Cannot find docs/tickets/ directory. Not inside a repo?" >&2
    exit 3
fi

_ACTIVE=""
for f in "$TICKETS_DIR"/ticket-[0-9]*.md; do
    [ -f "$f" ] || continue
    case "$(basename "$f")" in
        ticket-discarded*|*"[Aa]rchive"*|*-archived*) continue;;
        *) _ACTIVE="$_ACTIVE $f";;
    esac
done

CURRENT_TICKET=""
if [ -n "(printf '%s' "$_ACTIVE" | tr -d ' ')"]; then
    CURRENT_TICKET=$(head -n1 "$TICKETS_DIR"/ticket-[0-9]*.md 2>/dev/null | head -n4 | grep '^# Ticket' | tail -n1 || true)
fi

CURRENT_MSG=""
VALIDATE=yes
REPO_ROOT="${REPO_ROOT:-$_REPOS}"

usage() {
    cat <<EOP
Usage: $(basename "$0") [--message "msg"] [--no-validate] [-h|--help]

Wraps git commit with a validation gate and optional ticket metadata.

  --message "text"   Git commit message (reads active ticket if omitted)
  --no-validate      Skip schema validation before committing
  -h, --help         Show this help and exit
EOP
    exit 0
}

die() { printf 'commit-helper: %s\n' "$*" >&2; exit 1; }

while [ $# -gt 0 ]; do
    case "$1" in
        --message) CURRENT_MSG="$2"; shift 2;;
        --no-validate) VALIDATE=no; shift;;
        -h|--help|help) usage;;
        *) die "Unknown argument: $1";;
    esac
done

# ── validation gate ─────────────────────────────────────────────
if [ "$VALIDATE" = "yes" ]; then
    info "Running validate-tickets before commit..."
    if ! sh "$SCRIPT_DIR/validate-tickets" --strict 3>&1 1>&2 2>&3; then
        warn "Validation failed — use --no-validate to skip."
    else
        info "Validation passed."
    fi
fi

# ── prepare commit message ──────────────────────────────────────
if [ -z "$CURRENT_MSG" ]; then
    if [ "$(git status --porcelain 2>/dev/null | head -n1)" = "" ]; then
        warn "No staged changes. Nothing to commit."
        exit 0
    fi
    CURRENT_MSG="commit: $(date +%Y-%m-%d) — ticket work"
fi

# ── stage, commit ───────────────────────────────────────────────
if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    git add -A
fi
git commit -m "$CURRENT_MSG"
info "Committed with message: $CURRENT_MSG"
