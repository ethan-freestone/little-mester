{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ticket-system/schema/meta",
  "title": "Ticket Schema - multi-era",
  "description": "Defines validation rules for the current era's ticket format.",

  "properties": {
    "current_era": {
      "type": "integer",
      "enum": [1, 2],
      "default": 2,
      "description": "The active schema era. Era 1 = flat directory. Era 2 = area-based."
    },
    "era_1": {
      "type": "object",
      "description": "Legacy format (flat docs/tickets/*.md). Accepted during transition.",
      "properties": {
        "pattern": "^ticket-[0-9]{3}-[a-z][a-z0-9-]+\\.md$",
        "field_required": ["title", "objective", "scope_boundaries"],
        "section_order": [
          "heading", "objective", "scope_boundaries", "steps",
          "verification", "files", "dependencies"
        ]
      }
    },
    "era_2": {
      "type": "object",
      "description": "Area-based format. All new tickets must conform.",
      "properties": {
        "required_fields": ["area", "title", "type", "status"],
        "valid_types": ["feature", "bug", "infra", "pause"],
        "valid_statuses": ["ACTIVE", "DRAFT", "MERGED", "ARCHIVED"],
        "directory_structure": {
          "root": "docs/tickets/",
          "active_base": "active/<area>/",
          "merged_base": "merged/<area>/",
          "archive_base": "archive/<area>/",
          "index_name": "_index.json"
        },
        "naming_convention": {
          "file_name_pattern": "^ticket-[0-9]+\\.md$",
          "heading_format": "^# Ticket (\\d+) — .+$"
        }
      }
    }
  },
  "additionalProperties": false
}
