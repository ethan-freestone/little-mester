#!/usr/bin/env bash
set -euo pipefail

LAB_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
LAB_UID="$(id -u)"
LAB_GID="$(id -g)"
WORKSPACE=""
MOUNT_MODE="rw"  # Default mount mode
WORKFLOW=""      # Default workflow (default, tdd, regression)
VERBOSE=0        # Enable verbose logging
PERMISSIONS=""    # Optional: per-run permission override (deny|ask|auto)
AGENT="opencode"    # Which agent to launch: opencode | aider (fallback)

# Network mode: egress=true by default; --isolated flips to false
EGRESS="${EGRESS:-true}"

# Self-edit guard toggle (default: deny)
UNSAFE_RECURSE=0

# Docker build cache (default: use cache)
NO_CACHE=0

# Load user config if present (gitignored; put your real identity here)
if [[ -f "$LAB_DIR/.little-mester.conf" ]]; then
  set -a
  source "$LAB_DIR/.little-mester.conf"
  set +a
fi

# Neutral default git identity for agent commits
GIT_AUTHOR_NAME="${GIT_AUTHOR_NAME:-little-mester-agent}"
GIT_AUTHOR_EMAIL="${GIT_AUTHOR_EMAIL:-agent@localhost}"
GIT_COMMITTER_NAME="${GIT_COMMITTER_NAME:-little-mester-agent}"
GIT_COMMITTER_EMAIL="${GIT_COMMITTER_EMAIL:-agent@localhost}"

die() { echo "REFUSED: $*" >&2; exit 1; }

dc() {
  local networks="[egress, internal]"
  if [[ "$EGRESS" != "true" ]]; then
    networks="[internal]"
  fi

  env "WORKSPACE=${WORKSPACE:-$LAB_DIR}" \
        "LAB_UID=$LAB_UID" \
        "LAB_GID=$LAB_GID" \
        "MOUNT_MODE=$MOUNT_MODE" \
        "LITTLE_MESTER_WORKFLOW=${WORKFLOW:-default}" \
        "LITTLE_MESTER_VERBOSE=$VERBOSE" \
        "LITTLE_MESTER_EGRESS=${EGRESS}" \
        "NETWORKS=${networks}" \
        "GIT_AUTHOR_NAME=$GIT_AUTHOR_NAME" \
        "GIT_AUTHOR_EMAIL=$GIT_AUTHOR_EMAIL" \
        "GIT_COMMITTER_NAME=$GIT_COMMITTER_NAME" \
        "GIT_COMMITTER_EMAIL=$GIT_COMMITTER_EMAIL" \
      docker compose -f "$LAB_DIR/compose.yaml" --project-directory "$LAB_DIR" "$@"
}

check_workspace() {
  local ws="$1"
  [[ -d "$ws" ]] || die "Not a directory: $ws"
  ws="$(realpath "$ws")"

  # System & Root folder protections
  [[ "$ws" != "/" ]] || die "Cannot mount filesystem root (/)"
  [[ "$ws" != "$HOME" ]] || die "Cannot mount entire home directory ($HOME)"

  # Ensure target is owned by current user
  [[ -O "$ws" ]] || die "Workspace directory must be owned by you (UID $LAB_UID)"

  # Prevent exposing the lab repo itself
  if [[ "$ws" == "$LAB_DIR" || "$LAB_DIR" == "$ws"/* ]]; then
    if [[ "${UNSAFE_RECURSE:-0}" != "1" ]]; then
      die "Workspace path would expose the little-mester repo itself. Use --unsafe-recurse to override (requires awareness of the risks)."
    fi
  fi

  # Blacklist sensitive credential/config paths
  local sensitive_paths=(
    "$HOME/.ssh"
    "$HOME/.gnupg"
    "$HOME/.config"
    "$HOME/.aws"
    "$HOME/.kube"
    "$HOME/.local"
    "$HOME/.bashrc"
    "$HOME/.zshrc"
  )

  for s in "${sensitive_paths[@]}"; do
    if [[ "$ws" == "$s" || "$ws" == "$s"/* || "$s" == "$ws"/* ]]; then
      die "Path overlaps with sensitive system/credential directory: $s"
    fi
  done

  WORKSPACE="$ws"
}

# check_egress_permission: per-call authorization gate for egress access
# Before granting internet, checks .mester-egress manifest in workspace.
# Format of .mester-egress (if present):
#   permission=true     | explicit default: allow
#   permission=false    | explicit deny overrides egress=false default
#   allowed_domains=... | comma-separated list; blank means "all domains"
#   intent=<brief>      | human-readable description of intended use
# Returns 0 if access is granted, non-zero otherwise.
check_egress_permission() {
  local manifest="$WORKSPACE/.mester-egress"

  # No manifest = egress defaults to the configured EGRESS variable (true)
  if [[ ! -f "$manifest" ]]; then
    if [[ "$EGRESS" != "true" ]]; then
      return 0  # user said --isolated / egress=false, no need for permission check
    fi
    print_verbose "No .mester-egress manifest found; egress defaults to $EGRESS"
    return 0
  fi

  # Read manifest values (supports inline comments with #)
  local perm domains intent
  while IFS='=' read -r key value; do
    # Strip leading/trailing whitespace and comments
    key="$(echo "$key" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^#' || true)"
    [[ -z "$key" ]] && continue
    value="$(echo "$value" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^#' || true)"

    case "$key" in
      permission*) perm="$value" ;;
      allowed_domains*) domains="$value" ;;
      intent*) intent="$value" ;;
    esac
  done < "$manifest"

  # Check explicit deny — overrides everything
  if [[ "${perm:-}" == "false" ]]; then
    print_verbose "Egress denied by .mester-egress (permission=false)"
    return 1
  fi

  # If user explicitly requested --isolated, respect that regardless of manifest
  if [[ "$EGRESS" != "true" ]]; then
    print_verbose "Egress disabled via environment or flag (--isolated)"
    return 0
  fi

  # Default when permission is true or unset and EGRESS=true: allow
  print_verbose "Egress granted by .mester-egress (permission=${perm:-default(true)})"
  return 0
}

confirm() {
  [[ "${LAB_YES:-}" == "1" ]] && return 0
  echo "--------------------------------------------------------"
  echo " Mounting path : $WORKSPACE"
  echo " Mount mode    : READ-${MOUNT_MODE^^}"
  echo " Egress        : ${EGRESS}"
  echo " Agent         : $AGENT"
  echo " Workflow      : ${WORKFLOW:-default}"
  echo " Verbose       : $VERBOSE"
  echo " Unsaferecurse : ${UNSAFE_RECURSE:-0}"
  echo "--------------------------------------------------------"
  read -r -p "Continue? [y/N] " a
  [[ "$a" == "y" || "$a" == "Y" ]] || exit 1
}

print_verbose() {
  [[ "$VERBOSE" == "1" ]] && echo "[verbose] $*" >&2 || true
}

warn_hooks() {
  local h
  h="$(find "$WORKSPACE" -path '*/.git/hooks/*' -type f ! -name '*.sample' 2>/dev/null || true)"
  if [[ -n "$h" ]]; then
    echo "WARNING: Non-sample git hooks found inside workspace:"
    echo "$h"
    echo "Note: Git hooks created or modified by the agent will execute on YOUR HOST if triggered!"
  fi
}

# Parse flags (they must come BEFORE the subcommand or workspace path)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --ro) MOUNT_MODE="ro"; shift ;;
      --rw) MOUNT_MODE="rw"; shift ;;
      --workflow) WORKFLOW="${2:-default}"; shift 2 ;;
      --verbose) VERBOSE=1; shift ;;
      --agent) AGENT="${2:?--agent needs a name (aider|opencode)}"; shift 2 ;;
      --egress) EGRESS="${2:?--egress needs true/false}"; shift 2 ;;
      --egress-false|--isolated) EGRESS="false"; shift ;;
      --egress-true) EGRESS="true"; shift ;;
      --permissions) PERMISSIONS="${2:?--permissions needs deny/ask/auto}"; shift 2 ;;
      --unsafe-recurse) UNSAFE_RECURSE=1; shift ;;
      --no-cache) NO_CACHE=1; shift ;;
      --opencode) AGENT="opencode"; shift ;;
      --aider) AGENT="aider"; shift ;;
      *) break ;;
    esac
  done

  case "${1:-}" in
    setup)
      command -v pacman >/dev/null || die "automated setup is Arch/CachyOS only; see docs/01-host-setup.md"
      nvidia-smi -L || die "NVIDIA driver not working on host (fix this first)"
      sudo pacman -S --needed docker docker-compose docker-buildx nvidia-container-toolkit
      sudo systemctl enable --now docker
      sudo nvidia-ctk runtime configure --runtime=docker
      sudo systemctl restart docker
      sudo docker run --rm --gpus all ubuntu:24.04 nvidia-smi -L
      # Build with optional --no-cache
      if [[ "$NO_CACHE" -eq 1 ]]; then
        dc build --no-cache agent metrics
      else
        dc build agent metrics
      fi
      ( cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && ./scripts/regen-configs ) 2>&1
      echo ">> Pulling Ollama models..."
      dc --profile setup run --rm ollama-pull
      echo ">> Pulling llama.cpp GGUF models..."
      dc --profile setup run --rm llamacpp-pull
      echo "Setup complete. Next: ./verify-lab.sh, then ./lab <workspace>"
      ;;
    build)
      shift
      # Regenerate opencode.json from models.txt before building the image
      ( cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/scripts" && ./regen-configs ) 2>&1
      if [[ "$NO_CACHE" -eq 1 ]]; then
        dc build --no-cache "$@" agent metrics
      else
        dc build "$@" agent metrics
      fi
      ;;
    pull)
      ( cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/scripts" && ./regen-configs ) 2>&1
      echo ">> Pulling Ollama models..."
      dc --profile setup run --rm ollama-pull
      echo ">> Pulling llama.cpp GGUF models..."
      dc --profile setup run --rm llamacpp-pull
      ;;
    stop)
      dc down
      ;;
    bench)
      # Benchmark runner — two modes:
      #   HTTP mode (default): connects to running llamacpp, measures real throughput/latency
      #   Native mode (--native): runs llama.cpp --test inside container, instant between-test switches
      shift
      MODE="http"
      BENCH_JSON=0 BENCH_N=5
      # Native-mode params (passed via env to bench service)
      NATIVE_THREADS="" NATIVE_UB="" NATIVE_MOE="" NATIVE_CTX="" NATIVE_JSON=""

      while [[ $# -gt 0 ]]; do
        case "$1" in
          --native)   MODE="native"; shift ;;
          --json)     BENCH_JSON=1; NATIVE_JSON=1; shift ;;
          -n|--repeats) BENCH_N="${2:?-n needs a count}"; shift 2 ;;
          -t|--threads) NATIVE_THREADS="${2:?-t needs a value}"; shift 2 ;;
          -ub|--micro-batch) NATIVE_UB="${2:?-ub needs a value}"; shift 2 ;;
          --moe|--n-cpu-moe) NATIVE_MOE="${2:?--n-cpu-moe needs a value}"; shift 2 ;;
          --ctx|--context) NATIVE_CTX="${2:?--context needs a value}"; shift 2 ;;
          --help|-h)
            cat <<'HELPTEXT'
Usage: ./lab bench [OPTIONS]

Benchmark the currently-running model server.

HTTP mode (default, no GPU needed):
  ./lab bench                  Measure throughput/latency against running server
  ./lab bench --json           Machine-readable JSON output
  ./lab bench -n 10            10 repeats per config (default: 5)

Native mode (requires GPU — runs llama.cpp --test inside container):
  ./lab bench --native         Benchmark with current llamacpp config
  ./lab bench --native -t 10   Test with 10 threads
  ./lab bench --native -ub 1024
  ./lab bench --native --json  JSON output

  --native              Run llama.cpp --test inside container (zero HTTP overhead)
  --json                Output structured JSON (parsable by AI for recommendations)
  -n N                  Repeats per config (default: 5)
  -t N                  Thread count (native mode only)
  -ub N                 Micro-batch size (native mode only)
  --n-cpu-moe N         CPU MoE experts (native mode only)
  --context N           Context window (native mode only)
  --help                Show this help

Workflow:
  1. ./lab bench              → baseline measurement (HTTP mode, safe anytime)
  2. Edit compose.yaml llamacpp command, then:
     ./lab restart-llama      → restart with new params, benchmark:
     ./lab bench --native     → fast in-container benchmark
  3. ./lab bench --json       → pipe to AI for parameter recommendations

For full tuning sweep:
  ./lab tune                 → cycle through configs, produce comparison table
HELPTEXT
            exit 0
            ;;
          *) echo "Unknown bench flag: $1" >&2; exit 1 ;;
        esac
      done

      if [[ "$MODE" == "native" ]]; then
        # ── Native mode: build bench service (with GPU + model volume) ──────
        echo ">> Building bench image for native mode${NO_CACHE:+ (no cache)}..."
        if [[ "$NO_CACHE" -eq 1 ]]; then
          dc --profile bench build --no-cache bench
        else
          dc --profile bench build bench
        fi

        # Set native params from CLI args or fall back to compose defaults
        local_env=""
        local_env+="MODEL_DIR=/models "
        local_env+="BENCH_JSON=$NATIVE_JSON "
        local_env+="BENCH_N=$BENCH_N "
        [[ -n "$NATIVE_THREADS" ]] && local_env+="THREADS=$NATIVE_THREADS "
        [[ -n "$NATIVE_UB" ]]        && local_env+="MICRO_BATCH=$NATIVE_UB "
        [[ -n "$NATIVE_MOE" ]]       && local_env+="NCPU_MOE=$NATIVE_MOE "
        [[ -n "$NATIVE_CTX" ]]       && local_env+="CONTEXT=$NATIVE_CTX "

        echo ">> Running native benchmark (zero HTTP overhead)..."
        env $local_env dc run --rm bench
      else
        # ── HTTP mode: lightweight container, no GPU ───────────────────────
        echo ">> Building bench image (cached)${NO_CACHE:+ (no cache)}..."
        if [[ "$NO_CACHE" -eq 1 ]]; then
          dc build --no-cache bench
        else
          dc build bench
        fi

        # Wait for llamacpp to be healthy
        echo ">> Waiting for llamacpp server..."
        for i in $(seq 1 30); do
          if dc exec llamacpp curl -sf -m 3 http://127.0.0.1:11434/health >/dev/null 2>&1; then
            break
          fi
          [[ $i -eq 30 ]] && { echo ">> ERROR: llamacpp not healthy after 30s" >&2; exit 1; }
          sleep 1
        done

        echo ">> Running benchmark (${BENCH_N} repeats each)..."
        BENCH_JSON="$BENCH_JSON" BENCH_N="$BENCH_N" dc run --rm bench
      fi
      ;;
    restart-llama)
      # Restart llama.cpp server with new parameters from compose.yaml.
      #
      # Workflow:
      #   1. Edit compose.yaml → llamacpp command line (-t N, --n-cpu-moe N, etc.)
      #   2. ./lab restart-llama          (~20s to reload model from cached layer)
      #   3. ./lab bench --native         (fast in-container benchmark)
      #
      # KV cache persistence: --cache flag keeps model in VRAM between
      # restarts, reducing reload to ~2-3s.
      shift
      CACHE_FLAG=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --cache) CACHE_FLAG="--cache"; shift ;;
          --help|-h)
            cat <<'HELPTEXT'
Usage: ./lab restart-llama [OPTIONS]

Restart the llama.cpp model server with parameters from compose.yaml.

This is the fast way to test parameter changes:
  1. Edit compose.yaml → llamacpp service command line
  2. ./lab restart-llama           (~20s to reload model from cached layer)
  3. ./lab bench --native          (benchmark the new config)

Options:
  --cache    Enable KV cache persistence (reduces reload to ~2-3s)
             Only use if the model file and architecture haven't changed.
             Without --cache, the model is fully reloaded from disk each time.

When to use:
  - You changed -t, --n-cpu-moe, -ub, -c or similar runtime params
  - The model file (GGUF) is the same
  - You want to iterate fast between test runs

When NOT to use:
  - You changed the model file (different GGUF)
  - You want a clean slate
  - You need --no-cache rebuild for other reasons
HELPTEXT
            exit 0
            ;;
          *) echo "Unknown restart-llama flag: $1" >&2; exit 1 ;;
        esac
      done

      # If --cache was requested, inject --cache into the llamacpp command
      if [[ -n "$CACHE_FLAG" ]]; then
        echo ">> Adding --cache flag for KV persistence..."
        if ! grep -q '\-\-cache' compose.yaml; then
          sed -i '/^      --parallel 1 --jinja$/a\      --cache' compose.yaml
          echo "   Added --cache to compose.yaml llamacpp command"
          echo "   Remove it manually when you change the model file."
        fi
      fi

      echo ">> Restarting llama.cpp server..."
      dc restart llamacpp || dc up -d llamacpp
      ;;
    tune)
      # Automated parameter tuning sweep — tests multiple configs and compares.
      #
      # Usage:
      #   ./lab tune                           Full sweep (uses compose defaults)
      #   ./lab tune -t 8,10,12                Sweep threads only
      #   ./lab tune --json > results.json     Machine-readable output
      #   ./lab tune --full                    Sweep all knobs
      shift
      TUNE_JSON=0
      TUNE_ANALYSE=0
      TUNE_THREADS="8,10,12"
      TUNE_UB="1024,2048,4096"
      TUNE_MOE=""
      TUNE_CTX=""
      TUNE_FULL=0

      while [[ $# -gt 0 ]]; do
        case "$1" in
          --json)        TUNE_JSON=1; shift ;;
          -t)            TUNE_THREADS="${2:-$TUNE_THREADS}"; shift 2 ;;
          -ub)           TUNE_UB="${2:-$TUNE_UB}"; shift 2 ;;
          --moe|--n-cpu-moe) TUNE_MOE="${2:-}"; shift 2 ;;
          --ctx|--context) TUNE_CTX="${2:-}"; shift 2 ;;
          --full)        TUNE_FULL=1; shift ;;
          --analyse|--ai) TUNE_ANALYSE=1; shift ;;
          --help|-h)
            cat <<'HELPTEXT'
Usage: ./lab tune [OPTIONS]

Automated parameter tuning sweep — tests multiple configs and compares.

This is for when you want to find the optimal settings without manual
trial and error. It restarts llama.cpp for each config and benchmarks.

Options:
  --json          Output as machine-readable JSON (AI-parseable)
  -t N,N,N        Thread values to test (default: 8,10,12)
  -ub N,N,N       Micro-batch values (default: 1024,2048,4096)
  --moe N,N,N     CPU-MoE values to test (default: from compose.yaml)
  --ctx N,N,N     Context window values (default: 65536)
  --full          Sweep all knobs (threads x cpu-moe x micro-batch)
  --analyse       After sweep, run AI analysis on results (requires Ollama)
  --help          Show this help

Example workflows:
  # Quick: test just threads
  ./lab tune -t 8,10,12

  # Full sweep: test all combinations
  ./lab tune --full

  # Hardware-specific sweep
  ./lab tune -t 6,8,10,12 --moe 24,32,40 -ub 1024,2048

  # Save results for AI analysis
  ./lab tune --json > tune-results.json

  # One-liner: sweep + AI analysis (requires Ollama running)
  ./lab tune --analyse

  # Pipe results to AI manually
  ./lab tune --json | ./lab ai-analyze
  ./lab ai-analyze < tune-results.json
HELPTEXT
            exit 0
            ;;
          *) echo "Unknown tune flag: $1" >&2; exit 1 ;;
        esac
      done

      # Parse sweep lists
      IFS=',' read -ra SW_THREADS <<< "$TUNE_THREADS"
      IFS=',' read -ra SW_UB <<< "$TUNE_UB"
      [[ ${#SW_THREADS[@]} -eq 0 ]] && SW_THREADS=(8 10 12)
      [[ ${#SW_UB[@]} -eq 0 ]] && SW_UB=(1024 2048 4096)

      # CPU-MoE: use provided list or extract from compose.yaml
      declare -a SW_MOE=()
      if [[ -n "$TUNE_MOE" ]]; then
        IFS=',' read -ra SW_MOE <<< "$TUNE_MOE"
      else
        DEFAULT_MOE=$(grep -oP '\-\-n-cpu-moe\s+\K\d+' compose.yaml 2>/dev/null || echo "32")
        SW_MOE=("$DEFAULT_MOE")
      fi

      # Context: use provided list or extract from compose.yaml
      declare -a SW_CTX=()
      if [[ -n "$TUNE_CTX" ]]; then
        IFS=',' read -ra SW_CTX <<< "$TUNE_CTX"
      else
        DEFAULT_CTX=$(grep -oP '\$\{LLAMA_CPP_CONTEXT_LENGTH:-\K\d+' compose.yaml 2>/dev/null || echo "65536")
        SW_CTX=("$DEFAULT_CTX")
      fi

      echo "============================================================"
      echo " Parameter Tuning Sweep"
      echo "  Threads : ${SW_THREADS[*]}"
      echo "  Micro-batch : ${SW_UB[*]}"
      echo "  CPU-MoE : ${SW_MOE[*]}"
      echo "  Context : ${SW_CTX[*]}"
      echo "============================================================"
      echo ""

      echo ">> Building bench image${NO_CACHE:+ (no cache)}..."
      if [[ "$NO_CACHE" -eq 1 ]]; then
        dc build --no-cache bench
      else
        dc build bench
      fi

      echo ">> Stopping llamacpp to free VRAM for sweep..."
      dc stop llamacpp 2>/dev/null || true

      # Track results for summary
      declare -a RESULTS=()
      TOTAL=$(( ${#SW_THREADS[@]} * ${#SW_UB[@]} * ${#SW_MOE[@]} * ${#SW_CTX[@]} ))
      COUNT=0

      echo ">> Running $TOTAL benchmark configurations..."
      echo ""

      for t in "${SW_THREADS[@]}"; do
        for ub in "${SW_UB[@]}"; do
          for m in "${SW_MOE[@]}"; do
            for ctx in "${SW_CTX[@]}"; do
              COUNT=$((COUNT + 1))
              echo "--- [$COUNT/$TOTAL] t=$t  ub=$ub  moe=$m  ctx=$ctx ---"

              # Run native benchmark (llamacpp is already stopped, no VRAM clash)
              OUTPUT=$(MODEL_DIR=/models BENCH_JSON=0 BENCH_N=3 \
                       THREADS=$t MICRO_BATCH=$ub NCPU_MOE=$m CONTEXT=$ctx \
                       dc run --rm bench 2>&1) || true

              # Extract TPS from output
              TPS=$(echo "$OUTPUT" | grep -oP '\b\d+\.\d+\s*tokens/?\s*(per\s+)?sec' | grep -oP '[\d.]+' | head -1 || echo "")
              [[ -z "$TPS" ]] && TPS="N/A"

              echo "  -> ${TPS} t/s"
              RESULTS+=("{\"config\":{\"threads\":$t,\"micro_batch\":$ub,\"n_cpu_moe\":$m,\"context\":$ctx},\"tps\":\"$TPS\"}")
            done
          done
        done
      done

      echo ">> Restarting llamacpp..."
      dc up -d llamacpp

      echo ""
      echo "============================================================"
      echo " TUNING RESULTS SUMMARY"
      echo "============================================================"

      if [[ "$TUNE_JSON" -eq 1 ]]; then
        echo "{"
        echo "  \"mode\": \"tune\","
        echo "  \"configs_tested\": $COUNT,"
        echo "  \"results\": ["
        FIRST=1
        for r in "${RESULTS[@]}"; do
          if [[ $FIRST -eq 1 ]]; then FIRST=0; else echo ","; fi
          echo "    $r"
        done
        echo ""
        echo "  ]"
        echo "}"
      else
        echo "  Config                      TPS"
        echo "  -------------------------  -----"
        for r in "${RESULTS[@]}"; do
          T_VAL=$(echo "$r" | grep -oP '"threads":\K\d+')
          M_VAL=$(echo "$r" | grep -oP '"n_cpu_moe":\K\d+')
          UB_VAL=$(echo "$r" | grep -oP '"micro_batch":\K\d+')
          CTX_VAL=$(echo "$r" | grep -oP '"context":\K\d+')
          TPS_VAL=$(echo "$r" | grep -oP '"tps":"\K[^"]+')
          printf "  t=%-3s  ub=%-5s  moe=%-3s  ctx=%-6s  %s\n" "$T_VAL" "$UB_VAL" "$M_VAL" "$CTX_VAL" "$TPS_VAL"
        done
        echo ""
        # Find best
        BEST=""
        BEST_TPS=0
        for r in "${RESULTS[@]}"; do
          TPS_VAL=$(echo "$r" | grep -oP '"tps":"\K[^"]+')
          if [[ "$TPS_VAL" != "N/A" ]] && (( $(awk "BEGIN {print ($TPS_VAL > $BEST_TPS)}") )); then
            BEST_TPS=$TPS_VAL
            BEST=$r
          fi
        done
        if [[ -n "$BEST" ]]; then
          BT=$(echo "$BEST" | grep -oP '"threads":\K\d+')
          BM=$(echo "$BEST" | grep -oP '"n_cpu_moe":\K\d+')
          BUB=$(echo "$BEST" | grep -oP '"micro_batch":\K\d+')
          BCTX=$(echo "$BEST" | grep -oP '"context":\K\d+')
          echo "  * Best: t=$BT  ub=$BUB  moe=$BM  ctx=$BCTX -> ${BEST_TPS} t/s"
        fi
      fi

      echo ""
      echo ">> Tips for next steps:"
      echo "  1. Pipe JSON to AI:  cat results.json | AI analyze"
      echo "  2. Apply best config to compose.yaml llamacpp command"
      echo "  3. ./lab restart-llama  to activate"
      echo "  4. ./lab bench          to verify in production"

      # Run AI analysis if --analyse flag was used
      if [[ "$TUNE_ANALYSE" -eq 1 ]]; then
        echo ""
        echo "============================================================"
        echo " Running AI Analysis"
        echo "============================================================"
        # Build JSON results for the AI
        AI_JSON="{"
        AI_JSON+="\"mode\":\"tune\","
        AI_JSON+="\"configs_tested\":$COUNT,"
        AI_JSON+="\"results\":["
        AI_FIRST=1
        for r in "${RESULTS[@]}"; do
          if [[ $AI_FIRST -eq 1 ]]; then AI_FIRST=0; else AI_JSON+=","; fi
          AI_JSON+="$r"
        done
        AI_JSON+="]"
        AI_JSON+="}"

        # Pipe to ai-analyze
        echo "$AI_JSON" | ./lab ai-analyze
      fi
      ;;
    ai-analyze)
      # AI-powered analysis of benchmark results.
      #
      # Reads benchmark JSON from stdin (piped or redirected) or from
      # a file argument. Sends it to a local Ollama model for analysis.
      #
      # The AI receives:
      #   - Benchmark JSON results (all parameter combinations tested)
      #   - Machine specs from machine.conf (if it exists)
      #
      # The AI responds with:
      #   - Optimal settings with reasoning
      #   - Trade-offs and warnings
      #   - Recommended compose.yaml changes
      #
      # Usage:
      #   ./lab ai-analyze < results.json          # Read from file
      #   ./lab tune --json | ./lab ai-analyze     # Pipe from tune
      #   ./lab ai-analyze results.json            # File argument
      #   ./lab ai-analyze --model phi3:mini       # Use different model
      shift
      AI_MODEL=""
      AI_FILE=""

      while [[ $# -gt 0 ]]; do
        case "$1" in
          --model)     AI_MODEL="${2:?--model needs a model name}"; shift 2 ;;
          --help|-h)
            cat <<'HELPTEXT'
Usage: ./lab ai-analyze [OPTIONS] [FILE]

AI-powered analysis of benchmark results using a local Ollama model.

Reads benchmark JSON from stdin, a file argument, or a file piped via stdin.
Sends it to Ollama for analysis of optimal llama.cpp parameters.

Options:
  --model NAME   Ollama model to use (default: qwen2.5:1.5b)
  --help         Show this help

How it works:
  1. Collects benchmark JSON results (all parameter combinations)
  2. Reads machine.conf for your hardware specs (if it exists)
  3. Sends both to Ollama's chat API
  4. AI analyzes the results and returns:
     - Optimal parameter recommendations
     - Reasoning behind each recommendation
     - Trade-offs and potential issues (VRAM, etc.)
     - Suggested compose.yaml changes

Model recommendations:
  - qwen2.5:1.5b   Fast, good at structured analysis (default)
  - phi3:mini      Fast, capable for this task
  - llama3.2       Good reasoning, slightly slower
  - You can use any model Ollama has loaded

Examples:
  # Analyze results from a tune sweep
  ./lab tune --json > results.json
  ./lab ai-analyze results.json

  # One-liner with pipe
  ./lab tune --json | ./lab ai-analyze

  # Use a different model
  ./lab ai-analyze --model phi3:mini results.json
  ./lab tune --json | ./lab ai-analyze --model phi3:mini
HELPTEXT
            exit 0
            ;;
          -*) echo "Unknown ai-analyze flag: $1" >&2; exit 1 ;;
          *)  AI_FILE="$1"; shift ;;
        esac
      done

      # Get default model
      [[ -z "$AI_MODEL" ]] && AI_MODEL="qwen2.5:1.5b"

      # Get benchmark JSON
      BENCH_JSON=""
      if [[ -n "$AI_FILE" ]]; then
        # Read from file argument
        if [[ ! -f "$AI_FILE" ]]; then
          echo ">> ERROR: File not found: $AI_FILE" >&2
          exit 1
        fi
        BENCH_JSON=$(cat "$AI_FILE")
      elif [[ ! -t 0 ]]; then
        # Read from stdin (piped)
        BENCH_JSON=$(cat)
      else
        echo ">> ERROR: No input provided." >&2
        echo "   Usage: ./lab ai-analyze < results.json" >&2
        echo "   Usage: ./lab ai-analyze results.json" >&2
        echo "   Usage: ./lab tune --json | ./lab ai-analyze" >&2
        exit 1
      fi

      # Get machine specs from machine.conf if it exists
      MACHINE_SPECS=""
      if [[ -f "machine.conf" ]]; then
        echo ">> Reading machine specs from machine.conf..."
        # Extract key fields
        GPU_NAME=$(grep '^GPU_NAME=' machine.conf 2>/dev/null | cut -d= -f2- | tr -d '" ')
        GPU_VRAM=$(grep '^GPU_VRAM_GB=' machine.conf 2>/dev/null | cut -d= -f2- | tr -d '" ')
        CPU_CORES=$(grep '^CPU_CORES=' machine.conf 2>/dev/null | cut -d= -f2- | tr -d '" ')
        CPU_MODEL=$(grep '^CPU_MODEL=' machine.conf 2>/dev/null | cut -d= -f2- | tr -d '" ')
        DEFAULT_THREADS=$(grep '^DEFAULT_THREADS=' machine.conf 2>/dev/null | cut -d= -f2- | tr -d '" ')
        DEFAULT_CPU_MOE=$(grep '^DEFAULT_CPU_MOE=' machine.conf 2>/dev/null | cut -d= -f2- | tr -d '" ')
        DEFAULT_UB=$(grep '^DEFAULT_MICRO_BATCH=' machine.conf 2>/dev/null | cut -d= -f2- | tr -d '" ')

        if [[ -n "$GPU_NAME" ]] || [[ -n "$GPU_VRAM" ]] || [[ -n "$CPU_CORES" ]]; then
          MACHINE_SPECS="Machine specs (from machine.conf):"
          [[ -n "$GPU_NAME" ]]      && MACHINE_SPECS+="\n  GPU: $GPU_NAME"
          [[ -n "$GPU_VRAM" ]]      && MACHINE_SPECS+=" (VRAM: ${GPU_VRAM}GB)"
          [[ -n "$CPU_CORES" ]]     && MACHINE_SPECS+="\n  CPU: $CPU_CORES cores"
          [[ -n "$CPU_MODEL" ]]     && MACHINE_SPECS+=" ($CPU_MODEL)"
          [[ -n "$DEFAULT_THREADS" ]] && MACHINE_SPECS+="\n  Your default threads: $DEFAULT_THREADS"
          [[ -n "$DEFAULT_CPU_MOE" ]] && MACHINE_SPECS+="  default cpu-moe: $DEFAULT_CPU_MOE"
          [[ -n "$DEFAULT_UB" ]]    && MACHINE_SPECS+="  default micro-batch: $DEFAULT_UB"
        fi
      fi

      echo ">> Sending benchmark results to Ollama ($AI_MODEL)..."

      # Call Ollama's chat API
      # The Ollama service runs inside Docker on port 11434 (internal) or host (localhost:11434)
      # We try localhost first (host port), then Docker internal network
      OLLAMA_URL="http://localhost:11434"

      # Build the system prompt
      SYSTEM_PROMPT='You are a llama.cpp performance tuning expert. Analyze the benchmark results and the machine specs to provide actionable recommendations for optimizing the model server configuration.

You receive:
- Benchmark results: parameter combinations tested with their token-per-second (t/s) throughput
- Machine specs: GPU, VRAM, CPU details

Your analysis should include:
1. OPTIMAL SETTINGS: The single best configuration (threads, cpu-moe, micro-batch, context)
2. REASONING: Why these settings are optimal for this specific hardware
3. TRADE-OFFS: What was sacrificed for this configuration and why
4. VRAM WARNINGS: Any configs that were too aggressive for available VRAM
5. NEXT STEPS: Specific compose.yaml changes to make

Format your response as two clearly separated sections:
## RECOMMENDATION (JSON)
{"threads": N, "n_cpu_moe": N, "micro_batch": N, "context": N, "gpu_layers": N, "reasoning": "brief", "confidence": "high|medium|low"}

## ANALYSIS
[Human-readable analysis with detailed reasoning, trade-offs, and next steps]

Be specific and data-driven. Reference actual TPS values from the results.'

      # Try to call Ollama API (host first, then Docker internal)
      AI_RESPONSE=""
      HTTP_CODE=""

      # Build the API request
      OLLAMA_BODY=$(cat <<EOF
{
  "model": "$AI_MODEL",
  "messages": [
    {
      "role": "system",
      "content": "$SYSTEM_PROMPT"
    },
    {
      "role": "user",
      "content": "Benchmark results:\n$(echo "$BENCH_JSON" | sed 's/"/\\"/g')\n\n$MACHINE_SPECS"
    }
  ],
  "stream": false
}
EOF
)

      # Try host Ollama first
      HTTP_CODE=$(curl -sf -m 30 -X POST "$OLLAMA_URL/api/chat" \
        -H "Content-Type: application/json" \
        -d "$OLLAMA_BODY" \
        -w "%{http_code}" \
        -o /tmp/ollama-response.json 2>/dev/null) || true

      # If host fails, try Docker internal network
      if [[ "$HTTP_CODE" != "200" ]]; then
        echo ">> Ollama not on localhost, trying Docker internal network..."
        OLLAMA_URL="http://ollama:11434"
        HTTP_CODE=$(curl -sf -m 30 -X POST "$OLLAMA_URL/api/chat" \
          -H "Content-Type: application/json" \
          -d "$OLLAMA_BODY" \
          -w "%{http_code}" \
          -o /tmp/ollama-response.json 2>/dev/null) || true
      fi

      if [[ "$HTTP_CODE" == "200" ]] && [[ -s /tmp/ollama-response.json ]]; then
        # Extract the message content from the response
        AI_CONTENT=$(jq -r '.message.content // empty' /tmp/ollama-response.json 2>/dev/null || \
                     grep -oP '"content":"\K[^"]+' /tmp/ollama-response.json 2>/dev/null || \
                     grep -oP '"content":\s*"\K.*' /tmp/ollama-response.json 2>/dev/null)

        if [[ -n "$AI_CONTENT" ]]; then
          echo ""
          echo "$AI_CONTENT"
          echo ""
        else
          echo ">> WARNING: Ollama responded but content was unexpected format." >&2
          echo "   Raw response:" >&2
          cat /tmp/ollama-response.json >&2
        fi
      else
        echo ">> WARNING: Could not reach Ollama at $OLLAMA_URL (HTTP $HTTP_CODE)" >&2
        echo "" >&2
        echo ">> Manual analysis options:" >&2
        echo "   1. Start Ollama and try again:  ./lab start ollama" >&2
        echo "   2. Load a model first:          ./lab exec agent ollama run qwen2.5:1.5b" >&2
        echo "   3. Analyze manually with:" >&2
        echo "      cat results.json | python3 -c \"\nimport sys, json; print(json.dumps(json.load(sys.stdin), indent=2))\"" >&2
      fi

      # Clean up
      rm -f /tmp/ollama-response.json
      ;;
    exec)
      check_workspace "${2:?Usage: ./lab exec <path> '<command>'}"
      confirm
      # On exec, pass egress status via env so compose knows how to route
      LITTLE_MESTER_EGRESS="$EGRESS" dc run --rm -T agent sh -c "${3:?Missing command}"
      ;;
    shell)
      check_workspace "${2:?Usage: ./lab shell [--ro|--rw] <path>}"
      confirm
      dc run --rm agent bash
      warn_hooks
      ;;
# --help shortcut (prints help text and exits)
    -h|--help)
      echo "Usage:"
      echo "  ./lab [flags] <path-to-workspace> [agent args]"
      echo "  ./lab [flags] shell <path-to-workspace>"
      echo "  ./lab exec <path-to-workspace> '<command>'"
      echo "  ./lab setup | build | pull | stop | bench [--json] [-n N]"
      echo "  ./lab restart-llama [--cache] | tune [--analyse] | ai-analyze [OPTIONS]"
      echo
      echo "Flags (before path):"
      echo "  --ro / --rw        Mount mode (default: rw)"
      echo "  --agent name       Agent to launch (opencode|aider, default: opencode)"
      echo "  --workflow name    Workflow profile (default: default)"
      echo "  --verbose          Show verbose logging in stderr"
      echo "  --egress true|false Override egress default (default: true)"
      echo "  --egress-false     Short alias for --egress false / --isolated"
      echo "  --egress-true      Short alias for --egress true"
      echo "  --isolated         Same as --egress-false"
      echo "  --permissions P    Per-run permission mode (deny/ask/auto, default: from config)"
      echo "  --no-cache         Disable Docker build cache (for setup/build)"
      ;;

    # No subcommand or workspace path given. When --unsafe-recurse was set, mount the
    # current directory as the workspace (the primary use-case for this flag).
    "")
      if [[ "${UNSAFE_RECURSE:-0}" == "1" ]]; then
        check_workspace "."
        if [[ "$EGRESS" == "true" ]]; then
          if ! check_egress_permission; then
            die "Egress denied: agent is not permitted to access the internet in this workspace"
          fi
        fi
        confirm
        dc run --rm agent "$AGENT"
        warn_hooks
      else
        # No subcommand, no path → show help.
        echo "Usage:"
        echo "  ./lab [flags] <path-to-workspace> [agent args]"
        echo "  ./lab [flags] shell <path-to-workspace>"
        echo "  ./lab exec <path-to-workspace> '<command>'"
        echo "  ./lab setup | build | pull | stop | bench | restart-llama | tune | ai-analyze"
        echo
        echo "Flags (before path):"
        echo "  --ro / --rw        Mount mode (default: rw)"
        echo "  --agent name       Agent to launch (opencode|aider, default: opencode)"
        echo "  --workflow name    Workflow profile (default: default)"
        echo "  --verbose          Show verbose logging in stderr"
        echo "  --egress true|false Override egress default (default: true)"
        echo "  --egress-false     Short alias for --egress false / --isolated"
        echo "  --egress-true      Short alias for --egress true"
        echo "  --isolated         Same as --egress-false"
        echo "  --permissions P    Per-run permission mode (deny/ask/auto, default: from config)"
        echo
        echo "Any remaining arguments after the path are passed to the agent."
      fi
      ;;
    *)
      case "$AGENT" in
        aider|opencode) ;;
        *) die "unknown agent: $AGENT (expected aider or opencode)" ;;
      esac
      check_workspace "$1"

      # Per-call egress authorization gate before confirming
      if [[ "$EGRESS" == "true" ]]; then
        if ! check_egress_permission; then
          die "Egress denied: agent is not permitted to access the internet in this workspace"
        fi
      fi

      confirm
      shift
      dc run --rm agent "$AGENT" "$@"
      warn_hooks
      ;;
  esac
fi
