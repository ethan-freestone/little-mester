#!/usr/bin/env bash
set -euo pipefail

LAB_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
LAB_UID="$(id -u)"
LAB_GID="$(id -g)"
WORKSPACE=""
MOUNT_MODE="rw"  # Default mount mode
WORKFLOW=""      # Default workflow (default, tdd, regression)
VERBOSE=0        # Enable verbose logging
PERMISSIONS=""    # Optional: per-run permission override (deny|ask|auto)
AGENT="opencode"    # Which agent to launch: opencode | aider (fallback)

# Network mode: egress=true by default; --isolated flips to false
EGRESS="${EGRESS:-true}"

# Self-edit guard toggle (default: deny)
UNSAFE_RECURSE=0

# Docker build cache (default: use cache)
NO_CACHE=0

# ─── Log rotation (last 5 runs) ──────────────────────────────────────
LOG_FILE=""
rotate_logs() {
  local log_dir="$LAB_DIR/.mester/logs"
  mkdir -p "$log_dir"
  local ts
  ts=$(date '+%Y%m%d_%H%M%S')
  LOG_FILE="$log_dir/lab_${ts}.log"
  local count
  count=$(ls "$log_dir"/lab_*.log 2>/dev/null | wc -l)
  if [[ $count -gt 5 ]]; then
    ls -1t "$log_dir"/lab_*.log | tail -n $((count - 5)) | xargs rm -f
  fi
}

# Load user config if present (gitignored; put your real identity here)
if [[ -f "$LAB_DIR/.little-mester.conf" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$LAB_DIR/.little-mester.conf"
  set +a
fi

# Neutral default git identity for agent commits
GIT_AUTHOR_NAME="${GIT_AUTHOR_NAME:-little-mester-agent}"
GIT_AUTHOR_EMAIL="${GIT_AUTHOR_EMAIL:-agent@localhost}"
GIT_COMMITTER_NAME="${GIT_COMMITTER_NAME:-little-mester-agent}"
GIT_COMMITTER_EMAIL="${GIT_COMMITTER_EMAIL:-agent@localhost}"

die() { echo "REFUSED: $*" >&2; exit 1; }

dc() {
  local networks="[egress, internal]"
  if [[ "$EGRESS" != "true" ]]; then
    networks="[internal]"
  fi

  env "WORKSPACE=${WORKSPACE:-$LAB_DIR}" \
        "LAB_UID=$LAB_UID" \
        "LAB_GID=$LAB_GID" \
        "MOUNT_MODE=$MOUNT_MODE" \
        "LITTLE_MESTER_WORKFLOW=${WORKFLOW:-default}" \
        "LITTLE_MESTER_VERBOSE=$VERBOSE" \
        "LITTLE_MESTER_EGRESS=${EGRESS}" \
        "LITTLE_MESTER_PERMISSIONS=${PERMISSIONS:-}" \
        "NETWORKS=${networks}" \
        "GIT_AUTHOR_NAME=$GIT_AUTHOR_NAME" \
        "GIT_AUTHOR_EMAIL=$GIT_AUTHOR_EMAIL" \
        "GIT_COMMITTER_NAME=$GIT_COMMITTER_NAME" \
        "GIT_COMMITTER_EMAIL=$GIT_COMMITTER_EMAIL" \
      docker compose -f "$LAB_DIR/compose.yaml" --project-directory "$LAB_DIR" "$@"
}

update_opencode_permissions() {
  # Dynamically set opencode permission mode based on PERMISSIONS variable.
  # The baked-in opencode.json always has "ask" — we override it per-run.
  local cfg="$LAB_DIR/agent/opencode/opencode.json"

  if [[ ! -f "$cfg" ]]; then
    echo "WARNING: opencode.json not found at $cfg, skipping permission override" >&2
    return
  fi

  local mode="${PERMISSIONS:-ask}"
  [[ -z "$mode" ]] && mode="ask"

  local key old_val
  if [[ "$mode" == "auto" ]]; then
    key='auto'
  elif [[ "$mode" == "deny" ]]; then
    key='deny'
  else
    key='ask'
  fi

  # Apply permission overrides for edit and bash tools
  sed -i "s/\"edit\": *\"ask\"/\"edit\": \"${key}\"/" "$cfg"
  sed -i "s/\"bash\": *\"ask\"/\"bash\": \"${key}\"/" "$cfg"

  if [[ "$mode" != "ask" ]]; then
    echo ">> Permissions set to: ${key} (edit + bash)"
  fi
}

restore_opencode_permissions() {
  local cfg="$LAB_DIR/agent/opencode/opencode.json"
  if [[ -f "$cfg" ]] && [[ "${PERMISSIONS:-ask}" != "ask" ]]; then
    sed -i 's/"edit": *"[^"]*"/"edit": "ask"/' "$cfg"
    sed -i 's/"bash": *"[^"]*"/"bash": "ask"/' "$cfg"
    echo ">> Restored opencode.json permissions to default (ask)"
  fi
}

agent_run() {
  # When PERMISSIONS is set and running opencode, dynamically override
  # opencode.json permission settings before the agent starts.
  # For aider, we skip the config change (aider has its own permission model).
  if [[ "$AGENT" == "opencode" && -n "${PERMISSIONS:-}" && "${PERMISSIONS}" != "ask" ]]; then
    update_opencode_permissions
  fi
  dc run --rm agent "$AGENT" "$@"

  # Restore permissions after agent finishes (if we changed them)
  if [[ "$AGENT" == "opencode" && -n "${PERMISSIONS:-}" && "${PERMISSIONS}" != "ask" ]]; then
    restore_opencode_permissions
  fi
}

check_workspace() {
  local ws="$1"
  [[ -d "$ws" ]] || die "Not a directory: $ws"
  ws="$(realpath "$ws")"

  # System & Root folder protections
  [[ "$ws" != "/" ]] || die "Cannot mount filesystem root (/)"
  [[ "$ws" != "$HOME" ]] || die "Cannot mount entire home directory ($HOME)"

  # Ensure target is owned by current user
  [[ -O "$ws" ]] || die "Workspace directory must be owned by you (UID $LAB_UID)"

  # Prevent exposing the lab repo itself
  if [[ "$ws" == "$LAB_DIR" || "$LAB_DIR" == "$ws"/* ]]; then
    if [[ "${UNSAFE_RECURSE:-0}" != "1" ]]; then
      die "Workspace path would expose the little-mester repo itself. Use --unsafe-recurse to override (requires awareness of the risks)."
    fi
  fi

  # Blacklist sensitive credential/config paths
  local sensitive_paths=(
    "$HOME/.ssh"
    "$HOME/.gnupg"
    "$HOME/.config"
    "$HOME/.aws"
    "$HOME/.kube"
    "$HOME/.local"
    "$HOME/.bashrc"
    "$HOME/.zshrc"
  )

  for s in "${sensitive_paths[@]}"; do
    if [[ "$ws" == "$s" || "$ws" == "$s"/* || "$s" == "$ws"/* ]]; then
      die "Path overlaps with sensitive system/credential directory: $s"
    fi
  done

  WORKSPACE="$ws"
}

# check_egress_permission: per-call authorization gate for egress access
# Before granting internet, checks .mester-egress manifest in workspace.
# Format of .mester-egress (if present):
#   permission=true     | explicit default: allow
#   permission=false    | explicit deny overrides egress=false default
#   allowed_domains=... | comma-separated list; blank means "all domains"
#   intent=<brief>      | human-readable description of intended use
# Returns 0 if access is granted, non-zero otherwise.
check_egress_permission() {
  local manifest="$WORKSPACE/.mester-egress"

  # No manifest = egress defaults to the configured EGRESS variable (true)
  if [[ ! -f "$manifest" ]]; then
    if [[ "$EGRESS" != "true" ]]; then
      return 0  # user said --isolated / egress=false, no need for permission check
    fi
    print_verbose "No .mester-egress manifest found; egress defaults to $EGRESS"
    return 0
  fi

  # Read manifest values (supports inline comments with #)
  local perm domains intent
  # shellcheck disable=SC2034
  while IFS='=' read -r key value; do
    # Strip leading/trailing whitespace and comments
    key="$(echo "$key" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^#' || true)"
    [[ -z "$key" ]] && continue
    value="$(echo "$value" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^#' || true)"

    case "$key" in
      permission*) perm="$value" ;;
      allowed_domains*) domains="$value" ;;
      intent*) intent="$value" ;;
    esac
  done < "$manifest"

  # Check explicit deny — overrides everything
  if [[ "${perm:-}" == "false" ]]; then
    print_verbose "Egress denied by .mester-egress (permission=false)"
    return 1
  fi

  # If user explicitly requested --isolated, respect that regardless of manifest
  if [[ "$EGRESS" != "true" ]]; then
    print_verbose "Egress disabled via environment or flag (--isolated)"
    return 0
  fi

  # Default when permission is true or unset and EGRESS=true: allow
  print_verbose "Egress granted by .mester-egress (permission=${perm:-default(true)})"
  return 0
}

confirm() {
  [[ "${LAB_YES:-}" == "1" ]] && return 0
  [[ "${PERMISSIONS:-}" == "auto" ]] && return 0
  local perm="${PERMISSIONS:-default}"
  echo "--------------------------------------------------------"
  echo " Mounting path : $WORKSPACE"
  echo " Mount mode    : READ-${MOUNT_MODE^^}"
  echo " Egress        : ${EGRESS}"
  echo " Agent         : $AGENT"
  echo " Workflow      : ${WORKFLOW:-default}"
  echo " Verbose       : $VERBOSE"
  echo " Permissions   : $perm"
  echo " Unsaferecurse : ${UNSAFE_RECURSE:-0}"
  echo "--------------------------------------------------------"
  read -r -p "Continue? [y/N] " a
  [[ "$a" == "y" || "$a" == "Y" ]] || exit 1
}

print_verbose() {
  if [[ "$VERBOSE" == "1" ]]; then
    echo "[verbose] $*" >&2
  fi
}

warn_hooks() {
  local h
  h="$(find "$WORKSPACE" -path '*/.git/hooks/*' -type f ! -name '*.sample' 2>/dev/null || true)"
  if [[ -n "$h" ]]; then
    echo "WARNING: Non-sample git hooks found inside workspace:"
    echo "$h"
    echo "Note: Git hooks created or modified by the agent will execute on YOUR HOST if triggered!"
  fi
}

# Parse flags (they must come BEFORE the subcommand or workspace path)
# shellcheck disable=SC2034
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  # Log rotation + tee (last 5 runs, gitignored in .mester/logs/)
  rotate_logs
  exec 1> >(tee -a "$LOG_FILE")
  exec 2> >(tee -a "$LOG_FILE" >&2)
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --ro) MOUNT_MODE="ro"; shift ;;
      --rw) MOUNT_MODE="rw"; shift ;;
      --workflow) WORKFLOW="${2:-default}"; shift 2 ;;
      --verbose) VERBOSE=1; shift ;;
      --agent) AGENT="${2:?--agent needs a name (aider|opencode)}"; shift 2 ;;
      --egress) EGRESS="${2:?--egress needs true/false}"; shift 2 ;;
      --egress-false|--isolated) EGRESS="false"; shift ;;
      --egress-true) EGRESS="true"; shift ;;
      --permissions) PERMISSIONS="${2:?--permissions needs deny/ask/auto}"; shift 2 ;;
      -y|--yes|--auto-accept) PERMISSIONS="auto"; LAB_YES=1; shift ;;
      --unsafe-recurse) UNSAFE_RECURSE=1; shift ;;
      --no-cache) NO_CACHE=1; shift ;;
      --opencode) AGENT="opencode"; shift ;;
      --aider) AGENT="aider"; shift ;;
      *) break ;;
    esac
  done

  case "${1:-}" in
    setup)
      command -v pacman >/dev/null || die "automated setup is Arch/CachyOS only; see docs/01-host-setup.md"
      nvidia-smi -L || die "NVIDIA driver not working on host (fix this first)"
      sudo pacman -S --needed docker docker-compose docker-buildx nvidia-container-toolkit
      sudo systemctl enable --now docker
      sudo nvidia-ctk runtime configure --runtime=docker
      sudo systemctl restart docker
      sudo docker run --rm --gpus all ubuntu:24.04 nvidia-smi -L
      # Build with optional --no-cache
      if [[ "$NO_CACHE" -eq 1 ]]; then
        dc build --no-cache agent metrics
      else
        dc build agent metrics
      fi
      ( cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && ./scripts/regen-configs ) 2>&1
      echo ">> Pulling Ollama models..."
      dc --profile setup run --rm ollama-pull
      echo ">> Pulling llama.cpp GGUF models..."
      dc --profile setup run --rm llamacpp-pull
      echo "Setup complete. Next: ./verify-lab.sh, then ./lab <workspace>"
      ;;
    build)
      shift
      # Regenerate opencode.json from models.txt before building the image
      ( cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/scripts" && ./regen-configs ) 2>&1
      if [[ "$NO_CACHE" -eq 1 ]]; then
        dc build --no-cache "$@" agent metrics
      else
        dc build "$@" agent metrics
      fi
      ;;
    pull)
      ( cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/scripts" && ./regen-configs ) 2>&1
      echo ">> Pulling Ollama models..."
      dc --profile setup run --rm ollama-pull
      echo ">> Pulling llama.cpp GGUF models..."
      dc --profile setup run --rm llamacpp-pull
      ;;
    stop)
      dc down
      ;;
    bench)
      # Benchmark runner — two modes:
      #   HTTP mode (default): connects to running llamacpp, measures real throughput/latency
      #   Native mode (--native): runs llama.cpp --test inside container, instant between-test switches
      shift
      MODE="http"
      BENCH_JSON=0 BENCH_N=5
      # Native-mode params (passed via env to bench service)
      NATIVE_THREADS="" NATIVE_UB="" NATIVE_MOE="" NATIVE_CTX="" NATIVE_JSON=""

      while [[ $# -gt 0 ]]; do
        case "$1" in
          --native)   MODE="native"; shift ;;
          --json)     BENCH_JSON=1; NATIVE_JSON=1; shift ;;
          -n|--repeats) BENCH_N="${2:?-n needs a count}"; shift 2 ;;
          -t|--threads) NATIVE_THREADS="${2:?-t needs a value}"; shift 2 ;;
          -ub|--micro-batch) NATIVE_UB="${2:?-ub needs a value}"; shift 2 ;;
          --moe|--n-cpu-moe) NATIVE_MOE="${2:?--n-cpu-moe needs a value}"; shift 2 ;;
          --ctx|--context) NATIVE_CTX="${2:?--context needs a value}"; shift 2 ;;
          --help|-h)
            cat <<'HELPTEXT'
Usage: ./lab bench [OPTIONS]

Benchmark the currently-running model server.

HTTP mode (default, no GPU needed):
  ./lab bench                  Measure throughput/latency against running server
  ./lab bench --json           Machine-readable JSON output
  ./lab bench -n 10            10 repeats per config (default: 5)

Native mode (requires GPU — runs llama.cpp --test inside container):
  ./lab bench --native         Benchmark with current llamacpp config
  ./lab bench --native -t 10   Test with 10 threads
  ./lab bench --native -ub 1024
  ./lab bench --native --json  JSON output

  --native              Run llama.cpp --test inside container (zero HTTP overhead)
  --json                Output structured JSON (parsable by AI for recommendations)
  -n N                  Repeats per config (default: 5)
  -t N                  Thread count (native mode only)
  -ub N                 Micro-batch size (native mode only)
  --n-cpu-moe N         CPU MoE experts (native mode only)
  --context N           Context window (native mode only)
  --help                Show this help

Workflow:
  1. ./lab bench              → baseline measurement (HTTP mode, safe anytime)
  2. Edit compose.yaml llamacpp command, then:
     ./lab restart-llama      → restart with new params, benchmark:
     ./lab bench --native     → fast in-container benchmark
  3. ./lab bench --json       → pipe to AI for parameter recommendations

For full tuning sweep:
  ./lab tune                 → cycle through configs, produce comparison table
HELPTEXT
            exit 0
            ;;
          *) echo "Unknown bench flag: $1" >&2; exit 1 ;;
        esac
      done

      if [[ "$MODE" == "native" ]]; then
        # ── Native mode: build bench service (with GPU + model volume) ──────
        echo ">> Building bench image for native mode${NO_CACHE:+ (no cache)}..."
        if [[ "$NO_CACHE" -eq 1 ]]; then
          dc --profile bench build --no-cache bench
        else
          dc --profile bench build bench
        fi

        # Set native params from CLI args or fall back to compose defaults
        local_env=""
        local_env+="MODEL_DIR=/models "
        local_env+="BENCH_JSON=$NATIVE_JSON "
        local_env+="BENCH_N=$BENCH_N "
        [[ -n "$NATIVE_THREADS" ]] && local_env+="THREADS=$NATIVE_THREADS "
        [[ -n "$NATIVE_UB" ]]        && local_env+="MICRO_BATCH=$NATIVE_UB "
        [[ -n "$NATIVE_MOE" ]]       && local_env+="NCPU_MOE=$NATIVE_MOE "
        [[ -n "$NATIVE_CTX" ]]       && local_env+="CONTEXT=$NATIVE_CTX "

        echo ">> Running native benchmark (zero HTTP overhead)..."
        env "$local_env" dc run --rm bench
      else
        # ── HTTP mode: lightweight container, no GPU ───────────────────────
        echo ">> Building bench image (cached)${NO_CACHE:+ (no cache)}..."
        if [[ "$NO_CACHE" -eq 1 ]]; then
          dc build --no-cache bench
        else
          dc build bench
        fi

        # Wait for llamacpp to be healthy
        echo ">> Waiting for llamacpp server..."
        for i in $(seq 1 30); do
          if dc exec llamacpp curl -sf -m 3 http://127.0.0.1:11434/health >/dev/null 2>&1; then
            break
          fi
          [[ $i -eq 30 ]] && { echo ">> ERROR: llamacpp not healthy after 30s" >&2; exit 1; }
          sleep 1
        done

        echo ">> Running benchmark (${BENCH_N} repeats each)..."
        BENCH_JSON="$BENCH_JSON" BENCH_N="$BENCH_N" dc run --rm bench
      fi
      ;;
    restart-llama)
      # Restart llama.cpp server with new parameters from compose.yaml.
      #
      # Workflow:
      #   1. Edit compose.yaml → llamacpp command line (-t N, --n-cpu-moe N, etc.)
      #   2. ./lab restart-llama          (~20s to reload model from cached layer)
      #   3. ./lab bench --native         (fast in-container benchmark)
      #
      # KV cache persistence: --cache flag keeps model in VRAM between
      # restarts, reducing reload to ~2-3s.
      shift
      CACHE_FLAG=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --cache) CACHE_FLAG="--cache"; shift ;;
          --help|-h)
            cat <<'HELPTEXT'
Usage: ./lab restart-llama [OPTIONS]

Restart the llama.cpp model server with parameters from compose.yaml.

This is the fast way to test parameter changes:
  1. Edit compose.yaml → llamacpp service command line
  2. ./lab restart-llama           (~20s to reload model from cached layer)
  3. ./lab bench --native          (benchmark the new config)

Options:
  --cache    Enable KV cache persistence (reduces reload to ~2-3s)
             Only use if the model file and architecture haven't changed.
             Without --cache, the model is fully reloaded from disk each time.

When to use:
  - You changed -t, --n-cpu-moe, -ub, -c or similar runtime params
  - The model file (GGUF) is the same
  - You want to iterate fast between test runs

When NOT to use:
  - You changed the model file (different GGUF)
  - You want a clean slate
  - You need --no-cache rebuild for other reasons
HELPTEXT
            exit 0
            ;;
          *) echo "Unknown restart-llama flag: $1" >&2; exit 1 ;;
        esac
      done

      # If --cache was requested, inject --cache into the llamacpp command
      if [[ -n "$CACHE_FLAG" ]]; then
        echo ">> Adding --cache flag for KV persistence..."
        if ! grep -q '\-\-cache' compose.yaml; then
          sed -i '/^      --parallel 1 --jinja$/a\      --cache' compose.yaml
          echo "   Added --cache to compose.yaml llamacpp command"
          echo "   Remove it manually when you change the model file."
        fi
      fi

      echo ">> Restarting llama.cpp server..."
      dc restart llamacpp || dc up -d llamacpp
      ;;
    tune)
      shift
      exec env VERBOSE="$VERBOSE" "$LAB_DIR/bench/tune.sh" "$@"
      ;;
    ai-analyze)
      shift
      exec env VERBOSE="$VERBOSE" "$LAB_DIR/bench/ai-analyze.sh" "$@"
      ;;
    exec)
      check_workspace "${2:?Usage: ./lab exec <path> '<command>'}"
      confirm
      # On exec, pass egress status via env so compose knows how to route
      LITTLE_MESTER_EGRESS="$EGRESS" dc run --rm -T agent sh -c "${3:?Missing command}"
      ;;
    shell)
      check_workspace "${2:?Usage: ./lab shell [--ro|--rw] <path>}"
      confirm
      dc run --rm agent bash
      warn_hooks
      ;;
# --help shortcut (prints help text and exits)
    -h|--help)
      echo "Usage:"
      echo "  ./lab [flags] <path-to-workspace> [agent args]"
      echo "  ./lab [flags] shell <path-to-workspace>"
      echo "  ./lab exec <path-to-workspace> '<command>'"
      echo "  ./lab setup | build | pull | stop | bench [--json] [-n N]"
      echo "  ./lab restart-llama [--cache] | tune [--analyse] | ai-analyze [OPTIONS]"
      echo
      echo "Flags (before path):"
      echo "  --ro / --rw        Mount mode (default: rw)"
      echo "  --agent name       Agent to launch (opencode|aider, default: opencode)"
      echo "  --workflow name    Workflow profile (default: default)"
      echo "  --verbose          Show verbose logging in stderr"
      echo "  --egress true|false Override egress default (default: true)"
      echo "  --egress-false     Short alias for --egress false / --isolated"
      echo "  --egress-true      Short alias for --egress true"
      echo "  --isolated         Same as --egress-false"
      echo "  --auto-accept      Shorthand for --permissions auto (all tools auto-approved)"
      echo "  --permissions P    Per-run permission mode (deny/ask/auto, default: from config)"
      echo "  --no-cache         Disable Docker build cache (for setup/build)"
      ;;

    # No subcommand or workspace path given. When --unsafe-recurse was set, mount the
    # current directory as the workspace (the primary use-case for this flag).
    "")
      if [[ "${UNSAFE_RECURSE:-0}" == "1" ]]; then
        check_workspace "."
        if [[ "$EGRESS" == "true" ]]; then
          if ! check_egress_permission; then
            die "Egress denied: agent is not permitted to access the internet in this workspace"
          fi
        fi
        confirm
        agent_run
        warn_hooks
      else
        # No subcommand, no path → show help.
        echo "Usage:"
        echo "  ./lab [flags] <path-to-workspace> [agent args]"
        echo "  ./lab [flags] shell <path-to-workspace>"
        echo "  ./lab exec <path-to-workspace> '<command>'"
        echo "  ./lab setup | build | pull | stop | bench | restart-llama | tune | ai-analyze"
        echo
        echo "Flags (before path):"
        echo "  --ro / --rw        Mount mode (default: rw)"
        echo "  --agent name       Agent to launch (opencode|aider, default: opencode)"
        echo "  --workflow name    Workflow profile (default: default)"
        echo "  --verbose          Show verbose logging in stderr"
        echo "  --egress true|false Override egress default (default: true)"
        echo "  --egress-false     Short alias for --egress false / --isolated"
        echo "  --egress-true      Short alias for --egress true"
        echo "  --isolated         Same as --egress-false"
        echo "  --auto-accept      Shorthand for --permissions auto (all tools auto-approved)"
        echo "  --permissions P    Per-run permission mode (deny/ask/auto, default: from config)"
        echo
        echo "Any remaining arguments after the path are passed to the agent."
      fi
      ;;
    *)
      case "$AGENT" in
        aider|opencode) ;;
        *) die "unknown agent: $AGENT (expected aider or opencode)" ;;
      esac
      check_workspace "$1"

      # Per-call egress authorization gate before confirming
      if [[ "$EGRESS" == "true" ]]; then
        if ! check_egress_permission; then
          die "Egress denied: agent is not permitted to access the internet in this workspace"
        fi
      fi

      confirm
      shift
      agent_run "$@"
      warn_hooks
      ;;
  esac
fi
