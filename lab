#!/usr/bin/env bash
set -euo pipefail

LAB_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"

# Keep the existing helper functions available to tests and legacy callers that
# source ./lab. Executed calls are dispatched below without evaluating Docker.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  # shellcheck source=lab-docker
  source "$LAB_DIR/lab-docker"
  return 0
fi

if [[ "${1:-}" == vm ]]; then
  shift
  exec "$LAB_DIR/lab-vm" "$@"
fi

# This transition-stage dispatcher deliberately keeps the current Docker route
# until C14's reviewed acceptance and separately authorized VM-default cutover.
exec "$LAB_DIR/lab-docker" "$@"
