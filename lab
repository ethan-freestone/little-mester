#!/usr/bin/env bash
set -euo pipefail

LAB_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
LAB_UID="$(id -u)"
LAB_GID="$(id -g)"
WORKSPACE=""
MOUNT_MODE="rw"  # Default mount mode
WORKFLOW=""      # Default workflow (default, tdd, regression)
VERBOSE=0        # Enable verbose logging
AGENT="aider"    # Which agent to launch: aider | opencode

# Network mode: egress=true by default; --isolated flips to false
EGRESS="${EGRESS:-true}"

# Load user config if present (gitignored; put your real identity here)
if [[ -f "$LAB_DIR/.little-mester.conf" ]]; then
  set -a
  source "$LAB_DIR/.little-mester.conf"
  set +a
fi

# Neutral default git identity for agent commits
GIT_AUTHOR_NAME="${GIT_AUTHOR_NAME:-little-mester-agent}"
GIT_AUTHOR_EMAIL="${GIT_AUTHOR_EMAIL:-agent@localhost}"
GIT_COMMITTER_NAME="${GIT_COMMITTER_NAME:-little-mester-agent}"
GIT_COMMITTER_EMAIL="${GIT_COMMITTER_EMAIL:-agent@localhost}"

die() { echo "REFUSED: $*" >&2; exit 1; }

dc() {
  local networks="[egress, internal]"
  if [[ "$EGRESS" != "true" ]]; then
    networks="[internal]"
  fi

  sudo env "WORKSPACE=${WORKSPACE:-$LAB_DIR}" \
             "LAB_UID=$LAB_UID" \
             "LAB_GID=$LAB_GID" \
             "MOUNT_MODE=$MOUNT_MODE" \
             "LITTLE_MESTER_WORKFLOW=${WORKFLOW:-default}" \
             "LITTLE_MESTER_VERBOSE=$VERBOSE" \
             "LITTLE_MESTER_EGRESS=${EGRESS}" \
             "NETWORKS=${networks}" \
             "GIT_AUTHOR_NAME=$GIT_AUTHOR_NAME" \
             "GIT_AUTHOR_EMAIL=$GIT_AUTHOR_EMAIL" \
             "GIT_COMMITTER_NAME=$GIT_COMMITTER_NAME" \
             "GIT_COMMITTER_EMAIL=$GIT_COMMITTER_EMAIL" \
      docker compose -f "$LAB_DIR/compose.yaml" --project-directory "$LAB_DIR" "$@"
}

check_workspace() {
  local ws="$1"
  [[ -d "$ws" ]] || die "Not a directory: $ws"
  ws="$(realpath "$ws")"

  # System & Root folder protections
  [[ "$ws" != "/" ]] || die "Cannot mount filesystem root (/)"
  [[ "$ws" != "$HOME" ]] || die "Cannot mount entire home directory ($HOME)"

  # Ensure target is owned by current user
  [[ -O "$ws" ]] || die "Workspace directory must be owned by you (UID $LAB_UID)"

  # Prevent exposing the lab repo itself
  if [[ "$ws" == "$LAB_DIR" || "$LAB_DIR" == "$ws"/* ]]; then
    die "Workspace path would expose the little-mester repo itself"
  fi

  # Blacklist sensitive credential/config paths
  local sensitive_paths=(
    "$HOME/.ssh"
    "$HOME/.gnupg"
    "$HOME/.config"
    "$HOME/.aws"
    "$HOME/.kube"
    "$HOME/.local"
    "$HOME/.bashrc"
    "$HOME/.zshrc"
  )

  for s in "${sensitive_paths[@]}"; do
    if [[ "$ws" == "$s" || "$ws" == "$s"/* || "$s" == "$ws"/* ]]; then
      die "Path overlaps with sensitive system/credential directory: $s"
    fi
  done

  WORKSPACE="$ws"
}

# check_egress_permission: per-call authorization gate for egress access
# Before granting internet, checks .mester-egress manifest in workspace.
# Format of .mester-egress (if present):
#   permission=true     | explicit default: allow
#   permission=false    | explicit deny overrides egress=false default
#   allowed_domains=... | comma-separated list; blank means "all domains"
#   intent=<brief>      | human-readable description of intended use
# Returns 0 if access is granted, non-zero otherwise.
check_egress_permission() {
  local manifest="$WORKSPACE/.mester-egress"

  # No manifest = egress defaults to the configured EGRESS variable (true)
  if [[ ! -f "$manifest" ]]; then
    if [[ "$EGRESS" != "true" ]]; then
      return 0  # user said --isolated / egress=false, no need for permission check
    fi
    print_verbose "No .mester-egress manifest found; egress defaults to $EGRESS"
    return 0
  fi

  # Read manifest values (supports inline comments with #)
  local perm domains intent
  while IFS='=' read -r key value; do
    # Strip leading/trailing whitespace and comments
    key="$(echo "$key" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^#' || true)"
    [[ -z "$key" ]] && continue
    value="$(echo "$value" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^#' || true)"

    case "$key" in
      permission*) perm="$value" ;;
      allowed_domains*) domains="$value" ;;
      intent*) intent="$value" ;;
    esac
  done < "$manifest"

  # Check explicit deny — overrides everything
  if [[ "${perm:-}" == "false" ]]; then
    print_verbose "Egress denied by .mester-egress (permission=false)"
    return 1
  fi

  # If user explicitly requested --isolated, respect that regardless of manifest
  if [[ "$EGRESS" != "true" ]]; then
    print_verbose "Egress disabled via environment or flag (--isolated)"
    return 0
  fi

  # Default when permission is true or unset and EGRESS=true: allow
  print_verbose "Egress granted by .mester-egress (permission=${perm:-default(true)})"
  return 0
}

confirm() {
  [[ "${LAB_YES:-}" == "1" ]] && return 0
  echo "--------------------------------------------------------"
  echo " Mounting path : $WORKSPACE"
  echo " Mount mode    : READ-${MOUNT_MODE^^}"
  echo " Egress        : ${EGRESS}"
  echo " Agent         : $AGENT"
  echo " Workflow      : ${WORKFLOW:-default}"
  echo " Verbose       : $VERBOSE"
  echo "--------------------------------------------------------"
  read -r -p "Continue? [y/N] " a
  [[ "$a" == "y" || "$a" == "Y" ]] || exit 1
}

print_verbose() {
  [[ "$VERBOSE" == "1" ]] && echo "[verbose] $*" >&2 || true
}

warn_hooks() {
  local h
  h="$(find "$WORKSPACE" -path '*/.git/hooks/*' -type f ! -name '*.sample' 2>/dev/null || true)"
  if [[ -n "$h" ]]; then
    echo "WARNING: Non-sample git hooks found inside workspace:"
    echo "$h"
    echo "Note: Git hooks created or modified by the agent will execute on YOUR HOST if triggered!"
  fi
}

# Parse flags (they must come BEFORE the subcommand or workspace path)
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --ro) MOUNT_MODE="ro"; shift ;;
      --rw) MOUNT_MODE="rw"; shift ;;
      --workflow) WORKFLOW="${2:-default}"; shift 2 ;;
      --verbose) VERBOSE=1; shift ;;
      --agent) AGENT="${2:?--agent needs a name (aider|opencode)}"; shift 2 ;;
      --egress) EGRESS="${2:?--egress needs true/false}"; shift 2 ;;
      --egress-false|--isolated) EGRESS="false"; shift ;;
      --egress-true) EGRESS="true"; shift ;;
      *) break ;;
    esac
  done

  case "${1:-}" in
    setup)
      command -v pacman >/dev/null || die "automated setup is Arch/CachyOS only; see docs/01-host-setup.md"
      nvidia-smi -L || die "NVIDIA driver not working on host (fix this first)"
      sudo pacman -S --needed docker docker-compose docker-buildx nvidia-container-toolkit
      sudo systemctl enable --now docker
      sudo nvidia-ctk runtime configure --runtime=docker
      sudo systemctl restart docker
      sudo docker run --rm --gpus all ubuntu:24.04 nvidia-smi -L
      dc build agent
      dc --profile setup run --rm ollama-pull
      echo "Setup complete. Next: ./verify-sandbox.sh, then ./lab <workspace>"
      ;;
    build)
      shift
      dc build "$@" agent
      ;;
    pull)
      dc --profile setup run --rm ollama-pull
      ;;
    stop)
      dc down
      ;;
    exec)
      check_workspace "${2:?Usage: ./lab exec <path> '<command>'}"
      confirm
      # On exec, pass egress status via env so compose knows how to route
      LITTLE_MESTER_EGRESS="$EGRESS" dc run --rm -T agent sh -c "${3:?Missing command}"
      ;;
    shell)
      check_workspace "${2:?Usage: ./lab shell [--ro|--rw] <path>}"
      confirm
      dc run --rm agent bash
      warn_hooks
      ;;
    ""|-h|--help)
      echo "Usage:"
      echo "  ./lab [flags] <path-to-workspace> [agent args]"
      echo "  ./lab [flags] shell <path-to-workspace>"
      echo "  ./lab exec <path-to-workspace> '<command>'"
      echo "  ./lab setup | build | pull | stop"
      echo
      echo "Flags (before path):"
      echo "  --ro / --rw        Mount mode (default: rw)"
      echo "  --agent name       Agent to launch (aider|opencode, default: aider)"
      echo "  --workflow name    Workflow profile (default: default)"
      echo "  --verbose          Show verbose logging in stderr"
      echo "  --egress true|false Override egress default (default: true)"
      echo "  --egress-false     Short alias for --egress false / --isolated"
      echo "  --egress-true      Short alias for --egress true"
      echo "  --isolated         Same as --egress-false"
      echo
      echo "Any remaining arguments after the path are passed to the agent."
      ;;
    *)
      case "$AGENT" in
        aider|opencode) ;;
        *) die "unknown agent: $AGENT (expected aider or opencode)" ;;
      esac
      check_workspace "$1"

      # Per-call egress authorization gate before confirming
      if [[ "$EGRESS" == "true" ]]; then
        if ! check_egress_permission; then
          die "Egress denied: agent is not permitted to access the internet in this workspace"
        fi
      fi

      confirm
      shift
      dc run --rm agent "$AGENT" "$@"
      warn_hooks
      ;;
  esac
fi
