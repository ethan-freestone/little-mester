#!/usr/bin/env bash
# Compatibility dispatcher while the VM adoption gates remain open.
# `./lab vm ...` routes to the direct-guest VM CLI; all existing invocations
# continue through the preserved host-Docker workflow until an approved cutover.
set -euo pipefail

LAB_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  if [[ "${1:-}" == vm ]]; then
    shift
    exec "$LAB_DIR/lab-vm" "$@"
  fi
  exec "$LAB_DIR/lab-docker" "$@"
fi

# Keep the Docker helper functions available to existing scripts/tests that
# source ./lab. New code should source lab-docker when it needs these helpers.
# shellcheck source=lab-docker
source "$LAB_DIR/lab-docker"
