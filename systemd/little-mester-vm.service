[Unit]
Description=Little Mester persistent OpenCode VM
Requires=little-mester-vm-proxy.service little-mester-vm-workspace.service little-mester-vm-metrics.service
BindsTo=little-mester-vm-proxy.service little-mester-vm-workspace.service little-mester-vm-metrics.service
After=little-mester-vm-proxy.service little-mester-vm-workspace.service little-mester-vm-metrics.service
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=exec
User=lm-vm
Group=lm-vm
SupplementaryGroups=kvm lm-vm-control
RuntimeDirectory=little-mester-vm
RuntimeDirectoryMode=0700
UMask=0077
ExecStartPre=/usr/bin/python3 -I /usr/lib/little-mester-vm/system-vm.py check
ExecStart=+/usr/bin/python3 -I /usr/lib/little-mester-vm/system-vm.py locked-service qemu
ExecStartPost=/usr/bin/python3 -I /usr/lib/little-mester-vm/system-vm.py guest-ready
ExecStop=/usr/bin/python3 -I /usr/lib/little-mester-vm/system-vm.py qmp-stop $MAINPID
Restart=no
KillMode=control-group
KillSignal=SIGTERM
TimeoutStartSec=16min
TimeoutStopSec=25s
SendSIGKILL=yes
DevicePolicy=closed
DeviceAllow=/dev/kvm rw
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/var/lib/little-mester-vm/seed.iso
ReadWritePaths=/var/lib/little-mester-vm/disk.qcow2 /run/little-mester-vm /etc/little-mester-vm/code-update.lock

[Install]
WantedBy=multi-user.target
