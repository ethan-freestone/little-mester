                       "review the pinned owner bootstrap's production/system-install scopes before retrying")
        # Parse the exact pinned policy before creating accounts, files, or disks.
        subprocess.run(["/usr/sbin/visudo", "-cf", str(root / "sudoers/little-mester-vm")],
                       check=True, stdin=subprocess.DEVNULL)
        preflight(root, owner)
