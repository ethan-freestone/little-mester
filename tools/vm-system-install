                       stdin=subprocess.DEVNULL)
        subprocess.run(["/usr/sbin/visudo", "-cf", "/etc/sudoers.d/little-mester-vm"],
                       check=True, stdin=subprocess.DEVNULL)
        subprocess.run(["/usr/bin/systemctl", "daemon-reload"], check=True,
                       stdin=subprocess.DEVNULL)
