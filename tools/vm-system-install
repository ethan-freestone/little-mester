        # with these exact fixed names are ever created by this explicit tool.
        ensure_group("lm-vm")
        ensure_group("lm-vm-proxy")
        ensure_group("lm-vm-control", allowed_members={owner})
        ensure_user("lm-vm", "lm-vm", "/var/lib/little-mester-vm")
        ensure_user("lm-vm-proxy", "lm-vm-proxy", "/var/empty")
        ensure_dir(pathlib.Path("/usr/lib/little-mester-vm"), group="root", mode=0o755)
        ensure_dir(pathlib.Path("/usr/lib/little-mester-vm/plugins"), group="root", mode=0o755)
        ensure_dir(pathlib.Path("/usr/lib/little-mester-vm/host-metrics-tui"),
                   group="root", mode=0o755)
        ensure_dir(pathlib.Path("/etc/little-mester-vm"), group="lm-vm-control", mode=0o750)
        ensure_dir(pathlib.Path("/etc/systemd/system/little-mester-vm-workspace.service.d"),
                   group="root", mode=0o755)
        ensure_dir(pathlib.Path("/var/lib/little-mester-vm"), group="lm-vm", mode=0o750)
        for relative, (target, mode) in FILES.items():
            install_file(root / relative, pathlib.Path(target), mode,
                         payload=source_payload(root, relative, owner))
