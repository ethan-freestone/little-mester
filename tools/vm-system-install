def refuse(message: str) -> None:
    raise RuntimeError(message)


def source_payload(root: pathlib.Path, relative: str, owner: str) -> bytes:
    payload = (root / relative).read_bytes()
    if relative == "systemd/little-mester-vm-workspace.service":
        owner_marker = b"@LM_VM_OWNER@"
        group_marker = b"@LM_VM_OWNER_GROUP@"
        if payload.count(owner_marker) != 1 or payload.count(group_marker) != 1:
            refuse("workspace unit must contain exactly one owner and primary group identity marker")
        owner_info = pwd.getpwnam(owner)
        owner_group = grp.getgrgid(owner_info.pw_gid).gr_name
        payload = payload.replace(owner_marker, owner.encode("ascii"))
        payload = payload.replace(group_marker, owner_group.encode("ascii"))
    return payload


def source_root() -> pathlib.Path:
    entry = pathlib.Path(__file__).absolute()
    current = pathlib.Path(entry.anchor)
    for component in entry.parts[1:]:
        current /= component
        info = os.lstat(current)
        if stat.S_ISLNK(info.st_mode):
            refuse("installer path contains a symlink")
    root = entry.parent.parent
    if not re.fullmatch(r"[0-9a-f]{40}", root.name) or root.parent.name != "v3":
        refuse("installer must be invoked from a root-protected pinned v3 installation")
    for path in (root, *root.parents):
        info = os.lstat(path)
        if (stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode)
                or info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
            refuse("pinned installer ancestry must be root-owned and not group/world writable")
    return root


def verify_source(root: pathlib.Path) -> None:
    for relative in (*FILES, "tools/vm-system-install"):
        path = root / relative
        for parent in path.parents:
            if parent == root.parent:
                break
            info = os.lstat(parent)
            if (stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode)
                    or info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
                refuse("pinned system VM install source ancestry is not protected")
        info = os.lstat(path)
        if (stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode)
                or info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
            refuse("system VM install source is not a protected regular file")


def ensure_group(name: str, *, allowed_members: set[str] = frozenset()) -> None:
    try:
        existing = grp.getgrnam(name)
    except KeyError:
        subprocess.run(["/usr/sbin/groupadd", "--system", name], check=True,
                       stdin=subprocess.DEVNULL)
    else:
        if existing.gr_gid >= 1000:
            refuse(f"existing {name} group is not in the protected system-group ID range")
        unexpected = set(existing.gr_mem) - allowed_members
        if unexpected:
            refuse(f"existing {name} group has unexpected members; preserving it")


def validate_group(name: str, *, allowed_members: set[str] = frozenset()) -> grp.struct_group | None:
    try:
        existing = grp.getgrnam(name)
    except KeyError:
        return None
    if existing.gr_gid >= 1000:
        refuse(f"existing {name} group is not in the protected system-group ID range")
    unexpected = set(existing.gr_mem) - allowed_members
    if unexpected:
        refuse(f"existing {name} group has unexpected members; preserving it")
    return existing


def ensure_user(name: str, group: str, home: str) -> None:
    try:
        pwd.getpwnam(name)
    except KeyError:
        subprocess.run(["/usr/sbin/useradd", "--system", "--no-create-home", "--home-dir", home,
                        "--shell", "/usr/sbin/nologin", "--gid", group, name], check=True,
                       stdin=subprocess.DEVNULL)
        return
    user = pwd.getpwnam(name)
    expected_group = grp.getgrnam(group).gr_gid
    if (not 1 <= user.pw_uid < 1000 or user.pw_gid != expected_group
            or user.pw_shell != "/usr/sbin/nologin" or user.pw_dir != home):
        refuse(f"existing {name} identity differs from the fixed service identity; preserving it")


def validate_user(name: str, group: str, home: str) -> pwd.struct_passwd | None:
    try:
        user = pwd.getpwnam(name)
    except KeyError:
        return None
    try:
        expected_group = grp.getgrnam(group).gr_gid
    except KeyError as error:
        raise RuntimeError(f"existing {name} account has no matching fixed primary group") from error
    if (not 1 <= user.pw_uid < 1000 or user.pw_gid != expected_group
            or user.pw_shell != "/usr/sbin/nologin" or user.pw_dir != home):
        refuse(f"existing {name} identity differs from the fixed service identity; preserving it")
    return user


def validate_root_directory(path: pathlib.Path) -> os.stat_result:
    current = pathlib.Path(path.anchor)
    info = os.lstat(current)
    if (not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode)
            or info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
        refuse(f"host parent is not a root-controlled directory: {current}")
    for component in path.parts[1:]:
        current /= component
        try:
            info = os.lstat(current)
        except FileNotFoundError as error:
            raise RuntimeError(f"required protected host parent is missing: {current}") from error
        if (stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode)
                or info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
            refuse(f"host parent is not a root-controlled directory: {current}")
    return info


def preflight(root: pathlib.Path, owner: str) -> None:
    """Validate every fixed host target and prior state before the first mutation.

    Any existing provisioning artifact blocks automatic continuation. In
    particular, do not parse or adopt a service-writable disk as root.
    """
    sys.dont_write_bytecode = True
    for raw in PROTECTED_PARENTS:
        validate_root_directory(pathlib.Path(raw))

    for name in ("lm-vm", "lm-vm-proxy", "lm-vm-control"):
        validate_group(name, allowed_members={owner} if name == "lm-vm-control" else set())
    validate_user("lm-vm", "lm-vm", "/var/lib/little-mester-vm")
    validate_user("lm-vm-proxy", "lm-vm-proxy", "/var/empty")

    for raw, group, mode in (
        ("/usr/lib/little-mester-vm", "root", 0o755),
        ("/usr/lib/little-mester-vm/plugins", "root", 0o755),
        ("/usr/lib/little-mester-vm/host-metrics-tui", "root", 0o755),
        ("/etc/little-mester-vm", "lm-vm-control", 0o750),
        ("/etc/systemd/system/little-mester-vm-workspace.service.d", "root", 0o755),
        ("/var/lib/little-mester-vm", "lm-vm", 0o750),
    ):
        path = pathlib.Path(raw)
        if path.exists() or path.is_symlink():
            try:
                gid = grp.getgrnam(group).gr_gid
            except KeyError as error:
                raise RuntimeError(f"existing fixed directory has no expected group: {path}") from error
            info = os.lstat(path)
            if (not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode)
                    or info.st_uid != 0 or info.st_gid != gid or stat.S_IMODE(info.st_mode) != mode):
                refuse(f"fixed system VM directory is unsafe: {path}")

    for relative, (raw, mode) in FILES.items():
        target = pathlib.Path(raw)
        if not (target.exists() or target.is_symlink()):
            continue
        info = os.lstat(target)
        if (stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode)
                or info.st_uid != 0 or info.st_gid != 0 or stat.S_IMODE(info.st_mode) != mode
                or target.read_bytes() != source_payload(root, relative, owner)):
            refuse(f"preserving pre-existing non-matching protected install target: {target}")

    for raw, allowed in (
        ("/etc/little-mester-vm", {pathlib.Path(path).name for path in PROVISION_FINALS[2:]} |
         {"workspace.json"}),
        ("/var/lib/little-mester-vm",
         {pathlib.Path(PROVISION_FINALS[0]).name, pathlib.Path(PROVISION_FINALS[1]).name,
          *(pathlib.Path(path).name for path in PROVISION_PARTIALS)}),
    ):
        directory = pathlib.Path(raw)
        if directory.is_dir() and not directory.is_symlink():
            unexpected = {entry.name for entry in directory.iterdir()} - allowed
            if unexpected:
                refuse(f"unexpected fixed system VM state exists; preserving {directory}")

    artifacts = (*PROVISION_FINALS, *PROVISION_PARTIALS)
    if any(pathlib.Path(path).exists() or pathlib.Path(path).is_symlink()
           for path in artifacts):
        refuse("pre-existing system VM provisioning evidence exists; preserving it for owner inspection")


def ensure_dir(path: pathlib.Path, *, group: str, mode: int) -> None:
    current = pathlib.Path(path.anchor)
    for component in path.parent.parts[1:]:
        current /= component
        info = os.lstat(current)
        if (stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode)
                or info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
            refuse("system VM directory ancestry is not root-controlled")
    if path.exists() or path.is_symlink():
        info = os.lstat(path)
        gid = grp.getgrnam(group).gr_gid
        if (not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode)
                or info.st_uid != 0 or info.st_gid != gid or stat.S_IMODE(info.st_mode) != mode):
            refuse(f"fixed system VM directory is unsafe: {path}")
        return
    path.mkdir(mode=mode)
    os.chown(path, 0, grp.getgrnam(group).gr_gid)
    os.chmod(path, mode)


def install_file(source: pathlib.Path, destination: pathlib.Path, mode: int,
                 *, payload: bytes | None = None) -> None:
    current = pathlib.Path(destination.anchor)
    for component in destination.parent.parts[1:]:
        current /= component
        info = os.lstat(current)
        if (stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode)
                or info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
            refuse("system installation target ancestry is not root-controlled")
    payload = source.read_bytes() if payload is None else payload
    if destination.exists() or destination.is_symlink():
        info = os.lstat(destination)
        if (stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode)
                or info.st_uid != 0 or info.st_gid != 0 or stat.S_IMODE(info.st_mode) != mode
                or destination.read_bytes() != payload):
            refuse(f"preserving pre-existing non-matching protected install target: {destination}")
        return
    fd = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    try:
        view = memoryview(payload)
        while view:
            count = os.write(fd, view)
            if count <= 0:
                refuse("system VM install write made no progress")
            view = view[count:]
        os.fchmod(fd, mode)
        os.fchown(fd, 0, 0)
        os.fsync(fd)
    finally:
        os.close(fd)


def _state_fingerprint(paths: tuple[pathlib.Path, ...]) -> dict[str, tuple]:
    result = {}
    for path in paths:
        try:
            info = os.lstat(path)
        except FileNotFoundError:
            result[str(path)] = ("missing",)
            continue
        if (stat.S_ISREG(info.st_mode) and not stat.S_ISLNK(info.st_mode)
                and path != pathlib.Path("/var/lib/little-mester-vm/disk.qcow2")):
            digest = hashlib.sha256(path.read_bytes()).hexdigest()
        else:
            digest = "not-regular"
        result[str(path)] = (info.st_dev, info.st_ino, info.st_uid, info.st_gid,
                             stat.S_IMODE(info.st_mode), info.st_nlink, info.st_size,
                             info.st_mtime_ns, info.st_ctime_ns, digest)
    return result


def update_code_only(root: pathlib.Path, owner: str) -> None:
    """Atomically replace only existing protected host code; preserve VM state."""
    if os.geteuid() != 0:
        refuse("code-only update requires explicit root through sudo")
    try:
        owner_info = pwd.getpwnam(owner)
        control_gid = grp.getgrnam("lm-vm-control").gr_gid
    except KeyError as error:
        raise RuntimeError("intended workspace owner or control group is unavailable") from error
    if owner == "root" or owner_info.pw_uid == 0:
        refuse("root cannot be the fixed VM owner")
    state_units = ("little-mester-vm.service", "little-mester-vm-proxy.service",
                   "little-mester-vm-workspace.service", "little-mester-vm-metrics.service")
    for unit in state_units:
        state = subprocess.run(["/usr/bin/systemctl", "show", "--property=ActiveState",
                                "--value", unit], stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                               text=True, check=False)
        if (state.returncode and unit == "little-mester-vm-workspace.service"
                and not pathlib.Path("/etc/systemd/system/little-mester-vm-workspace.service").exists()):
            continue
        if (state.returncode and unit == "little-mester-vm-metrics.service"
                and not pathlib.Path("/etc/systemd/system/little-mester-vm-metrics.service").exists()):
            continue
        if state.returncode or state.stdout.strip() not in ("inactive", "failed"):
            refuse(f"code-only update requires all fixed services stopped ({unit})")
    state_paths = tuple(pathlib.Path(path) for path in (
        "/var/lib/little-mester-vm/disk.qcow2", "/var/lib/little-mester-vm/seed.iso",
        "/etc/little-mester-vm/control_ed25519", "/etc/little-mester-vm/ssh_host_ed25519_key",
        "/etc/little-mester-vm/control_ed25519.pub",
        "/etc/little-mester-vm/ssh_host_ed25519_key.pub",
        "/etc/little-mester-vm/known_hosts", "/etc/little-mester-vm/workspace.json",
        "/etc/systemd/system/little-mester-vm-workspace.service.d/20-workspace.conf"))
    before_state = _state_fingerprint(state_paths)
    pending: list[tuple[pathlib.Path, pathlib.Path, bytes, int]] = []
    for relative, (raw_target, mode) in FILES.items():
        target = pathlib.Path(raw_target)
        try:
            info = os.lstat(target)
        except FileNotFoundError:
            if relative not in UPDATE_ADDITIONALS:
                raise RuntimeError(f"code-only update requires existing protected asset: {target}")
            pending.append((root / relative, target, source_payload(root, relative, owner), mode))
            continue
        except OSError as error:
            raise RuntimeError(f"code-only update cannot inspect protected install asset: {target}") from error
        if (not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode)
                or info.st_uid != 0 or info.st_gid != 0 or stat.S_IMODE(info.st_mode) != mode
                or info.st_nlink != 1):
            refuse(f"protected install asset has unsafe metadata; preserving it: {target}")
        pending.append((root / relative, target, source_payload(root, relative, owner), mode))
    # Validate all sources, destinations, and the candidate before changing a byte.
    verify_source(root)
    ensure_dir(pathlib.Path("/usr/lib/little-mester-vm/host-metrics-tui"),
               group="root", mode=0o755)
    ensure_dir(pathlib.Path("/etc/systemd/system/little-mester-vm-workspace.service.d"),
               group="root", mode=0o755)
    temps: list[tuple[pathlib.Path, pathlib.Path]] = []
    try:
        for source, destination, payload, mode in pending:
            current = pathlib.Path(destination.anchor)
            for component in destination.parent.parts[1:]:
                current /= component
                ancestor = os.lstat(current)
                if (not stat.S_ISDIR(ancestor.st_mode) or stat.S_ISLNK(ancestor.st_mode)
                        or ancestor.st_uid != 0 or ancestor.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
                    refuse("protected update target ancestry is unsafe")
            temp = destination.parent / f".{destination.name}.{os.getpid()}.{secrets.token_hex(8)}.tmp"
            fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
            temps.append((temp, destination))
            try:
                view = memoryview(payload)
                while view:
                    count = os.write(fd, view)
                    if count <= 0:
                        refuse("protected update write made no progress")
                    view = view[count:]
                os.fchown(fd, 0, 0)
                os.fchmod(fd, mode)
                os.fsync(fd)
            finally:
                os.close(fd)
        for temp, destination in temps:
            os.replace(temp, destination)
            directory_fd = os.open(destination.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            try:
                os.fsync(directory_fd)
            finally:
                os.close(directory_fd)
        subprocess.run(["/usr/sbin/visudo", "-cf", "/etc/sudoers.d/little-mester-vm"],
                       stdin=subprocess.DEVNULL, check=True)
        subprocess.run(["/usr/bin/systemctl", "daemon-reload"],
                       stdin=subprocess.DEVNULL, check=True)
        if _state_fingerprint(state_paths) != before_state:
            raise RuntimeError("protected VM state changed during code-only update; inspect before retry")
    finally:
        for temp, _destination in temps:
            try:
                temp.unlink()
            except FileNotFoundError:
                pass


def main() -> int:
    try:
        if os.geteuid() != 0:
            refuse("explicit system VM installation requires root")
        update_mode = sys.argv[1:] == ["--update-code-only"]
        if sys.argv[1:] and not update_mode:
            refuse("supported operation is no argument (fresh install) or --update-code-only")
        root = source_root()
        verify_source(root)
        owner = os.environ.get("SUDO_USER", "")
        if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}\$?", owner) or owner == "root":
            refuse("run the explicit installer through sudo from the intended owner account")
        pwd.getpwnam(owner)
        if update_mode:
            update_code_only(root, owner)
            print("Code-only update complete. VM state and lifecycle were preserved; services remain stopped.")
            return 0
        try:
            kvm_gid = grp.getgrnam("kvm").gr_gid
            kvm = os.stat("/dev/kvm", follow_symlinks=False)
        except (KeyError, OSError) as error:
            raise RuntimeError("/dev/kvm and its pre-existing exact kvm group must be available") from error
        if (not stat.S_ISCHR(kvm.st_mode) or kvm.st_gid != kvm_gid
                or stat.S_IMODE(kvm.st_mode) & 0o060 != 0o060):
            refuse("/dev/kvm must already grant group read/write through its kvm group; installer does not change host device policy")
        for tool in ("/usr/bin/python3", "/usr/bin/curl", "/usr/bin/qemu-img",
