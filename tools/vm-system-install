#!/usr/bin/env python3
"""Explicit root installer for the fixed systemd VM slice; never auto-run."""

from __future__ import annotations

import grp
import os
import pathlib
import pwd
import re
import shutil
import stat
import subprocess
import sys


FILES = {
    "systemd/little-mester-vm.service": ("/etc/systemd/system/little-mester-vm.service", 0o644),
    "systemd/little-mester-vm-proxy.service": ("/etc/systemd/system/little-mester-vm-proxy.service", 0o644),
    "sudoers/little-mester-vm": ("/etc/sudoers.d/little-mester-vm", 0o440),
    "lib/vm/system-vm.py": ("/usr/lib/little-mester-vm/system-vm.py", 0o644),
    "lib/vm/guest-bootstrap.py": ("/usr/lib/little-mester-vm/guest-bootstrap.py", 0o644),
    "lib/vm/parent-qemu.py": ("/usr/lib/little-mester-vm/parent-qemu.py", 0o644),
    "lib/vm/parent-provision.py": ("/usr/lib/little-mester-vm/parent-provision.py", 0o644),
    "lib/vm/parent-session-contract.py": ("/usr/lib/little-mester-vm/parent-session-contract.py", 0o644),
    "lib/vm/guest-user-dirs.py": ("/usr/lib/little-mester-vm/guest-user-dirs.py", 0o644),
    "lib/vm/proxy.py": ("/usr/lib/little-mester-vm/proxy.py", 0o644),
    "lib/vm/browser-auth-session.py": ("/usr/lib/little-mester-vm/browser-auth-session.py", 0o644),
    "lib/vm/callback-listener.py": ("/usr/lib/little-mester-vm/callback-listener.py", 0o644),
    "lib/vm/host-dependencies.py": ("/usr/lib/little-mester-vm/host-dependencies.py", 0o644),
    "agent/opencode/plugins/little-mester-exit-confirm/package.json":
        ("/usr/lib/little-mester-vm/plugins/package.json", 0o644),
    "agent/opencode/plugins/little-mester-exit-confirm/tui.tsx":
        ("/usr/lib/little-mester-vm/plugins/tui.tsx", 0o644),
}
DIRS = ("/usr/lib/little-mester-vm", "/usr/lib/little-mester-vm/plugins",
        "/etc/little-mester-vm", "/var/lib/little-mester-vm")
PROVISION_FINALS = (
    "/var/lib/little-mester-vm/disk.qcow2",
    "/var/lib/little-mester-vm/seed.iso",
    "/etc/little-mester-vm/control_ed25519",
    "/etc/little-mester-vm/control_ed25519.pub",
    "/etc/little-mester-vm/ssh_host_ed25519_key",
    "/etc/little-mester-vm/ssh_host_ed25519_key.pub",
    "/etc/little-mester-vm/known_hosts",
)
PROVISION_PARTIALS = (
    "/var/lib/little-mester-vm/base-image.part",
    "/var/lib/little-mester-vm/base-image.qcow2",
    "/var/lib/little-mester-vm/disk.qcow2.part",
    "/var/lib/little-mester-vm/seed.iso.part",
    "/var/lib/little-mester-vm/user-data",
    "/var/lib/little-mester-vm/meta-data",
)
PROTECTED_PARENTS = (
    "/usr/lib", "/etc/systemd/system", "/etc/sudoers.d", "/etc", "/var/lib",
)


def refuse(message: str) -> None:
    raise RuntimeError(message)


def source_root() -> pathlib.Path:
    entry = pathlib.Path(__file__).absolute()
    current = pathlib.Path(entry.anchor)
    for component in entry.parts[1:]:
        current /= component
        info = os.lstat(current)
        if stat.S_ISLNK(info.st_mode):
            refuse("installer path contains a symlink")
    root = entry.parent.parent
    if not re.fullmatch(r"[0-9a-f]{40}", root.name) or root.parent.name != "v3":
        refuse("installer must be invoked from a root-protected pinned v3 installation")
    for path in (root, *root.parents):
        info = os.lstat(path)
        if (stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode)
                or info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
            refuse("pinned installer ancestry must be root-owned and not group/world writable")
    return root


def verify_source(root: pathlib.Path) -> None:
    for relative in (*FILES, "tools/vm-system-install"):
        path = root / relative
        for parent in path.parents:
            if parent == root.parent:
                break
            info = os.lstat(parent)
            if (stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode)
                    or info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
                refuse("pinned system VM install source ancestry is not protected")
        info = os.lstat(path)
        if (stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode)
                or info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
            refuse("system VM install source is not a protected regular file")


def ensure_group(name: str, *, allowed_members: set[str] = frozenset()) -> None:
    try:
        existing = grp.getgrnam(name)
    except KeyError:
        subprocess.run(["/usr/sbin/groupadd", "--system", name], check=True,
                       stdin=subprocess.DEVNULL)
    else:
        if existing.gr_gid >= 1000:
            refuse(f"existing {name} group is not in the protected system-group ID range")
        unexpected = set(existing.gr_mem) - allowed_members
        if unexpected:
            refuse(f"existing {name} group has unexpected members; preserving it")


def validate_group(name: str, *, allowed_members: set[str] = frozenset()) -> grp.struct_group | None:
    try:
        existing = grp.getgrnam(name)
    except KeyError:
        return None
    if existing.gr_gid >= 1000:
        refuse(f"existing {name} group is not in the protected system-group ID range")
    unexpected = set(existing.gr_mem) - allowed_members
    if unexpected:
        refuse(f"existing {name} group has unexpected members; preserving it")
    return existing


def ensure_user(name: str, group: str, home: str) -> None:
    try:
        pwd.getpwnam(name)
    except KeyError:
        subprocess.run(["/usr/sbin/useradd", "--system", "--no-create-home", "--home-dir", home,
                        "--shell", "/usr/sbin/nologin", "--gid", group, name], check=True,
                       stdin=subprocess.DEVNULL)
        return
    user = pwd.getpwnam(name)
    expected_group = grp.getgrnam(group).gr_gid
    if (not 1 <= user.pw_uid < 1000 or user.pw_gid != expected_group
            or user.pw_shell != "/usr/sbin/nologin" or user.pw_dir != home):
        refuse(f"existing {name} identity differs from the fixed service identity; preserving it")


def validate_user(name: str, group: str, home: str) -> pwd.struct_passwd | None:
    try:
        user = pwd.getpwnam(name)
    except KeyError:
        return None
    try:
        expected_group = grp.getgrnam(group).gr_gid
    except KeyError as error:
        raise RuntimeError(f"existing {name} account has no matching fixed primary group") from error
    if (not 1 <= user.pw_uid < 1000 or user.pw_gid != expected_group
            or user.pw_shell != "/usr/sbin/nologin" or user.pw_dir != home):
        refuse(f"existing {name} identity differs from the fixed service identity; preserving it")
    return user


def validate_root_directory(path: pathlib.Path) -> os.stat_result:
    current = pathlib.Path(path.anchor)
    info = os.lstat(current)
    if (not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode)
            or info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
        refuse(f"host parent is not a root-controlled directory: {current}")
    for component in path.parts[1:]:
        current /= component
        try:
            info = os.lstat(current)
        except FileNotFoundError as error:
            raise RuntimeError(f"required protected host parent is missing: {current}") from error
        if (stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode)
                or info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
            refuse(f"host parent is not a root-controlled directory: {current}")
    return info


def preflight(root: pathlib.Path, owner: str) -> None:
    """Validate every fixed host target and prior state before the first mutation.

    Any existing provisioning artifact blocks automatic continuation. In
    particular, do not parse or adopt a service-writable disk as root.
    """
    sys.dont_write_bytecode = True
    for raw in PROTECTED_PARENTS:
        validate_root_directory(pathlib.Path(raw))

    for name in ("lm-vm", "lm-vm-proxy", "lm-vm-control"):
        validate_group(name, allowed_members={owner} if name == "lm-vm-control" else set())
    validate_user("lm-vm", "lm-vm", "/var/lib/little-mester-vm")
    validate_user("lm-vm-proxy", "lm-vm-proxy", "/var/empty")

    for raw, group, mode in (
        ("/usr/lib/little-mester-vm", "root", 0o755),
        ("/usr/lib/little-mester-vm/plugins", "root", 0o755),
        ("/etc/little-mester-vm", "lm-vm-control", 0o750),
        ("/var/lib/little-mester-vm", "lm-vm", 0o750),
    ):
        path = pathlib.Path(raw)
        if path.exists() or path.is_symlink():
            try:
                gid = grp.getgrnam(group).gr_gid
            except KeyError as error:
                raise RuntimeError(f"existing fixed directory has no expected group: {path}") from error
            info = os.lstat(path)
            if (not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode)
                    or info.st_uid != 0 or info.st_gid != gid or stat.S_IMODE(info.st_mode) != mode):
                refuse(f"fixed system VM directory is unsafe: {path}")

    for relative, (raw, mode) in FILES.items():
        target = pathlib.Path(raw)
        if not (target.exists() or target.is_symlink()):
            continue
        info = os.lstat(target)
        if (stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode)
                or info.st_uid != 0 or info.st_gid != 0 or stat.S_IMODE(info.st_mode) != mode
                or target.read_bytes() != (root / relative).read_bytes()):
            refuse(f"preserving pre-existing non-matching protected install target: {target}")

    for raw, allowed in (
        ("/etc/little-mester-vm", {pathlib.Path(path).name for path in PROVISION_FINALS[2:]}),
        ("/var/lib/little-mester-vm",
         {pathlib.Path(PROVISION_FINALS[0]).name, pathlib.Path(PROVISION_FINALS[1]).name,
          *(pathlib.Path(path).name for path in PROVISION_PARTIALS)}),
    ):
        directory = pathlib.Path(raw)
        if directory.is_dir() and not directory.is_symlink():
            unexpected = {entry.name for entry in directory.iterdir()} - allowed
            if unexpected:
                refuse(f"unexpected fixed system VM state exists; preserving {directory}")

    artifacts = (*PROVISION_FINALS, *PROVISION_PARTIALS)
    if any(pathlib.Path(path).exists() or pathlib.Path(path).is_symlink()
           for path in artifacts):
        refuse("pre-existing system VM provisioning evidence exists; preserving it for owner inspection")


def ensure_dir(path: pathlib.Path, *, group: str, mode: int) -> None:
    current = pathlib.Path(path.anchor)
    for component in path.parent.parts[1:]:
        current /= component
        info = os.lstat(current)
        if (stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode)
                or info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
            refuse("system VM directory ancestry is not root-controlled")
    if path.exists() or path.is_symlink():
        info = os.lstat(path)
        gid = grp.getgrnam(group).gr_gid
        if (not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode)
                or info.st_uid != 0 or info.st_gid != gid or stat.S_IMODE(info.st_mode) != mode):
            refuse(f"fixed system VM directory is unsafe: {path}")
        return
    path.mkdir(mode=mode)
    os.chown(path, 0, grp.getgrnam(group).gr_gid)
    os.chmod(path, mode)


def install_file(source: pathlib.Path, destination: pathlib.Path, mode: int) -> None:
    current = pathlib.Path(destination.anchor)
    for component in destination.parent.parts[1:]:
        current /= component
        info = os.lstat(current)
        if (stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode)
                or info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
            refuse("system installation target ancestry is not root-controlled")
    payload = source.read_bytes()
    if destination.exists() or destination.is_symlink():
        info = os.lstat(destination)
        if (stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode)
                or info.st_uid != 0 or info.st_gid != 0 or stat.S_IMODE(info.st_mode) != mode
                or destination.read_bytes() != payload):
            refuse(f"preserving pre-existing non-matching protected install target: {destination}")
        return
    fd = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    try:
        view = memoryview(payload)
        while view:
            count = os.write(fd, view)
            if count <= 0:
                refuse("system VM install write made no progress")
            view = view[count:]
        os.fchmod(fd, mode)
        os.fchown(fd, 0, 0)
        os.fsync(fd)
    finally:
        os.close(fd)


def main() -> int:
    try:
        if os.geteuid() != 0:
            refuse("explicit system VM installation requires root")
        root = source_root()
        verify_source(root)
        owner = os.environ.get("SUDO_USER", "")
        if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}\$?", owner) or owner == "root":
            refuse("run the explicit installer through sudo from the intended owner account")
        pwd.getpwnam(owner)
        try:
            kvm_gid = grp.getgrnam("kvm").gr_gid
            kvm = os.stat("/dev/kvm", follow_symlinks=False)
        except (KeyError, OSError) as error:
            raise RuntimeError("/dev/kvm and its pre-existing exact kvm group must be available") from error
        if (not stat.S_ISCHR(kvm.st_mode) or kvm.st_gid != kvm_gid
                or stat.S_IMODE(kvm.st_mode) & 0o060 != 0o060):
            refuse("/dev/kvm must already grant group read/write through its kvm group; installer does not change host device policy")
        for tool in ("/usr/bin/python3", "/usr/bin/curl", "/usr/bin/qemu-img",
                     "/usr/bin/qemu-system-x86_64", "/usr/bin/genisoimage",
                     "/usr/bin/ssh-keygen", "/usr/bin/socat", "/usr/bin/systemctl",
                     "/usr/sbin/visudo", "/usr/sbin/groupadd", "/usr/sbin/useradd",
                     "/usr/sbin/usermod"):
            if not os.path.isfile(tool) or not os.access(tool, os.X_OK):
                refuse(f"fixed system VM host dependency is unavailable: {pathlib.Path(tool).name}; "
                       "review the pinned owner bootstrap's production/system-install scopes before retrying")
        # Parse the exact pinned policy before creating accounts, files, or disks.
        subprocess.run(["/usr/sbin/visudo", "-cf", str(root / "sudoers/little-mester-vm")],
                       check=True, stdin=subprocess.DEVNULL)
        preflight(root, owner)
        # Do not claim a pre-existing system identity. Only groups and accounts
        # with these exact fixed names are ever created by this explicit tool.
        ensure_group("lm-vm")
        ensure_group("lm-vm-proxy")
        ensure_group("lm-vm-control", allowed_members={owner})
        ensure_user("lm-vm", "lm-vm", "/var/lib/little-mester-vm")
        ensure_user("lm-vm-proxy", "lm-vm-proxy", "/var/empty")
        ensure_dir(pathlib.Path("/usr/lib/little-mester-vm"), group="root", mode=0o755)
        ensure_dir(pathlib.Path("/usr/lib/little-mester-vm/plugins"), group="root", mode=0o755)
        ensure_dir(pathlib.Path("/etc/little-mester-vm"), group="lm-vm-control", mode=0o750)
        ensure_dir(pathlib.Path("/var/lib/little-mester-vm"), group="lm-vm", mode=0o750)
        for relative, (target, mode) in FILES.items():
            install_file(root / relative, pathlib.Path(target), mode)
        # Existing provisioning evidence was refused before any host mutation.
        subprocess.run(["/usr/bin/python3", "-I", "/usr/lib/little-mester-vm/system-vm.py",
                       "provision"], check=True, stdin=subprocess.DEVNULL)
        subprocess.run(["/usr/sbin/usermod", "-a", "-G", "lm-vm-control", owner], check=True,
                       stdin=subprocess.DEVNULL)
        subprocess.run(["/usr/sbin/visudo", "-cf", "/etc/sudoers.d/little-mester-vm"],
                       check=True, stdin=subprocess.DEVNULL)
        subprocess.run(["/usr/bin/systemctl", "daemon-reload"], check=True,
                       stdin=subprocess.DEVNULL)
        print("Installed fixed little-mester-vm system unit; it is not enabled or started.")
        return 0
    except (OSError, KeyError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"REFUSED: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
