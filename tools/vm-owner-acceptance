#!/usr/bin/env python3
"""Owner-controlled, distro-independent orchestration for the VM v3 gates.

The installed lab-vm remains the authority for executable provenance,
workspace policy, lifecycle, native browser authentication, and process cleanup.
This entry point only pins a candidate, sequences those existing gates, and
stores a small secret-free report. It never performs automatic cleanup.
"""

from __future__ import annotations

