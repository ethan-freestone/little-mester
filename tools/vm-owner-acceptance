ROOT = pathlib.Path(__file__).resolve().parent.parent
ENTRY = pathlib.Path(__file__).resolve()
FIXED_PATH = "/usr/sbin:/usr/bin:/sbin:/bin"
PYTHON = "/usr/bin/python3"
GIT = "/usr/bin/git"
SUDO = "/usr/bin/sudo"
INSTALL_PARENT = pathlib.Path("/opt/little-mester/v3")
RUNTIME_ROOT = pathlib.Path(f"/run/user/{os.getuid()}/little-mester-vm-acceptance")
RUN_ROOT_NAME = "v3-smoke"
WORKSPACE_PROOF_BYTES = 64 * 1024 * 1024
WORKSPACE_MAX_BYTES = WORKSPACE_PROOF_BYTES
MAX_ARCHIVE_FILE = 4 * 1024 * 1024
MAX_ARCHIVE_TOTAL = 16 * 1024 * 1024
RUN_ID_RE = re.compile(r"^[0-9]{8}T[0-9]{6}Z-(?:[A-Za-z0-9]{8}|[0-9a-f]{32})$")
SHA_RE = re.compile(r"^[0-9a-f]{40}$")
INSTALL_FILES = {
    "lab-vm": 0o755,
    "lib/vm/host-launcher.sh": 0o644,
    "lib/vm/cloud-init.sh": 0o644,
    "lib/vm/proxy.py": 0o644,
    "lib/vm/bounded-log.py": 0o644,
    "lib/vm/executable-policy.py": 0o644,
    "lib/vm/browser-auth-session.py": 0o644,
}
INSTALL_DIRS = {"lib", "lib/vm"}


class GateError(Exception):
    def __init__(self, status: str, message: str):
        super().__init__(message)
        self.status = status
        self.message = message


def clean_env() -> dict[str, str]:
    return {"PATH": FIXED_PATH, "HOME": "/nonexistent", "LANG": "C", "LC_ALL": "C"}


def protected_executable(repo: pathlib.Path, path: str) -> str:
    candidate = pathlib.Path(path)
    if not candidate.is_absolute():
        raise GateError("BLOCKED", "required fixed executable path is not absolute")
    policy = repo / "lib/vm/executable-policy.py"
    result = subprocess.run(
        [PYTHON, "-I", str(policy), str(candidate)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env=clean_env(),
        check=False,
    )
    if result.returncode:
        raise GateError("BLOCKED", "required executable failed protected-path policy")
    return str(candidate)


def git(repo: pathlib.Path, *args: str, capture: bool = True) -> subprocess.CompletedProcess:
    executable = protected_executable(repo, GIT)
    return subprocess.run(
        [executable, "-C", str(repo), *args],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        env={**clean_env(), "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null"},
        check=False,
    )


def candidate_commit(repo: pathlib.Path, sha: str) -> None:
    if not SHA_RE.fullmatch(sha):
        raise GateError("BLOCKED", "candidate must be a full lowercase 40-character commit SHA")
    resolved = git(repo, "rev-parse", "--verify", f"{sha}^{{commit}}")
    if resolved.returncode or resolved.stdout.decode("ascii", "replace").strip() != sha:
        raise GateError("BLOCKED", "candidate SHA is not an available exact commit")
    runner_blob = git(repo, "show", f"{sha}:tools/vm-owner-acceptance")
    try:
        current = ENTRY.read_bytes()
    except OSError as error:
        raise GateError("BLOCKED", "runner source cannot be read safely") from error
    if runner_blob.returncode or runner_blob.stdout != current:
        raise GateError("BLOCKED", "running acceptance runner does not match the pinned candidate")


def install_path(sha: str) -> pathlib.Path:
    return INSTALL_PARENT / sha


def check_directory_chain(path: pathlib.Path, final_uid: int, final_mode: int) -> None:
    """Require a lexical, symlink-free protected directory chain."""
    if not path.is_absolute():
        raise GateError("BLOCKED", "protected path is not absolute")
    current = pathlib.Path("/")
    for index, component in enumerate(path.parts[1:]):
        current = current / component
        try:
            info = os.lstat(current)
        except OSError as error:
            raise GateError("BLOCKED", "protected directory path is missing or inaccessible") from error
        last = index == len(path.parts[1:]) - 1
        expected_uid = final_uid if last else 0
        if (not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode)
                or info.st_uid != expected_uid or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
                or not info.st_mode & stat.S_IXOTH):
            raise GateError("BLOCKED", "protected directory ownership, type, or mode check failed")
        if last and stat.S_IMODE(info.st_mode) != final_mode:
            raise GateError("BLOCKED", "protected directory mode differs from the normalized mode")


def verify_install(repo: pathlib.Path, sha: str) -> pathlib.Path:
    root = install_path(sha)
    check_directory_chain(root, 0, 0o755)
    expected = set(INSTALL_FILES) | INSTALL_DIRS
    observed: set[str] = set()
    for directory, dirs, files in os.walk(root, topdown=True, followlinks=False):
        parent = pathlib.Path(directory)
        for name in list(dirs):
            path = parent / name
            info = os.lstat(path)
            relative = path.relative_to(root).as_posix()
            if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
                raise GateError("BLOCKED", "installation contains a symlink or non-directory")
            if info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o755:
                raise GateError("BLOCKED", "installation directory ownership or mode differs")
            observed.add(relative)
        for name in files:
            path = parent / name
            info = os.lstat(path)
            relative = path.relative_to(root).as_posix()
            if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
                raise GateError("BLOCKED", "installation contains a symlink or non-regular file")
            if info.st_uid != 0 or stat.S_IMODE(info.st_mode) != INSTALL_FILES.get(relative):
                raise GateError("BLOCKED", "installation file ownership or mode differs")
            source = git(repo, "show", f"{sha}:{relative}")
            if source.returncode or path.read_bytes() != source.stdout:
                raise GateError("BLOCKED", "installed bytes do not match the pinned commit")
            observed.add(relative)
    if observed != expected:
        raise GateError("BLOCKED", "installation file set differs from the pinned runtime inventory")
    return root


