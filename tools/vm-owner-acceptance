class GateError(Exception):
    def __init__(self, status: str, message: str):
        super().__init__(message)
        self.status = status
        self.message = message


def clean_env(*, desktop_session: bool = False) -> dict[str, str]:
    env = {
        "PATH": FIXED_PATH,
        "HOME": "/nonexistent",
        "LANG": "C",
        "LC_ALL": "C",
        "GIT_NO_REPLACE_OBJECTS": "1",
    }
    # Preserve only the invoking user's standard session-bus endpoints so the
    # auth helper can call the desktop portal. Never inherit arbitrary desktop
    # or application environment variables.
    if desktop_session:
        uid = os.getuid()
        runtime = pathlib.Path(f"/run/user/{uid}")
        bus = runtime / "bus"
        try:
            runtime_info = runtime.stat()
            bus_info = bus.stat()
            if (runtime_info.st_uid == uid and runtime_info.st_mode & 0o777 == 0o700
                    and stat.S_ISSOCK(bus_info.st_mode) and bus_info.st_uid == uid):
                env["XDG_RUNTIME_DIR"] = str(runtime)
                env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={bus}"
        except OSError:
            pass
    term = os.environ.get("TERM", "")
    if (os.environ.get("LM_VM_TERM_VALIDATED") == "1"
            and re.fullmatch(r"[A-Za-z0-9_.+-]{1,64}", term)):
        env["TERM"] = term
        env["LM_VM_TERM_VALIDATED"] = "1"
    return env


def protected_executable(repo: pathlib.Path, path: str) -> str:
    candidate = pathlib.Path(path)
    if not candidate.is_absolute():
        raise GateError("BLOCKED", "required fixed executable path is not absolute")
    policy = repo / "lib/vm/executable-policy.py"
    result = subprocess.run(
        [PYTHON, "-I", str(policy), str(candidate)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env=clean_env(),
        check=False,
    )
    if result.returncode:
        raise GateError("BLOCKED", "required executable failed protected-path policy")
    return str(candidate)


def git(repo: pathlib.Path, *args: str, capture: bool = True) -> subprocess.CompletedProcess:
    executable = protected_executable(repo, GIT)
    return subprocess.run(
        [executable, "-C", str(repo), *args],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        env={**clean_env(), "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null"},
        check=False,
    )


def candidate_commit(repo: pathlib.Path, sha: str) -> None:
    if not SHA_RE.fullmatch(sha):
        raise GateError("BLOCKED", "candidate must be a full lowercase 40-character commit SHA")
    resolved = git(repo, "rev-parse", "--verify", f"{sha}^{{commit}}")
    if resolved.returncode or resolved.stdout.decode("ascii", "replace").strip() != sha:
        raise GateError("BLOCKED", "candidate SHA is not an available exact commit")
    runner_blob = git(repo, "show", f"{sha}:tools/vm-owner-acceptance")
    try:
        current = ENTRY.read_bytes()
    except OSError as error:
        raise GateError("BLOCKED", "runner source cannot be read safely") from error
    if runner_blob.returncode or runner_blob.stdout != current:
        raise GateError("BLOCKED", "running acceptance runner does not match the pinned candidate")


def changed_parent_guest_assets(repo: pathlib.Path, sha: str) -> list[str]:
    """Conservatively detect protected guest assets changed since accepted M1."""
    if not SHA_RE.fullmatch(sha):
        raise GateError("BLOCKED", "candidate SHA is not a full lowercase 40-character commit SHA")
    result = git(repo, "diff", "--name-only", M1_ACCEPTED_SHA, sha, "--", *PARENT_GUEST_ASSETS)
    if result.returncode:
        raise GateError("BLOCKED", "could not compare protected guest assets with accepted M1 source")
    changed = result.stdout.decode("utf-8", "strict").splitlines()
    if any(path not in PARENT_GUEST_ASSETS for path in changed):
        raise GateError("FAIL", "protected guest-asset comparison returned an unexpected path")
    return changed


def inspect_live_parent(root: pathlib.Path) -> dict:
    """Read parent identity and fixed guest asset metadata; never starts/stops it."""
    def read_status() -> dict:
        status_result = subprocess.run(
            [str(root / "lab-vm"), "parent", "status", "--json"],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            env=clean_env(), timeout=30, check=False,
        )
        if status_result.returncode:
            raise GateError("BLOCKED", "live parent status is unavailable; no guest operation was attempted")
        try:
            decoded = json.loads(status_result.stdout)
        except (ValueError, UnicodeDecodeError) as error:
            raise GateError("FAIL", "parent status returned malformed identity evidence") from error
        if not isinstance(decoded, dict):
            raise GateError("FAIL", "parent status returned an invalid evidence shape")
        return decoded

    status = read_status()
    # Keep only non-secret identity/status fields in the private acceptance report.
    identity = {key: status[key] for key in (
        "status", "run_id", "supervisor_pid", "qemu_pid"
    ) if key in status and isinstance(status[key], (str, int, type(None)))}
    disk = status.get("disk")
    if isinstance(disk, dict):
        identity["disk"] = {key: disk[key] for key in ("path", "device", "inode", "provisioned")
                            if key in disk and isinstance(disk[key], (str, int, bool, type(None)))}
    if status.get("status") != "RUNNING":
        raise GateError("BLOCKED", "read-only guest inspection requires the already-running verified parent")
    result = subprocess.run(
        [str(root / "lab-vm"), "parent", "inspect"],
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        env=clean_env(), timeout=60, check=False,
    )
    if result.returncode:
        raise GateError("BLOCKED", "fixed read-only guest inspection failed; no lifecycle action was attempted")
    try:
        observed = json.loads(result.stdout)
    except (ValueError, UnicodeDecodeError) as error:
        raise GateError("FAIL", "guest inspection returned malformed or non-JSON output") from error
    if not isinstance(observed, dict) or any(not isinstance(value, dict) for value in observed.values()):
        raise GateError("FAIL", "guest inspection returned an invalid inventory shape")
    contract_path = root / "lib/vm/parent-session-contract.py"
    spec = importlib.util.spec_from_file_location("m2_guest_contract", contract_path)
    if spec is None or spec.loader is None:
        raise GateError("BLOCKED", "verified installed guest contract cannot be loaded")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    expected = dict(module.ASSET_SHA256)
    protected_config = json.dumps(
        {"autoupdate": False, "share": "disabled", "permission": {"edit": "ask", "bash": "ask"}},
        separators=(",", ":"),
    ).encode()
    expected["/etc/opencode/opencode.json"] = hashlib.sha256(protected_config).hexdigest()
    checks = {}
    compatible = True
    for path, digest in sorted(expected.items()):
        item = observed.get(path, {})
        okay = (
            item.get("type") == "file" and item.get("sha256") == digest
            and item.get("uid") == 0 and item.get("gid") == 0
            and item.get("mode") == ("0755" if path in (
                "/usr/local/bin/lm-opencode", "/usr/local/libexec/lm-opencode",
                "/usr/local/libexec/lm-opencode-auth",
            ) else "0644")
        )
        checks[path] = "PASS" if okay else "MISMATCH"
        compatible = compatible and okay
    # npm installs the protected CLI as a symlink into its fixed global package.
    # Verify the literal link, package provenance metadata, and executable target
    # metadata without executing guest code during this read-only inspection.
    opencode_link = observed.get("/usr/local/bin/opencode", {})
    package = observed.get("/usr/local/lib/node_modules/@opencode/cli/package.json", {})
    executable = observed.get("/usr/local/lib/node_modules/@opencode/cli/bin/opencode", {})
    link_ok = (
        opencode_link.get("type") == "symlink"
        and opencode_link.get("target") == "../lib/node_modules/@opencode/cli/bin/opencode"
        and opencode_link.get("uid") == 0 and opencode_link.get("gid") == 0
        and package.get("type") == "file" and package.get("uid") == 0 and package.get("gid") == 0
        and package.get("mode") == "0644" and package.get("version") == "2.2.5"
        and executable.get("type") == "file" and executable.get("uid") == 0
        and executable.get("gid") == 0 and executable.get("mode") == "0755"
    )
    checks["/usr/local/bin/opencode+package"] = "PASS" if link_ok else "MISMATCH"
    compatible = compatible and link_ok
    for path in ("/usr/bin/tmux",):
        item = observed.get(path, {})
        okay = item.get("type") == "file" and item.get("uid") == 0 and item.get("mode") == "0755"
        checks[path] = "PASS" if okay else "MISMATCH"
        compatible = compatible and okay
    version_ok = package.get("version") == "2.2.5"
    checks["opencode_package_version"] = "PASS" if version_ok else "MISMATCH"
    compatible = compatible and version_ok
    after = read_status()
    def stable_identity(value: dict) -> tuple:
        disk_value = value.get("disk") if isinstance(value.get("disk"), dict) else {}
        return (value.get("status"), value.get("run_id"), value.get("supervisor_pid"),
                value.get("qemu_pid"), disk_value.get("path"), disk_value.get("device"),
                disk_value.get("inode"))
    if stable_identity(status) != stable_identity(after):
        raise GateError("BLOCKED", "parent identity changed during guest inspection; evidence was discarded")
    observed_evidence = {}
    for path, item in sorted(observed.items()):
        if path.startswith("/") and isinstance(item, dict):
            observed_evidence[path] = {key: item[key] for key in (
                "type", "uid", "gid", "mode", "sha256", "target", "version"
            ) if key in item and isinstance(item[key], (str, int))}
    return {
        "parent_identity": identity,
        "guest_assets": checks,
        "observed_guest_inventory": observed_evidence,
        "expected_guest_sha256": expected,
        "guest_opencode_version": package.get("version", "unavailable"),
        "m2_contract_compatible": compatible,
        "inspection": "read_only_fixed_inventory",
    }


def install_path(sha: str, prefix: pathlib.Path | None = None) -> pathlib.Path:
    return install_parent(prefix) / sha


def install_parent(prefix: pathlib.Path | None = None) -> pathlib.Path:
    return INSTALL_PARENT if prefix is None else prefix / "v3"


def install_prefix(value: str) -> pathlib.Path:
    path = pathlib.PurePosixPath(value)
    if (not path.is_absolute() or str(path) != value or path == pathlib.PurePosixPath("/")
            or ".." in path.parts):
        raise argparse.ArgumentTypeError("prefix must be an absolute normalized non-root path")
    return pathlib.Path(value)


def installer_manifest() -> str:
    return json.dumps({"files": INSTALL_FILES, "directories": sorted(INSTALL_DIRS)}, sort_keys=True)


def archive_arguments(repo: pathlib.Path, sha: str, git_executable: str = GIT) -> list[str]:
    return [git_executable, "-C", str(repo), "archive", "--format=tar", sha, *INSTALL_FILES]


def check_directory_chain(path: pathlib.Path, final_uid: int, final_mode: int) -> None:
    """Require a lexical, symlink-free root-protected installation chain."""
    if not path.is_absolute():
        raise GateError("BLOCKED", "protected path is not absolute")
    current = pathlib.Path("/")
    for index, component in enumerate(path.parts[1:]):
        current = current / component
        try:
            info = os.lstat(current)
        except OSError as error:
            raise GateError("BLOCKED", "protected directory path is missing or inaccessible") from error
        last = index == len(path.parts[1:]) - 1
        expected_uid = final_uid if last else 0
        search_bit = stat.S_IXUSR if info.st_uid == os.getuid() else stat.S_IXOTH
        if stat.S_ISLNK(info.st_mode):
            raise GateError("BLOCKED", "protected directory path contains a symlink")
        if not stat.S_ISDIR(info.st_mode):
            raise GateError("BLOCKED", "protected path component is not a directory")
        if info.st_uid != expected_uid:
            raise GateError("BLOCKED", "protected directory owner does not match the required UID")
        if info.st_mode & stat.S_IWGRP:
            raise GateError("BLOCKED", "protected directory is group-writable")
        if info.st_mode & stat.S_IWOTH:
            raise GateError("BLOCKED", "protected directory is world-writable")
        if not info.st_mode & search_bit:
            raise GateError("BLOCKED", "protected directory is not traversable")
        if last and stat.S_IMODE(info.st_mode) != final_mode:
            raise GateError("BLOCKED", "protected directory mode differs from the normalized mode")


def check_protected_directory_prefix(path: pathlib.Path) -> None:
    """Validate root-owned system ancestors that an invoking user must traverse."""
    if not path.is_absolute():
        raise GateError("BLOCKED", "protected system directory is not absolute")
    current = pathlib.Path("/")
    for component in path.parts[1:]:
        current /= component
        try:
            info = os.lstat(current)
        except OSError as error:
            raise GateError("BLOCKED", "protected system directory is missing or inaccessible") from error
        search_bit = stat.S_IXUSR if info.st_uid == os.getuid() else stat.S_IXOTH
        if (not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode)
                or info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
                or not info.st_mode & search_bit):
            raise GateError("BLOCKED", "protected system directory ownership, type, mode, or traversal check failed")


def check_private_directory(path: pathlib.Path, uid: int, mode: int = 0o700) -> None:
    """Validate one owner-controlled private directory without world-execute assumptions."""
    try:
        info = os.lstat(path)
    except OSError as error:
        raise GateError("BLOCKED", "private runtime directory is missing or inaccessible") from error
    if (not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode)
            or info.st_uid != uid or stat.S_IMODE(info.st_mode) != mode
            or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
            or not info.st_mode & stat.S_IXUSR):
        raise GateError("BLOCKED", "private runtime directory ownership, type, mode, or owner traversal check failed")


def check_private_runtime_chain(
    path: pathlib.Path,
    system_parent: pathlib.Path | None = None,
    uid: int | None = None,
) -> None:
    """Validate root-owned /run/user ancestry followed by the private UID subtree."""
    uid = os.getuid() if uid is None else uid
    system_parent = system_parent or RUNTIME_ROOT.parent.parent
    if not path.is_absolute() or not system_parent.is_absolute():
        raise GateError("BLOCKED", "private runtime path is not absolute")
    user_root = system_parent / str(uid)
    if path != user_root and user_root not in path.parents:
        raise GateError("BLOCKED", "private runtime path is outside the invoking user's runtime directory")
    check_protected_directory_prefix(system_parent)
    current = user_root
    check_private_directory(current, uid)
    for component in path.relative_to(user_root).parts:
        current /= component
        check_private_directory(current, uid)


def verify_install(repo: pathlib.Path, sha: str,
                   prefix: pathlib.Path | None = None) -> pathlib.Path:
    root = install_path(sha, prefix)
    check_directory_chain(root, 0, 0o755)
    expected = set(INSTALL_FILES) | INSTALL_DIRS
    observed: set[str] = set()
    for directory, dirs, files in os.walk(root, topdown=True, followlinks=False):
        parent = pathlib.Path(directory)
        for name in list(dirs):
            path = parent / name
            info = os.lstat(path)
            relative = path.relative_to(root).as_posix()
            if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
                raise GateError("BLOCKED", "installation contains a symlink or non-directory")
            if info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o755:
                raise GateError("BLOCKED", "installation directory ownership or mode differs")
            observed.add(relative)
        for name in files:
            path = parent / name
            info = os.lstat(path)
            relative = path.relative_to(root).as_posix()
            if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
                raise GateError("BLOCKED", "installation contains a symlink or non-regular file")
            if info.st_uid != 0 or stat.S_IMODE(info.st_mode) != INSTALL_FILES.get(relative):
                raise GateError("BLOCKED", "installation file ownership or mode differs")
            source = git(repo, "show", f"{sha}:{relative}")
            if source.returncode or path.read_bytes() != source.stdout:
                raise GateError("BLOCKED", "installed bytes do not match the pinned commit")
            observed.add(relative)
    if observed != expected:
        raise GateError("BLOCKED", "installation file set differs from the pinned runtime inventory")
    return root


