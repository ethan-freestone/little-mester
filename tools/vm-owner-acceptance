            os.fsync(stream.fileno())
            os.fchown(stream.fileno(), 0, 0)
            os.fchmod(stream.fileno(), expected[name])
        os.close(parent_fd)
        observed.add(name)
    if observed != set(expected) | directories:
        raise SystemExit("REFUSED: archive does not contain the exact runtime inventory")
    os.fsync(target)
    os.close(target)
    print("PINNED_INSTALL_CREATED")
finally:
    os.close(fd)
'''


def install_candidate(repo: pathlib.Path, sha: str,
                      prefix: pathlib.Path | None = None) -> pathlib.Path:
    target = install_path(sha, prefix)
    if target.exists() or target.is_symlink():
        raise GateError("BLOCKED", "candidate installation path already exists; preserving it")
    sudo = protected_executable(repo, SUDO)
    # Let sudo authenticate on the controlling terminal before its stdin is
    # occupied by the immutable archive stream. The privileged worker itself
    # runs non-interactively after this explicit authorization step.
    authorization = subprocess.run(
        [sudo, "-v"], stdin=None, stdout=None, stderr=None, env=clean_env(), check=False
    )
    if authorization.returncode:
        raise GateError("BLOCKED", "privileged installation authorization was not granted")
    archive = subprocess.Popen(
        archive_arguments(repo, sha, protected_executable(repo, GIT)),
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=None,
        env={**clean_env(), "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": "/dev/null"},
    )
    assert archive.stdout is not None
    try:
        worker = subprocess.run(
            [sudo, "-n", PYTHON, "-I", "-c", INSTALL_WORKER, sha,
             installer_manifest(), str(prefix if prefix is not None else INSTALL_PARENT.parent)],
            stdin=archive.stdout,
            env=clean_env(),
            check=False,
        )
    except KeyboardInterrupt:
        archive.terminate()
        archive.wait()
        raise
    finally:
        archive.stdout.close()
    archive_status = archive.wait()
    if worker.returncode or archive_status:
        raise GateError("FAIL", "protected installation failed; any partial target is preserved")
    return verify_install(repo, sha, prefix)


def runtime_dir() -> pathlib.Path:
    uid = os.getuid()
    system_parent = RUNTIME_ROOT.parent.parent
    user_root = system_parent / str(uid)
    check_private_runtime_chain(user_root, system_parent, uid)
    target = RUNTIME_ROOT
    try:
        os.mkdir(target, 0o700)
    except FileExistsError:
        pass
    except OSError as error:
        raise GateError("BLOCKED", "trusted private runtime directory could not be created") from error
    check_private_runtime_chain(target, system_parent, uid)
    return target


def new_report_dir(parent: pathlib.Path | None = None) -> pathlib.Path:
    parent = runtime_dir() if parent is None else parent
    check_private_directory(parent, os.getuid())
    for _ in range(20):
        identity = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + "-" + uuid.uuid4().hex
        path = parent / identity
        try:
            os.mkdir(path, 0o700)
        except FileExistsError:
            continue
        except OSError as error:
            raise GateError("BLOCKED", "trusted report directory could not be created") from error
        check_private_directory(path, os.getuid())
        return path
    raise GateError("FAIL", "could not allocate a fresh evidence directory")


def save_report(report_dir: pathlib.Path, data: dict) -> None:
    path = report_dir / "report.json"
    payload = (json.dumps(data, sort_keys=True, indent=2) + "\n").encode()
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "wb") as stream:
        stream.write(payload)
        stream.flush()
        os.fsync(stream.fileno())


def mount_facts(path: pathlib.Path) -> tuple[str, set[str], set[str]]:
    resolved = path.resolve(strict=True)
    match = None
    with open("/proc/self/mountinfo", "r", encoding="ascii") as stream:
        for line in stream:
            left, separator, right = line.rstrip("\n").partition(" - ")
            if not separator:
                continue
            fields = left.split()
            tail = right.split()
            if len(fields) >= 6 and len(tail) >= 3 and fields[4].replace("\\040", " ") == str(resolved):
                match = (tail[0], set(fields[5].split(",")), set(tail[2].split(",")))
                break
    if match is None:
        raise GateError("BLOCKED", "workspace is not a mount root")
    return match


def verify_workspace_mount(path_text: str, exact_tmpfs: bool) -> pathlib.Path:
    path = pathlib.Path(path_text)
    if not path.is_absolute():
        raise GateError("BLOCKED", "workspace path must be absolute")
    try:
        resolved = path.resolve(strict=True)
        info = os.lstat(path)
        usage = os.statvfs(resolved)
    except OSError as error:
        raise GateError("BLOCKED", "workspace path or filesystem cannot be verified") from error
    if resolved != path or not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        raise GateError("BLOCKED", "workspace must be a canonical owner-owned directory")
    fs_type, mount_options, super_options = mount_facts(resolved)
    total = usage.f_blocks * usage.f_frsize
    if exact_tmpfs:
        options = mount_options | super_options
        required = {"nosuid", "nodev", "noexec", "mode=700", f"uid={os.getuid()}"}
        if (fs_type != "tmpfs" or total != WORKSPACE_PROOF_BYTES
                or not required.issubset(options) or stat.S_IMODE(info.st_mode) != 0o700
                or info.st_gid != os.getgid()):
            raise GateError("BLOCKED", "storage proof requires the pre-existing confined 64-MiB tmpfs")
    elif total > 8 * 1024 * 1024 * 1024:
        raise GateError("BLOCKED", "workspace filesystem exceeds the 8-GiB smoke bound")
    return resolved


def storage_proof(workspace_text: str) -> None:
    workspace = verify_workspace_mount(workspace_text, exact_tmpfs=True)
    if list(workspace.iterdir()):
        raise GateError("BLOCKED", "workspace must be empty before the bounded ENOSPC proof")
    fd = open_anonymous_probe(workspace)
    written = 0
    with os.fdopen(fd, "wb", buffering=0) as stream:
        block = b"\0" * min(1024 * 1024, WORKSPACE_PROOF_BYTES)
        while written < WORKSPACE_PROOF_BYTES + 1:
            amount = min(len(block), WORKSPACE_PROOF_BYTES + 1 - written)
            try:
                count = stream.write(block[:amount])
            except OSError as error:
                if error.errno == errno.ENOSPC and written == WORKSPACE_PROOF_BYTES:
                    print("ENOSPC_CONFIRMED after 67108864 bytes; 67108865 bytes attempted at most")
                    return
                raise GateError("FAIL", "bounded storage proof failed before the expected ENOSPC boundary") from error
            if count != amount:
                raise GateError("FAIL", "bounded storage proof encountered a short write")
            written += count
    raise GateError("FAIL", "workspace accepted a write beyond the 64-MiB capacity")


def open_anonymous_probe(workspace: pathlib.Path) -> int:
    """Open an unnamed file so interruption cannot unlink a replacement path."""
    if not hasattr(os, "O_TMPFILE"):
        raise GateError("BLOCKED", "platform does not support anonymous temporary files for the storage proof")
    directory_fd = os.open(workspace, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        return os.open(".", os.O_TMPFILE | os.O_RDWR | os.O_CLOEXEC, 0o600, dir_fd=directory_fd)
    except OSError as error:
        raise GateError("BLOCKED", "workspace does not support a safe anonymous temporary proof file") from error
    finally:
        os.close(directory_fd)


def state_root() -> pathlib.Path:
    home = pathlib.Path(pwd.getpwuid(os.getuid()).pw_dir).resolve(strict=True)
    path = home / ".local/state/little-mester" / RUN_ROOT_NAME
    return path


def installed_preflight(root: pathlib.Path, workspace: str | None) -> None:
    command = [str(root / "lab-vm"), "preflight"]
    if workspace:
        command.extend(["--workspace", workspace])
    status = subprocess.run(command, stdin=subprocess.DEVNULL, env=clean_env(), check=False).returncode
    if status:
        raise GateError("BLOCKED", "protected installed preflight failed")


def list_runs(root: pathlib.Path) -> set[str]:
    try:
        return {entry.name for entry in root.iterdir() if entry.is_dir() and not entry.is_symlink()}
    except FileNotFoundError:
        return set()


def inspect_cleanup(sha: str, run_id: str, install_root: pathlib.Path) -> dict:
    if not RUN_ID_RE.fullmatch(run_id):
        raise GateError("BLOCKED", "run identity format is invalid")
    root = state_root()
    run_dir = root / run_id
    verify_user_directory_chain(run_dir)
    if not run_dir.is_relative_to(root):
        raise GateError("BLOCKED", "run directory escaped private state")
    allowed = {"qemu.log", "virtiofsd.log", "proxy.log", "virtiofs.socket-path"}
    required_logs = {"qemu.log", "virtiofsd.log", "proxy.log"}
    entries = {entry.name for entry in run_dir.iterdir()}
    if "qemu.log" not in entries:
        raise GateError("BLOCKED", "QEMU never created its log; this was an early startup failure, not cleanup acceptance")
    if not required_logs.issubset(entries) or not entries.issubset(allowed):
        raise GateError("BLOCKED", "run contains missing expected logs or unexpected retained artifacts")
    for name in required_logs:
        info = os.lstat(run_dir / name)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or stat.S_IMODE(info.st_mode) != 0o600 or info.st_size > 1024 * 1024):
            raise GateError("BLOCKED", "retained helper log failed type, ownership, mode, or size checks")
    if list(run_dir.glob("*.identity")) or list(run_dir.glob("*.complete")):
        raise GateError("BLOCKED", "run retains process identity or incomplete logger proof; no cleanup attempted")
    for name in ("disk.qcow2", "ubuntu.img.part", "id_vm_control", "id_vm_control.pub"):
        if (run_dir / name).exists() or (run_dir / name).is_symlink():
            raise GateError("BLOCKED", "run retains transient VM or key material; no cleanup attempted")
    metadata = run_dir / "virtiofs.socket-path"
    try:
        info = os.lstat(metadata)
    except OSError as error:
        raise GateError("BLOCKED", "short virtiofs socket-path evidence is missing") from error
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
            or stat.S_IMODE(info.st_mode) != 0o600):
        raise GateError("BLOCKED", "short virtiofs socket-path evidence has unsafe metadata")
    socket_state = inspect_virtiofs_artifacts(run_dir, install_root)
    residual = ["virtiofs.socket-path (retained private allocation evidence)"]
    if socket_state["socket_present"]:
        residual.append("short virtiofs socket (retained in private runtime directory)")
    if socket_state["pid_present"]:
        residual.append("short virtiofs PID artifact (retained; contents are not process authority)")
    return {"status": "PASS", "run_id": run_id, "residual_artifacts": residual,
            "note": "No identity/PID artifact was used to signal a process; an expired volatile runtime directory is distinguished from a live listener."}


def inspect_virtiofs_artifacts(run_dir: pathlib.Path, install_root: pathlib.Path) -> dict:
    helper = install_root / "lib/vm/virtiofs-socket.py"
    result = subprocess.run(
        [sys.executable, "-I", str(helper), "stopped", str(run_dir)],
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, env=clean_env(), check=False,
    )
    if result.returncode:
        raise GateError("BLOCKED", "short virtiofs socket/PID artifacts or listener state failed validation")
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise GateError("BLOCKED", "short virtiofs artifact validator returned invalid evidence") from error


def verify_user_directory_chain(path: pathlib.Path) -> None:
    if not path.is_absolute():
        raise GateError("BLOCKED", "private run path is not absolute")
    home = pathlib.Path(pwd.getpwuid(os.getuid()).pw_dir).resolve(strict=True)
    if path != home and home not in path.parents:
        raise GateError("BLOCKED", "VM run path is outside the invoking user's home")
    current = pathlib.Path("/")
    for index, component in enumerate(path.parts[1:]):
        current /= component
        try:
            info = os.lstat(current)
        except OSError as error:
            raise GateError("BLOCKED", "private run path is missing or inaccessible") from error
        final = index == len(path.parts[1:]) - 1
        expected_uid = os.getuid() if current == home or home in current.parents else 0
        if (not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode)
                or info.st_uid != expected_uid or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)
                or (final and stat.S_IMODE(info.st_mode) != 0o700)):
            raise GateError("BLOCKED", "private run path ownership or mode check failed")


def verify_cleanup_report(sha: str, run_id: str) -> None:
    parent = runtime_dir()
    matches = []
    for entry in parent.iterdir():
        if entry.is_symlink() or not entry.is_dir():
            continue
        report = entry / "report.json"
        try:
            info = os.lstat(report)
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                    or stat.S_IMODE(info.st_mode) != 0o600):
                continue
            content = json.loads(report.read_text(encoding="utf-8"))
        except (OSError, ValueError, json.JSONDecodeError):
            continue
        if (content.get("candidate_sha") == sha
                and content.get("evidence", {}).get("vm_run_id") == run_id
                and content.get("gates", {}).get("run") == "PASS"
                and content.get("gates", {}).get("cleanup") == "PASS"):
            matches.append(content)
    if len(matches) != 1:
        raise GateError("BLOCKED", "no unique successful smoke report binds this SHA to that run id; early startup failure is not cleanup acceptance")


def _replacement_provision_origin(sha: str, repo: pathlib.Path | None = None) -> dict | None:
    """Find unique private evidence that binds a replacement disk to this candidate lineage."""
    parent = runtime_dir()
    reports = []
    has_replacement_evidence = False
    ancestry_cache = {sha: True}

    def candidate_in_lineage(candidate: object) -> bool:
        if not isinstance(candidate, str) or not SHA_RE.fullmatch(candidate):
            return False
        if candidate not in ancestry_cache:
            ancestry_cache[candidate] = bool(
                repo is not None
                and git(repo, "merge-base", "--is-ancestor", candidate, sha).returncode == 0
            )
        return ancestry_cache[candidate]

    runtime_fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        runtime_info = os.fstat(runtime_fd)
        if (not stat.S_ISDIR(runtime_info.st_mode) or runtime_info.st_uid != os.getuid()
                or stat.S_IMODE(runtime_info.st_mode) != 0o700):
            raise GateError("BLOCKED", "private acceptance report directory changed; resume provenance unavailable")
        for entry_name in os.listdir(runtime_fd):
            if not re.fullmatch(r"\d{8}T\d{6}Z-[0-9a-f]{32}", entry_name):
                continue
            attempt_fd = report_fd = -1
            try:
                attempt_fd = os.open(entry_name,
                    os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=runtime_fd)
                attempt_info = os.fstat(attempt_fd)
                if (not stat.S_ISDIR(attempt_info.st_mode)
                        or attempt_info.st_uid != os.getuid()
                        or stat.S_IMODE(attempt_info.st_mode) != 0o700):
                    continue
                report_fd = os.open("report.json", os.O_RDONLY | os.O_NOFOLLOW, dir_fd=attempt_fd)
                info = os.fstat(report_fd)
                if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                        or stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1
                        or info.st_size > 1024 * 1024):
                    continue
                payload = bytearray()
                while len(payload) < info.st_size:
                    chunk = os.read(report_fd, min(info.st_size - len(payload), 65536))
                    if not chunk:
                        raise ValueError("short report read")
                    payload.extend(chunk)
                content = json.loads(payload)
            except (OSError, ValueError, json.JSONDecodeError):
                continue
            finally:
                if report_fd >= 0:
                    os.close(report_fd)
                if attempt_fd >= 0:
                    os.close(attempt_fd)
            if not isinstance(content, dict):
                continue
            raw_evidence = content.get("evidence", {})
            raw_evidence = raw_evidence if isinstance(raw_evidence, dict) else {}
            raw_retirement = raw_evidence.get("retirement", {})
            raw_retirement = raw_retirement if isinstance(raw_retirement, dict) else {}
            if (raw_retirement.get("status") == "FACTORY_RESET"
                    or bool(raw_evidence.get("provisioning_origin"))
                    or bool(raw_evidence.get("fresh_provision_approval"))):
                has_replacement_evidence = True
            if not candidate_in_lineage(content.get("candidate_sha")):
                continue
            if (content.get("attempt_id") == entry_name
                    and content.get("mode") == "parent_accept"):
                reports.append(content)

        by_attempt = {content["attempt_id"]: content for content in reports}

        def dict_at(mapping: object, key: str) -> dict:
            value = mapping.get(key, {}) if isinstance(mapping, dict) else {}
            return value if isinstance(value, dict) else {}

        def disk_identity(value: object) -> dict | None:
            if (isinstance(value, dict) and type(value.get("device")) is int
                    and value["device"] >= 0 and type(value.get("inode")) is int
                    and value["inode"] > 0):
                return {"device": value["device"], "inode": value["inode"]}
            return None

        has_replacement_evidence = has_replacement_evidence or any(
            dict_at(dict_at(content, "evidence"), "retirement").get("status") == "FACTORY_RESET"
            or bool(dict_at(dict_at(content, "evidence"), "provisioning_origin"))
            or bool(dict_at(dict_at(content, "evidence"), "fresh_provision_approval"))
            for content in reports
        )

        def reset_root(content: dict) -> bool:
            gates = dict_at(content, "gates")
            evidence = dict_at(content, "evidence")
            retirement = dict_at(evidence, "retirement")
            approval = dict_at(evidence, "fresh_provision_approval")
            failure = dict_at(evidence, "fresh_provision_failure")
            notes = content.get("notes", [])
            legacy_failed_up = (
                isinstance(notes, list)
                and any(isinstance(note, str) and re.fullmatch(
                    r"protected parent operation up failed \(exit=[1-9][0-9]{0,2}; reason=(?:refused|command_failure)\)",
                    note) for note in notes)
            )
            recorded_failed_up = (
                failure.get("operation") == "parent up"
                and type(failure.get("exit_status")) is int
                and failure["exit_status"] != 0
            )
            approved_attempt = (
                approval.get("owner_approved") is True
                and approval.get("candidate_sha") == content.get("candidate_sha")
                and approval.get("capacity_gib") == 64
                and approval.get("from_status") in ("NOT_CREATED", "RETIRED", "UNPROVISIONED")
            )
            return (
                gates.get("retirement") == "PASS"
                and retirement.get("status") == "FACTORY_RESET"
                and ((content.get("status") == "FAIL"
                      and gates.get("fresh_provision") == "FAIL"
                      and (legacy_failed_up or recorded_failed_up))
                     or (approved_attempt and content.get("status") in (
                         "IN_PROGRESS", "BLOCKED", "FAIL", "PASS"))
                     or (content.get("status") == "IN_PROGRESS"
                         and gates.get("fresh_provision") in (None, "NOT_RUN", "BLOCKED")))
            )

        def pre_disk_provision(content: dict, origin: dict, reset_id: object) -> bool:
            evidence = dict_at(content, "evidence")
            approval = dict_at(evidence, "fresh_provision_approval")
            failure = dict_at(evidence, "fresh_provision_failure")
            return (
                disk_identity(origin.get("disk_identity")) is None
                and not failure
                and content.get("status") in ("IN_PROGRESS", "BLOCKED")
                and origin.get("owner_approved_fresh_provision") is True
                and approval.get("owner_approved") is True
                and approval.get("candidate_sha") == content.get("candidate_sha")
                and approval.get("capacity_gib") == 64
                and approval.get("factory_reset_attempt_id") == reset_id
            )
        def report_chain_valid(attempt_id: object, reset_id: object,
                               visited: set[str] | None = None) -> bool:
            if not isinstance(attempt_id, str) or not isinstance(reset_id, str):
                return False
            if visited is None:
                visited = set()
            if attempt_id in visited:
                return False
            visited.add(attempt_id)
            content = by_attempt.get(attempt_id)
            if (not isinstance(content, dict)
                    or not candidate_in_lineage(content.get("candidate_sha"))):
                return False
            if attempt_id == reset_id:
                return reset_root(content)
            evidence = dict_at(content, "evidence")
            origin = dict_at(evidence, "provisioning_origin")
            if (origin.get("factory_reset_attempt_id") != reset_id
                    or not candidate_in_lineage(origin.get("candidate_sha"))):
                return False
            if disk_identity(origin.get("disk_identity")) is None:
                if not pre_disk_provision(content, origin, reset_id):
                    return False
            return report_chain_valid(origin.get("prior_attempt_id"), reset_id, visited)

        matches = []
        valid_links = []
        invalid_origin_evidence = False
        for content in reports:
            evidence = dict_at(content, "evidence")
            if ("provisioning_origin" in evidence
                    and (not isinstance(evidence["provisioning_origin"], dict)
                         or not evidence["provisioning_origin"])):
                invalid_origin_evidence = True
                continue
            origin = dict_at(evidence, "provisioning_origin")
            if not origin:
                if reset_root(content):
                    failure = dict_at(evidence, "fresh_provision_failure")
                    matches.append({
                        "attempt_id": content["attempt_id"],
                        "factory_reset_attempt_id": content["attempt_id"],
                        "disk_identity": disk_identity(failure.get("post_failure_disk_identity")),
                    })
                continue

            prior_id = origin.get("prior_attempt_id")
            reset_id = origin.get("factory_reset_attempt_id")
            recorded_identity = disk_identity(origin.get("disk_identity"))
            approval = dict_at(dict_at(content, "evidence"), "fresh_provision_approval")
            owner_confirmed = (
                origin.get("owner_confirmed_same_disk_resume") is True
                or origin.get("already_running_owner_approval_in_prior_attempt") is True
                or (origin.get("owner_approved_fresh_provision") is True
                    and approval.get("owner_approved") is True
                    and approval.get("candidate_sha") == content.get("candidate_sha")
                    and approval.get("capacity_gib") == 64
                    and approval.get("factory_reset_attempt_id") == reset_id)
            )
            prior = by_attempt.get(prior_id) if isinstance(prior_id, str) else None
            reset_report = by_attempt.get(reset_id) if isinstance(reset_id, str) else None
            if (not candidate_in_lineage(origin.get("candidate_sha"))
                    or (recorded_identity is None
                        and not pre_disk_provision(content, origin, reset_id))
                    or not owner_confirmed
                    or prior is None or reset_report is None or not reset_root(reset_report)):
                invalid_origin_evidence = True
                continue
            if (not candidate_in_lineage(prior.get("candidate_sha"))
                    or not report_chain_valid(prior_id, reset_id)):
                invalid_origin_evidence = True
                continue
            prior_evidence = dict_at(prior, "evidence")
            prior_origin = dict_at(prior_evidence, "provisioning_origin")
            prior_failure = dict_at(prior_evidence, "fresh_provision_failure")
            prior_identity = (disk_identity(prior_origin.get("disk_identity"))
                              or disk_identity(prior_failure.get("post_failure_disk_identity")))
            if (recorded_identity is not None and prior_identity is not None
                    and prior_identity != recorded_identity):
                invalid_origin_evidence = True
                continue
            if prior_id != content["attempt_id"]:
                valid_links.append((prior_id, recorded_identity))
            matches.append({
                "attempt_id": content["attempt_id"],
                "factory_reset_attempt_id": reset_id,
                "disk_identity": recorded_identity,
            })

        # A report supersedes its predecessor only when its candidate-bound origin,
        # reset root, owner confirmation, and disk identity all validate above.
        superseded = {prior_id for prior_id, _identity in valid_links}
        matches = [match for match in matches if match.get("attempt_id") not in superseded]
        if invalid_origin_evidence:
            raise GateError(
                "BLOCKED",
                "a candidate-linked report contains inconsistent replacement identity evidence; preserve the parent without lifecycle changes",
            )
        if not matches:
            if has_replacement_evidence:
                raise GateError(
                    "BLOCKED",
                    "private replacement evidence exists but its provenance chain is incomplete or inconsistent; preserve the parent without lifecycle changes",
                )
            return None
        if len(matches) != 1 or not isinstance(matches[0].get("attempt_id"), str):
            raise GateError(
                "BLOCKED",
                "cannot establish one unique private replacement-provenance chain for this SHA; preserve the parent without lifecycle changes",
            )
        return matches[0]
    finally:
        os.close(runtime_fd)


def _parent_up_failure(stderr: bytes, exit_status: int | None) -> dict:
    """Map protected parent-up diagnostics to fixed, non-secret report categories."""
    text = stderr[:16384].decode("utf-8", "ignore")
    stage, reason = "startup", "protected_refusal"
    if "QEMU_PROCESS_EXITED_BEFORE_READINESS" in text:
        stage, reason = "qemu_boot", "qemu_exited_before_readiness"
    elif "QEMU_IDENTITY_AMBIGUOUS" in text or "QEMU_IDENTITY_CHANGED" in text:
        stage, reason = "identity", "qemu_identity_transition_refused"
    elif "GUEST_READINESS_DEADLINE_EXPIRED" in text:
        last = re.search(r"\blast=([A-Z_]{1,64})\b", text)
        last_reason = {
            "CLOUD_INIT_STATUS_FAILED": "cloud_init_status_failed",
            "SSH_HOST_KEY_REJECTED": "ssh_host_key_rejected",
            "SSH_AUTH_REJECTED": "ssh_auth_rejected",
            "SSH_FORWARD_NOT_LISTENING": "ssh_forward_unavailable",
            "SSH_FORWARD_UNRESPONSIVE": "ssh_forward_unresponsive",
            "SSH_CLIENT_ATTEMPT_TIMED_OUT": "ssh_readiness_timeout",
            "GUEST_SSH_SERVICE_UNAVAILABLE": "guest_ssh_unavailable",
            "GUEST_SSH_SERVICE_UNRESPONSIVE": "guest_ssh_unresponsive",
            "SSH_TRANSPORT_OR_HANDSHAKE_FAILED": "ssh_transport_or_handshake_failed",
            "GUEST_READINESS_COMMAND_FAILED": "guest_readiness_command_failed",
        }.get(last.group(1) if last else "")
        if last_reason == "cloud_init_status_failed":
            stage, reason = "guest_readiness", last_reason
        elif (last_reason and last_reason.startswith("ssh_")) or last_reason in (
                "guest_ssh_unavailable", "guest_ssh_unresponsive"):
            stage, reason = "ssh_readiness", last_reason
        else:
            stage, reason = "guest_readiness", "readiness_deadline_expired"
    elif "CLOUD_INIT_STATUS_FAILED" in text:
        stage, reason = "guest_readiness", "cloud_init_status_failed"
    elif "SSH_HOST_KEY_REJECTED" in text:
        stage, reason = "ssh_readiness", "ssh_host_key_rejected"
    elif "SSH_AUTH_REJECTED" in text:
        stage, reason = "ssh_readiness", "ssh_auth_rejected"
    elif "SSH_FORWARD_NOT_LISTENING" in text:
        stage, reason = "ssh_readiness", "ssh_forward_unavailable"
    elif "SSH_FORWARD_UNRESPONSIVE" in text:
        stage, reason = "ssh_readiness", "ssh_forward_unresponsive"
    elif "SSH_CLIENT_ATTEMPT_TIMED_OUT" in text or "SSH_FORWARD_UNRESPONSIVE" in text:
        stage, reason = "ssh_readiness", "ssh_readiness_timeout"
    elif "GUEST_SSH_SERVICE_UNAVAILABLE" in text:
        stage, reason = "ssh_readiness", "guest_ssh_unavailable"
    elif "SSH_TRANSPORT_OR_HANDSHAKE_FAILED" in text:
        stage, reason = "ssh_readiness", "ssh_transport_or_handshake_failed"
    elif "PARENT_SESSION_CONTRACT_UPGRADE_REQUIRED" in text:
        stage, reason = "guest_readiness", "guest_contract_mismatch"
    elif "supervisor startup failed:" in text:
        stage, reason = "supervisor_startup", "supervisor_invariant_refused"
    elif "parent provisioning refused:" in text:
        stage, reason = "provisioning", "provisioning_invariant_refused"
    elif "parent cannot start from status" in text or "different parent run appeared" in text:
        stage, reason = "identity", "parent_state_transition_refused"
    elif "parent supervisor/startup failed; status is" in text:
        stage, reason = "supervisor_or_readiness", "startup_failed_stage_unavailable"
    elif "REFUSED:" not in text:
        reason = "command_failure"
    return {"operation": "parent up", "exit_status": exit_status,
            "stage": stage, "reason_category": reason}


def _post_failure_parent_evidence(root: pathlib.Path) -> dict:
    """Retain only fixed status labels and validated numeric disk identity."""
    try:
        _, status = _parent_json(root, "status", "--json")
    except (GateError, OSError, subprocess.SubprocessError):
        return {"post_failure_status": "UNAVAILABLE"}
    allowed = {"NOT_CREATED", "UNPROVISIONED", "RUNNING", "STARTING", "STOPPED",
               "RETIRED", "RETIRING", "AMBIGUOUS"}
    result = {"post_failure_status": status.get("status")
              if status.get("status") in allowed else "UNRECOGNIZED"}
    disk = status.get("disk") if isinstance(status.get("disk"), dict) else {}
    if (type(disk.get("device")) is int and disk["device"] >= 0
            and type(disk.get("inode")) is int and disk["inode"] > 0):
        result["post_failure_disk_identity"] = {
            "device": disk["device"], "inode": disk["inode"]}
    return result


def report_template(sha: str, mode: str, report_dir: pathlib.Path) -> dict:
    gates = [
        "candidate", "preflight", "install", "storage_proof", "run", "cleanup",
        "parent_identity", "guest_compatibility", "retirement", "fresh_provision",
        "owner_interaction",
        "ssh_reconnect", "duplicate_up", "m1_recovery_guards", "network_boundaries",
        "m1_revalidation",
        "protected_configuration", "authentication", "model_response_before_restart",
        "model_list_behavior",
        "telemetry_behavior",
        "configuration_persistence",
        "tmux_controls", "terminal_clipboard_mitigation", "workspace_persistence",
        "credentials_persistence", "history_persistence", "same_disk_restart",
        "model_response_after_restart", "temporary_cleanup", "final_vm_state",
    ]
    if mode == "parent_accept":
        gates = [name for name in gates if name not in ("storage_proof", "run", "cleanup")]
    else:
        gates = [name for name in gates if name != "owner_interaction"]
    return {
        "version": 1,
        "candidate_sha": sha,
        "mode": mode,
        "attempt_id": report_dir.name,
        "status": "IN_PROGRESS",
        "gates": {name: "NOT_RUN" for name in gates},
        "evidence": {"report": str(report_dir / "report.json")},
        "notes": [],
    }


def _checkpoint(report_dir: pathlib.Path, data: dict) -> None:
    path = report_dir / "report.json"
    payload = (json.dumps(data, sort_keys=True, indent=2) + "\n").encode()
    temporary = report_dir / f".report-{uuid.uuid4().hex}.tmp"
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "wb") as stream:
        stream.write(payload)
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, path)
    directory_fd = os.open(report_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def _parent_command(root: pathlib.Path, *args: str, interactive: bool = False,
                    timeout: int = 45) -> subprocess.CompletedProcess:
    env = clean_env(desktop_session=interactive)
    return subprocess.run(
        [str(root / "lab-vm"), "parent", *args],
        stdin=None if interactive else subprocess.DEVNULL,
        stdout=None if interactive else subprocess.PIPE,
        stderr=None if interactive else subprocess.PIPE,
        env=env, timeout=timeout, check=False,
    )


def _parent_json(root: pathlib.Path, *args: str, timeout: int = 45) -> tuple[subprocess.CompletedProcess, dict]:
    result = _parent_command(root, *args, timeout=timeout)
    if result.returncode:
        category = "refused" if result.stderr.startswith(b"REFUSED:") else "command_failure"
        raise GateError("FAIL", f"protected parent operation {args[0]} returned nonzero (exit={result.returncode}; reason={category})")
    try:
        value = json.loads(result.stdout)
    except (ValueError, UnicodeDecodeError) as error:
        raise GateError("FAIL", f"protected parent operation {args[0]} returned malformed evidence") from error
    if not isinstance(value, dict):
        raise GateError("FAIL", f"protected parent operation {args[0]} returned invalid evidence")
    return result, value


def _parent_ok(root: pathlib.Path, *args: str, timeout: int = 45,
               interactive: bool = False) -> subprocess.CompletedProcess:
    result = _parent_command(root, *args, interactive=interactive, timeout=timeout)
    if result.returncode:
        category = "refused" if result.stderr and result.stderr.startswith(b"REFUSED:") else "command_failure"
        raise GateError("FAIL", f"protected parent operation {args[0]} failed (exit={result.returncode}; reason={category})")
    return result


def _identity(status: dict) -> dict:
    disk = status.get("disk") if isinstance(status.get("disk"), dict) else {}
    return ({key: status.get(key) for key in (
                "status", "run_id", "parent_id", "supervisor_pid", "qemu_pid")}
            | {"disk_device": disk.get("device"), "disk_inode": disk.get("inode"),
               "disk_path": disk.get("path"),
               "disk_format": disk.get("format"), "disk_provisioned": disk.get("provisioned"),
               "virtual_capacity_gib": disk.get("virtual_capacity_gib"),
               "disk_file_bytes": disk.get("file_bytes"),
               "disk_host_allocated_bytes": disk.get("host_allocated_bytes")})


def _verified_resume_parent(status: dict) -> dict:
    """Require the protected state projection to identify one persistent 64-GiB qcow2."""
    disk = status.get("disk") if isinstance(status.get("disk"), dict) else {}
    identity = _identity(status)
    if (status.get("status") not in ("STOPPED", "RUNNING")
            or status.get("parent_id") != "default"
            or disk.get("path") != "disk.qcow2"
            or disk.get("format") != "qcow2" or disk.get("provisioned") is not True
            or disk.get("virtual_capacity_gib") != 64
            or type(disk.get("device")) is not int or disk["device"] < 0
            or type(disk.get("inode")) is not int or disk["inode"] <= 0
            or not isinstance(status.get("run_id"), str)
            or not re.fullmatch(r"[0-9a-f]{32}", status["run_id"])):
        raise GateError("BLOCKED", "parent lacks complete protected replacement identity; preserve it without lifecycle changes")
    if status["status"] == "RUNNING" and type(status.get("supervisor_pid")) is not int:
        raise GateError("BLOCKED", "running replacement lacks verified supervisor identity; preserve it")
    return identity


def _has_retained_disk(status: dict) -> bool:
    retired = status.get("retired_disk_identity")
    return (bool(status.get("retired_bundle")) and isinstance(retired, dict)
            and type(retired.get("device")) is int and retired["device"] >= 0
            and type(retired.get("inode")) is int and retired["inode"] > 0)


def _require_probe(value: dict, required: tuple[str, ...], label: str) -> None:
    failed = [name for name in required if value.get(name) is not True]
    if failed:
        raise GateError("FAIL", f"{label} checks failed: {', '.join(failed)}")


def _require_clean_stopped_previews(recovery: dict, reconciliation: dict) -> None:
    if (recovery.get("action") != "none" or recovery.get("status") != "STOPPED"
            or reconciliation.get("action") != "none"
            or reconciliation.get("status") != "STOPPED"):
        raise GateError("FAIL", "ordinary clean stop left a recovery/reconciliation action or ambiguous status")


def _owner_approval(prompt: str, expected: str) -> None:
    print(prompt)
    print(f"Type exactly: {expected}")
    try:
        answer = input("> ")
    except (EOFError, KeyboardInterrupt) as error:
        raise GateError("BLOCKED", "owner approval was cancelled") from error
    if answer != expected:
        raise GateError("BLOCKED", "owner approval did not match; no operation was started")


def _tui_key(root: pathlib.Path, key: str) -> None:
    _parent_ok(root, "tui-key", "--key", key, timeout=30)


def _tui_state(root: pathlib.Path) -> dict:
    _, state = _parent_json(root, "tui-state", timeout=30)
    if state.get("status") != "OK":
        raise GateError("FAIL", "protected tmux state is unavailable; no session-count inference is safe")
    return state


def _wait_tui(root: pathlib.Path, predicate, timeout: float = 8.0) -> dict:
    deadline = time.monotonic() + timeout
    last = {}
    while time.monotonic() < deadline:
        last = _tui_state(root)
        if predicate(last):
            return last
        time.sleep(0.15)
    raise GateError("FAIL", "protected tmux/TUI state did not reach the expected bounded state")


def _probe_history(root: pathlib.Path, token: str, model: str,
                   prior_token: str | None = None) -> dict:
    args = ["history-probe", "--token", token, "--model", model]
    if prior_token:
        args.extend(("--prior-token", prior_token))
    _, result = _parent_json(root, *args, timeout=45)
    return result


def _interactive_tui(root: pathlib.Path, *, continue_session: bool, title: str,
                     token: str, model: str) -> None:
    print(f"\n{title}")
    if not continue_session:
        print(f"In OpenCode, use /models and select exactly {model}.")
    print(f"Submit exactly: Reverse this string and return only the result: {token}")
    print("Wait for the model response, then detach with Ctrl-b followed by d (do not exit OpenCode).")
    args = ("tui", "--continue") if continue_session else ("tui",)
    result = _parent_command(root, *args, interactive=True, timeout=900)
    if result.returncode:
        raise GateError("FAIL", "protected interactive TUI session exited unsuccessfully")


def _exercise_tui_keys(root: pathlib.Path) -> None:
    state = _wait_tui(root, lambda x: x.get("target_count") == 1)
    if state.get("session_count") != 1:
        raise GateError("FAIL", "tmux did not retain exactly one protected OpenCode session")
    for cancel_key in ("escape", "n", "ctrl-c"):
        _tui_key(root, "ctrl-c")
        _wait_tui(root, lambda x: x.get("exit_dialog_visible") is True)
        _tui_key(root, cancel_key)
        state = _wait_tui(root, lambda x: x.get("exit_dialog_visible") is False)
        if state.get("target_count") != 1 or state.get("session_count") != 1:
            raise GateError("FAIL", "exit cancellation did not preserve the OpenCode session")
    _tui_key(root, "ctrl-d")
    state = _wait_tui(root, lambda x: x.get("target_count") == 1)
    if state.get("session_count") != 1:
        raise GateError("FAIL", "Ctrl-D unexpectedly closed the protected OpenCode session")
    _tui_key(root, "ctrl-c")
    _wait_tui(root, lambda x: x.get("exit_dialog_visible") is True)
    _tui_key(root, "q")
    state = _wait_tui(root, lambda x: x.get("session_count") == 0)
    if state.get("target_count") != 0:
        raise GateError("FAIL", "Q confirmation closed OpenCode but left its tmux session")


def _exercise_simultaneous_attach_and_resize(root: pathlib.Path) -> dict:
    clients: list[tuple[int, int, subprocess.Popen]] = []
    try:
        def attach(rows: int, columns: int) -> tuple[int, int, subprocess.Popen]:
            master_fd, slave_fd = pty.openpty()
            fcntl.ioctl(slave_fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, columns, 0, 0))
            process = subprocess.Popen(
                [str(root / "lab-vm"), "parent", "tui", "--continue"],
                stdin=slave_fd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                env=clean_env(), close_fds=True,
            )
            os.close(slave_fd)
            clients.append((master_fd, -1, process))
            return clients[-1]

        first = attach(37, 91)
        first_state = _wait_tui(root, lambda x: x.get("attached_clients") == 1, timeout=15)
        if first_state.get("session_count") != 1 or first_state.get("target_count") != 1:
            raise GateError("FAIL", "first TUI attach did not reach the unique protected session")
        second_client = attach(41, 103)
        simultaneous = _wait_tui(root, lambda x: x.get("attached_clients") == 2, timeout=15)
        if simultaneous.get("session_count") != 1 or simultaneous.get("target_count") != 1:
            raise GateError("FAIL", "two clients did not attach to the same unique tmux session")
        fcntl.ioctl(second_client[0], termios.TIOCSWINSZ, struct.pack("HHHH", 43, 107, 0, 0))
        second_client[2].send_signal(signal.SIGWINCH)
        resized = _wait_tui(root, lambda x: x.get("size") == "107x43", timeout=8)
        if resized.get("session_count") != 1:
            raise GateError("FAIL", "tmux resize changed protected session count")
        os.write(second_client[0], b"\x02d")
        second_client[2].wait(timeout=15)
        one_left = _wait_tui(root, lambda x: x.get("attached_clients") == 1, timeout=8)
        if one_left.get("session_count") != 1:
            raise GateError("FAIL", "detaching the second TUI client lost the shared session")
        os.write(first[0], b"\x02d")
        first[2].wait(timeout=15)
        detached = _wait_tui(root, lambda x: x.get("attached_clients") == 0, timeout=8)
        if detached.get("session_count") != 1:
            raise GateError("FAIL", "detaching both TUI clients lost the protected session")
        return {"session_count": detached["session_count"], "resize": resized["size"],
                "simultaneous_attach": simultaneous.get("attached_clients") == 2}
    except subprocess.TimeoutExpired as error:
        raise GateError("FAIL", "bounded simultaneous TUI attach did not detach") from error
    finally:
        for master_fd, _slave_fd, process in clients:
            if process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait(timeout=3)
            os.close(master_fd)


def run_parent_acceptance(root: pathlib.Path, model: str, data: dict,
                          report_dir: pathlib.Path, repo: pathlib.Path | None = None) -> None:
    """One-command, owner-confirmed fresh provisioning and real M1/M2 acceptance."""
    def active(name: str) -> None:
        data["gates"][name] = "NOT_RUN"
        data["evidence"].pop(name, None)
        data["active_gate"] = name
        _checkpoint(report_dir, data)

    def passed(name: str, evidence=None) -> None:
        data["gates"][name] = "PASS"
        if evidence is not None:
            data["evidence"][name] = evidence
        data.pop("active_gate", None)
        _checkpoint(report_dir, data)

    active("owner_interaction")
    if not re.fullmatch(r"openai/[A-Za-z0-9._-]{1,100}", model):
        raise GateError("BLOCKED", "owner acceptance requires one exact openai/<model-id>")
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        raise GateError("BLOCKED", "complete owner acceptance requires a controlling terminal")
    if os.environ.get("LM_VM_TERM_VALIDATED") != "1" or "TERM" not in clean_env():
        raise GateError("BLOCKED", "host TERM is not validated for the protected guest TUI")
    active("parent_identity")
    status_result = _parent_command(root, "status", "--json")
    try:
        initial = json.loads(status_result.stdout)
    except (ValueError, UnicodeDecodeError) as error:
        raise GateError("FAIL", f"protected parent status returned malformed evidence (exit={status_result.returncode})") from error
    if not isinstance(initial, dict):
        raise GateError("FAIL", f"protected parent status returned invalid evidence (exit={status_result.returncode})")
    initial_status = initial.get("status")
    factory_reset_done = False
    prior_factory_reset_attempt_id = None
    prior_provision_attempt_id = None
    if initial_status == "AMBIGUOUS":
        interrupted_origin = _replacement_provision_origin(data["candidate_sha"], repo)
        if interrupted_origin is not None:
            raise GateError(
                "BLOCKED",
                "replacement provisioning provenance exists but current parent identity is AMBIGUOUS; preserve the disk and do not factory-reset",
            )
        active("retirement")
        _parent_ok(root, "factory-reset", interactive=True, timeout=900)
        _, initial = _parent_json(root, "status", "--json")
        if initial.get("status") != "NOT_CREATED":
            raise GateError("FAIL", "authorized factory reset did not produce a fresh NOT_CREATED state")
        passed("retirement", {"status": "FACTORY_RESET", "old_parent_data_destroyed": True,
                               "scope": "fixed Little Mester persistent-parent state directory"})
        initial_status = "NOT_CREATED"
        factory_reset_done = True
        prior_factory_reset_attempt_id = data["attempt_id"]
        prior_provision_attempt_id = data["attempt_id"]
    elif status_result.returncode:
        raise GateError("FAIL", f"protected parent status returned nonzero (exit={status_result.returncode})")
    if initial_status in ("NOT_CREATED", "UNPROVISIONED") and not factory_reset_done:
        interrupted_origin = _replacement_provision_origin(data["candidate_sha"], repo)
        if interrupted_origin is not None:
            prior_factory_reset_attempt_id = interrupted_origin["factory_reset_attempt_id"]
            prior_provision_attempt_id = interrupted_origin["attempt_id"]
    retired_disk = initial.get("retired_disk_identity")
    disk = initial.get("disk") if isinstance(initial.get("disk"), dict) else {}
    same_disk_resume = False
    resume_origin = None
    is_replacement = (
        bool(initial.get("retired_bundle"))
        and initial_status in ("RUNNING", "STARTING", "STOPPED", "UNPROVISIONED")
        and (retired_disk is None
             or (retired_disk.get("device"), retired_disk.get("inode"))
                != (disk.get("device"), disk.get("inode"))
             or retired_disk.get("device") is None and initial_status == "UNPROVISIONED")
    )
    same_disk_resume = False
    resume_already_running = False
    resume_origin = None
    stopped_id = None
    if initial_status == "RUNNING":
        resume_origin = _replacement_provision_origin(data["candidate_sha"], repo)
        if resume_origin is not None:
            running_id = _verified_resume_parent(initial)
            recorded_disk = resume_origin.get("disk_identity")
            if recorded_disk is None or recorded_disk != {
                    "device": running_id["disk_device"], "inode": running_id["disk_inode"]}:
                raise GateError("BLOCKED", "RUNNING disk does not match the prior acceptance provenance; preserve it")
            stopped_id = running_id
            same_disk_resume = True
            resume_already_running = True
            prior_factory_reset_attempt_id = resume_origin["factory_reset_attempt_id"]
            passed("retirement", {
                "status": "NO_RETIREMENT_ALREADY_RUNNING_REPLACEMENT",
                "prior_attempt_id": resume_origin["attempt_id"],
                "factory_reset_attempt_id": prior_factory_reset_attempt_id,
                "old_parent_data_destroyed": False,
                "disk_identity": {"device": running_id["disk_device"],
                "inode": running_id["disk_inode"]},
            })
        elif is_replacement:
            raise GateError("BLOCKED", "RUNNING replacement lacks a complete private disk-provenance chain; preserve it without retirement")
    if initial_status == "STARTING":
        raise GateError("BLOCKED", "parent startup is still STARTING; no retire, reset, replacement, or second writer was attempted")
    if initial_status == "RETIRING":
        active("retirement")
        _parent_ok(root, "retire", interactive=True, timeout=900)
        _, initial = _parent_json(root, "status", "--json")
        if initial.get("status") != "RETIRED":
            raise GateError("FAIL", "resumable retirement did not reach its committed RETIRED state")
        passed("retirement", {"status": "RESUMED_RETIRED", "retired_bundle": initial.get("retired_bundle"),
                               "old_disk_retained": _has_retained_disk(initial)})
        initial_status = "RETIRED"
        is_replacement = False
    elif initial_status == "STOPPED":
        resume_origin = _replacement_provision_origin(data["candidate_sha"], repo)
        if resume_origin is None:
            raise GateError("BLOCKED", "STOPPED parent has no private reset-and-failed-start provenance for this candidate; it will not be retired or replaced")
        prior_factory_reset_attempt_id = resume_origin["factory_reset_attempt_id"]
        stopped_id = _verified_resume_parent(initial)
        recorded_disk = resume_origin.get("disk_identity")
        if recorded_disk is None or recorded_disk != {
                "device": stopped_id["disk_device"], "inode": stopped_id["disk_inode"]}:
            raise GateError("BLOCKED", "STOPPED disk does not match the prior failed-provision report; preserve it")
        same_disk_resume = True
        passed("retirement", {
            "status": "NO_RETIREMENT_SAME_DISK_RESUME",
            "prior_attempt_id": resume_origin["attempt_id"],
            "factory_reset_attempt_id": resume_origin["factory_reset_attempt_id"],
            "old_parent_data_destroyed": False,
            "disk_identity": {"device": stopped_id["disk_device"],
                              "inode": stopped_id["disk_inode"]},
        })
    elif (initial_status not in ("RETIRED", "NOT_CREATED")
          and not is_replacement and not same_disk_resume):
        active("retirement")
        _parent_ok(root, "retire", interactive=True, timeout=900)
        _, initial = _parent_json(root, "status", "--json")
        if initial.get("status") != "RETIRED":
