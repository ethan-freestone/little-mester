        "replacement_disk_identity": {"device": new_identity["disk_device"], "inode": new_identity["disk_inode"]},
        "final_run_id": _identity(final)["run_id"],
        "real_auth_and_model_responses": True,
        "owner_terminal_clipboard_observation": "reported_unchanged",
        "conversation_content_recorded": False,
    }


def print_report(data: dict) -> None:
    print(f"Candidate: {data['candidate_sha']}")
    print(f"Report: {data['evidence']['report']}")
    for name, status in data["gates"].items():
        print(f"{name}: {status}")
    print(f"OVERALL: {data['status']}")
    if data["mode"] == "parent_accept":
        print("M2_OWNER_ACCEPTANCE_PASS" if data["status"] == "PASS"
              and all(value == "PASS" for value in data["gates"].values())
              else "M2_OWNER_ACCEPTANCE_FAIL")


def run_smoke(root: pathlib.Path, workspace: str, model: str, state_before: set[str], data: dict,
              debug: bool = False) -> None:
    resolved = verify_workspace_mount(workspace, exact_tmpfs=False)
    if list(resolved.iterdir()):
        raise GateError("BLOCKED", "selected smoke workspace must be empty before launch")
    command = [str(root / "lab-vm"), "smoke", "--workspace", str(resolved), "--model", model]
    if debug:
        command.insert(2, "--debug")
    result = subprocess.run(
        command,
        stdin=None,
        stdout=None,
        stderr=None,
        env=clean_env(desktop_session=True),
        check=False,
    )
    created = list_runs(state_root()) - state_before
    if len(created) == 1:
        run_id = next(iter(created))
        data["evidence"]["vm_run_id"] = run_id
    elif created:
        data["notes"].append("ambiguous new VM run directories; none were modified")
    data["gates"]["run"] = "PASS" if result.returncode == 0 else "BLOCKED"
    data["evidence"]["smoke_exit_code"] = result.returncode
    if result.returncode:
        raise GateError("BLOCKED", "protected smoke returned nonzero; inspect its retained private run logs")
    if len(created) != 1:
        raise GateError("BLOCKED", "smoke succeeded but a unique new VM run directory was not observed")
    try:
        cleanup = inspect_cleanup(data["candidate_sha"], next(iter(created)), root)
    except GateError as error:
        data["gates"]["cleanup"] = error.status
        raise
    data["gates"]["cleanup"] = cleanup["status"]
    data["evidence"]["cleanup"] = cleanup


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description=__doc__)
    modes = p.add_mutually_exclusive_group()
    for name in ("preflight", "install", "storage-proof", "run", "verify-cleanup", "all", "parent-accept"):
        modes.add_argument(f"--{name}", action="store_true", dest=name.replace("-", "_"))
    p.add_argument("--milestone", choices=("M2",), help="owner acceptance milestone")
    p.add_argument("--sha", required=True, type=full_sha, help="full lowercase 40-character candidate commit SHA")
    p.add_argument("--prefix", type=install_prefix,
                   help="protected root-owned install prefix (default: /opt/little-mester)")
    p.add_argument("--repo", help="repository containing the exact candidate commit")
    p.add_argument("--workspace", help="existing owner-provisioned bounded filesystem root")
    p.add_argument("--model", help="exact OpenAI model identifier (required for --parent-accept)")
    p.add_argument("--run-id", help="exact fresh VM run id for read-only cleanup verification")
    p.add_argument("--debug", action="store_true", help="stream bounded, sanitized guest provisioning progress during --run/--all")
    return p


def full_sha(value: str) -> str:
    if not SHA_RE.fullmatch(value):
        raise argparse.ArgumentTypeError("expected a full lowercase 40-character commit SHA")
    return value


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    modes = [name for name in (
        "preflight", "install", "storage_proof", "run", "verify_cleanup", "all", "parent_accept",
    ) if getattr(args, name)]
    mode = modes[0] if modes else "preflight"
    if (mode == "parent_accept") != (args.milestone == "M2"):
        parser().error("--parent-accept requires --milestone M2, and --milestone is only valid with --parent-accept")
    if mode == "parent_accept" and not args.repo:
        parser().error("--parent-accept requires --repo PATH")
    if mode == "parent_accept" and not args.model:
        parser().error("--parent-accept requires --model openai/<model-id>")
    if args.debug and mode not in ("run", "all"):
        parser().error("--debug is supported only with --run or --all")
    try:
        repo = pathlib.Path(args.repo or ROOT).resolve(strict=True)
        report_dir = new_report_dir()
        data = report_template(args.sha, mode, report_dir)
        save_report(report_dir, data)
    except KeyboardInterrupt:
        print("BLOCKED: interrupted during runner initialization; no report directory was trusted", file=sys.stderr)
        if mode == "parent_accept":
            print("M2_OWNER_ACCEPTANCE_FAIL")
        return 3
    except GateError as error:
        print(f"{error.status}: {error.message}", file=sys.stderr)
        if mode == "parent_accept":
            print("M2_OWNER_ACCEPTANCE_FAIL")
        return 3 if error.status == "BLOCKED" else 1
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        print(f"FAIL: runner initialization failed ({type(error).__name__}); details omitted", file=sys.stderr)
        if mode == "parent_accept":
            print("M2_OWNER_ACCEPTANCE_FAIL")
        return 1

    result_code = 0
    current_gate = "candidate"
    try:
        candidate_commit(repo, args.sha)
        data["gates"]["candidate"] = "PASS"
        if mode == "verify_cleanup":
            current_gate = "cleanup"
            if not args.run_id:
                raise GateError("BLOCKED", "--verify-cleanup requires --run-id")
            verify_cleanup_report(args.sha, args.run_id)
            root = verify_install(repo, args.sha, args.prefix)
            cleanup = inspect_cleanup(args.sha, args.run_id, root)
            data["gates"]["cleanup"] = cleanup["status"]
            data["evidence"]["cleanup"] = cleanup
            data["status"] = "PASS"
        elif mode == "preflight":
            current_gate = "preflight"
            root = install_path(args.sha, args.prefix)
            if root.exists():
                root = verify_install(repo, args.sha, args.prefix)
                installed_preflight(root, args.workspace)
                data["gates"]["preflight"] = "PASS"
                data["status"] = "PASS"
            else:
                data["gates"]["preflight"] = "BLOCKED"
                data["notes"].append("protected install absent; read-only preflight did not install or execute the mutable candidate")
                raise GateError("BLOCKED", "candidate is verified in Git but not yet installed")
        elif mode == "parent_accept":
            current_gate = "preflight"
            root = verify_install(repo, args.sha, args.prefix)
            data["gates"]["install"] = "PASS"
            installed_preflight(root, None)
            data["gates"]["preflight"] = "PASS"
            current_gate = "parent_acceptance"
            run_parent_acceptance(root, args.model, data, report_dir, repo)
        elif mode in ("install", "all"):
            current_gate = "install"
            root = install_candidate(repo, args.sha, args.prefix)
            data["gates"]["install"] = "PASS"
            current_gate = "preflight"
            installed_preflight(root, args.workspace)
            data["gates"]["preflight"] = "PASS"
            if mode == "install":
                data["status"] = "PASS"
            else:
                current_gate = "storage_proof"
                if not args.workspace or not args.model:
                    raise GateError("BLOCKED", "--all requires --workspace and --model")
                verify_workspace_mount(args.workspace, exact_tmpfs=True)
                storage_proof(args.workspace)
                data["gates"]["storage_proof"] = "PASS"
                before = list_runs(state_root())
                current_gate = "run"
                run_smoke(root, args.workspace, args.model, before, data, debug=args.debug)
                data["status"] = "PASS"
        elif mode == "storage_proof":
            current_gate = "preflight"
            root = verify_install(repo, args.sha, args.prefix)
            if not args.workspace:
                raise GateError("BLOCKED", "--storage-proof requires --workspace")
            installed_preflight(root, args.workspace)
            data["gates"]["preflight"] = "PASS"
            current_gate = "storage_proof"
            storage_proof(args.workspace)
            data["gates"]["storage_proof"] = "PASS"
            data["status"] = "PASS"
        elif mode == "run":
            current_gate = "preflight"
            root = verify_install(repo, args.sha, args.prefix)
            if not args.workspace or not args.model:
                raise GateError("BLOCKED", "--run requires --workspace and --model")
            installed_preflight(root, args.workspace)
            data["gates"]["preflight"] = "PASS"
            before = list_runs(state_root())
            current_gate = "run"
            run_smoke(root, args.workspace, args.model, before, data, debug=args.debug)
            data["status"] = "PASS"
        else:
            raise GateError("FAIL", "unsupported operation")
    except KeyboardInterrupt:
        data["status"] = "BLOCKED"
        active = data.get("active_gate")
        if active in data["gates"] and data["gates"][active] == "NOT_RUN":
            data["gates"][active] = "BLOCKED"
        if data["gates"].get(current_gate) == "NOT_RUN":
            data["gates"][current_gate] = "BLOCKED"
        data["notes"].append("interrupted; no automatic cleanup or historical deletion was attempted")
        result_code = 3
    except GateError as error:
        data["status"] = error.status
        active = data.get("active_gate")
        if active in data["gates"] and data["gates"][active] == "NOT_RUN":
            data["gates"][active] = error.status
        if data["gates"].get(current_gate) == "NOT_RUN":
            data["gates"][current_gate] = error.status
        data["notes"].append(error.message)
        result_code = 3 if error.status == "BLOCKED" else 1
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        data["status"] = "FAIL"
        active = data.get("active_gate")
        if active in data["gates"] and data["gates"][active] == "NOT_RUN":
            data["gates"][active] = "FAIL"
        if data["gates"].get(current_gate) == "NOT_RUN":
            data["gates"][current_gate] = "FAIL"
        data["notes"].append(f"operation failed ({type(error).__name__}); details omitted")
        result_code = 1
    try:
        save_report_update = report_dir / "report.json"
        payload = (json.dumps(data, sort_keys=True, indent=2) + "\n").encode()
        fd = os.open(save_report_update, os.O_WRONLY | os.O_TRUNC | os.O_NOFOLLOW)
        with os.fdopen(fd, "wb") as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
    except OSError:
        print(f"FAIL: report update failed; preserve evidence directory {report_dir}", file=sys.stderr)
        data["status"] = "FAIL"
        result_code = 1
    print_report(data)
    return result_code


if __name__ == "__main__":
    raise SystemExit(main())
