  "description": "Markdown-first ticketing engine with SQLite indexer and MCP server",
  "main": "dist/src/engine.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "server": "ts-node src/mcp-server.ts",
