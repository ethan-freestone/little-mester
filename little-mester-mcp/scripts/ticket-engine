#!/usr/bin/env sh
# ticket-engine — Little Mester Ticket Engine CLI
# Wires create/list/update/archive/audit/validate to src/engine.ts via ts-node.
#
# Usage (from anywhere):
#   ./little-mester-mcp/scripts/ticket-engine create --area <area> --type <type> "Title" [--objective "..."]
#   ./little-mester-mcp/scripts/ticket-engine list [--area <area>] [--status <status>]
#   ./little-mester-mcp/scripts/ticket-engine update <number> [--status <status>] [--title <title>] ...
#   ./little-mester-mcp/scripts/ticket-engine archive <number>
#   ./little-mester-mcp/scripts/ticket-engine audit [--limit N] [--json] [--baseline]
#   ./little-mester-mcp/scripts/ticket-engine validate
#
# Options:
#   --ticket-dir <dir>   Directory containing ticket JSON files
#   -h, --help           Show this help
#
# By default this wrapper targets the repo's own docs/tickets, regardless of
# the current working directory. Set TICKET_DIR (or pass --ticket-dir) to
# override. Without this, running the script from little-mester-mcp/ would
# write to little-mester-mcp/docs/tickets/ by mistake.
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MODULE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
WORKSPACE_ROOT="$(cd "$MODULE_ROOT/.." && pwd)"

if [ -z "${TICKET_DIR:-}" ]; then
    TICKET_DIR="$WORKSPACE_ROOT/docs/tickets"
    export TICKET_DIR
fi

TS_NODE="$MODULE_ROOT/node_modules/.bin/ts-node"
if [ ! -x "$TS_NODE" ]; then
    echo "ticket-engine: ts-node not found. Run 'npm install' in $MODULE_ROOT" >&2
    exit 1
fi

exec "$TS_NODE" "$MODULE_ROOT/src/cli.ts" "$@"
