{
  "name": "@little-mester/ticket-engine-mcp",
  "version": "0.1.0",
  "description": "JSON-first ticketing engine with MCP server",
  "main": "dist/engine.js",
  "types": "dist/engine.d.ts",
  "bin": {
    "ticket-engine": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "check:package": "node scripts/check-package.js",
    "dev": "ts-node src/cli.ts",
    "server": "ts-node src/mcp-server.ts",
    "test": "jest --verbose --detectOpenHandles --forceExit",
    "test:watch": "jest --watch --verbose --detectOpenHandles",
    "test:coverage": "jest --verbose --coverage --detectOpenHandles --forceExit"
  },
  "keywords": [
    "tickets",
    "mcp"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
