#!/usr/bin/bash -p
# Enter one clean, privileged-mode Bash before processing arguments or loading
# repository code. -p ignores BASH_ENV and imported functions in the first shell.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

exec /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/nonexistent LANG=C LC_ALL=C \
  /usr/bin/bash -p -s -- "${BASH_SOURCE[0]}" "$@" <<'WORKER'
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
script_path=$1
shift

root="$(/usr/bin/python3 -I - "$script_path" <<'PY'
import os, pathlib, stat, sys

def refuse(message):
    print(f"REFUSED: {message}", file=sys.stderr)
    raise SystemExit(1)

raw = pathlib.Path(sys.argv[1])
if not raw.is_absolute():
    raw = pathlib.Path(os.getcwd()) / raw
if ".." in raw.parts:
    refuse("host installation path must not contain parent traversal")
entry = pathlib.Path(os.path.normpath(raw))
root = entry.parent
dependencies = [
    entry,
    root / "lib/vm/host-launcher.sh",
    root / "lib/vm/cloud-init.sh",
    root / "lib/vm/proxy.py",
    root / "lib/vm/bounded-log.py",
]

# Inspect the original lexical path before resolving anything. A symlink in
# any installation component is refused even if its current target is trusted.
facts = {}
for path in dependencies:
    current = pathlib.Path(path.anchor)
    for component in path.parts[1:]:
        current = current / component
        try:
            info = os.lstat(current)
        except OSError:
            refuse("incomplete protected host installation")
        if stat.S_ISLNK(info.st_mode):
            refuse("protected host installation contains a symlinked path component")
        facts[current] = info

for path in dependencies:
    for current in (path, *path.parents):
        info = facts.get(current)
        if info is None:
            info = os.lstat(current)
        if info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            refuse("host installation and every ancestor must be root-owned and not group/world writable")
        if current == path:
            if not stat.S_ISREG(info.st_mode):
                refuse("protected host installation contains a non-regular dependency")
        elif not stat.S_ISDIR(info.st_mode):
            refuse("protected host installation path contains a non-directory component")

# These fixed bootstrap executables are reached before normal dependency
# validation. Verify their lexical and resolved paths are system protected.
for raw_tool in ("/usr/bin/env", "/usr/bin/bash", "/usr/bin/python3", "/usr/bin/timeout"):
    lexical = pathlib.Path(raw_tool)
    try:
        resolved = lexical.resolve(strict=True)
        executable_info = os.stat(resolved, follow_symlinks=False)
        if not stat.S_ISREG(executable_info.st_mode) or not os.access(resolved, os.X_OK):
            refuse("required protected bootstrap executable is not executable")
        for path in (lexical, *lexical.parents, resolved, *resolved.parents):
            info = os.lstat(path)
            if info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
                refuse("bootstrap executable and every ancestor must be root-owned and not group/world writable")
    except OSError:
        refuse("required protected bootstrap executable is unavailable")

print(root)
PY
)"

export VM_HOST_SCRIPT_ROOT="$root"
command="${1:-}"
[[ -n "$command" ]] || {
  printf 'Usage: lab-vm smoke --workspace PATH --credentials-file PATH\n' >&2
  exit 2
}
shift
case "$command" in
  smoke)
    exec /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/nonexistent LANG=C LC_ALL=C \
      /usr/bin/timeout --signal=TERM --kill-after=15 1200 \
      /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/nonexistent LANG=C LC_ALL=C \
      VM_HOST_SCRIPT_ROOT="$root" \
      /usr/bin/bash -p -c '
        set -euo pipefail
        VM_HOST_SCRIPT_ROOT=$1
        export VM_HOST_SCRIPT_ROOT
        shift
        source "$VM_HOST_SCRIPT_ROOT/lib/vm/host-launcher.sh"
        source "$VM_HOST_SCRIPT_ROOT/lib/vm/cloud-init.sh"
        vm_host_smoke "$@"
      ' _ "$root" "$@"
    ;;
  *) printf 'REFUSED: unsupported command: %s\n' "$command" >&2; exit 2 ;;
esac
WORKER
